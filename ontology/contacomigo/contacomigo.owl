  <!-- BNCC curriculum layer. Official skill descriptions are preserved as
       literals; mathematical mappings are local semantic analyses. -->
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#belongsToCurriculum">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#CurriculumSkill"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#Curriculum"/>
    <rdfs:label xml:lang="en">belongs to curriculum</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#belongsToGrade">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#CurriculumSkill"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#CurriculumLevel"/>
    <rdfs:label xml:lang="en">belongs to grade</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#belongsToCurriculumDomain">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#CurriculumSkill"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#CurriculumDomain"/>
    <rdfs:label xml:lang="en">belongs to curriculum domain</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#addressesCurriculumSkill">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#Activity"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#CurriculumSkill"/>
    <owl:inverseOf rdf:resource="https://contacomigo.org/ontology#isAddressedByActivity"/>
    <rdfs:label xml:lang="en">addresses curriculum skill</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#isAddressedByActivity">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#CurriculumSkill"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#LearningActivity"/>
    <rdfs:label xml:lang="en">is addressed by activity</rdfs:label>
  </owl:ObjectProperty>

  <owl:DatatypeProperty rdf:about="https://contacomigo.org/ontology#hasCurriculumCode">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#CurriculumSkill"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">has curriculum code</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://contacomigo.org/ontology#hasOfficialDescription">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#CurriculumSkill"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:label xml:lang="en">has official description</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://contacomigo.org/ontology#conceptMappingStatus">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#CurriculumSkill"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">concept mapping status</rdfs:label>
    <rdfs:comment xml:lang="en">Allowed values in this version: mapped, partial, and pending_review.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://contacomigo.org/ontology#currentActivityCoverageStatus">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#CurriculumSkill"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">current activity coverage status</rdfs:label>
    <rdfs:comment xml:lang="en">Snapshot classification: COVERED, PARTIALLY_COVERED, NOT_COVERED, or NEEDS_REVIEW.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://contacomigo.org/ontology#currentActivityCount">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#CurriculumSkill"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
    <rdfs:label xml:lang="en">current activity count</rdfs:label>
    <rdfs:comment xml:lang="en">Number of seed activities currently claiming the skill code; this is coverage metadata, not evidence of pedagogical alignment.</rdfs:comment>
  </owl:DatatypeProperty>

  <owl:NamedIndividual rdf:about="https://contacomigo.org/ontology#BrazilianNationalCommonCoreCurriculum">
    <rdf:type rdf:resource="https://contacomigo.org/ontology#Curriculum"/>
    <rdfs:label xml:lang="pt-BR">Base Nacional Comum Curricular</rdfs:label>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://contacomigo.org/ontology#BNCCElementaryYear1">
    <rdf:type rdf:resource="https://contacomigo.org/ontology#CurriculumLevel"/>
    <rdfs:label xml:lang="pt-BR">1º ano do Ensino Fundamental</rdfs:label>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://contacomigo.org/ontology#BNCCNumbersDomain">
    <rdf:type rdf:resource="https://contacomigo.org/ontology#CurriculumDomain"/>
    <rdfs:label xml:lang="pt-BR">Números</rdfs:label>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://contacomigo.org/ontology#BNCCGeometryDomain">
    <rdf:type rdf:resource="https://contacomigo.org/ontology#CurriculumDomain"/>
    <rdfs:label xml:lang="pt-BR">Geometria</rdfs:label>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://contacomigo.org/ontology#BNCC_EF01MA01">
    <rdf:type rdf:resource="https://contacomigo.org/ontology#BNCCSkill"/>
    <rdfs:label xml:lang="pt-BR">EF01MA01</rdfs:label>
    <cc:hasCurriculumCode>EF01MA01</cc:hasCurriculumCode>
    <cc:hasOfficialDescription xml:lang="pt-BR">Utilizar números naturais como indicador de quantidade ou de ordem em diferentes situações cotidianas e reconhecer situações em que os números não indicam contagem nem ordem, mas sim código de identificação.</cc:hasOfficialDescription>
    <cc:belongsToCurriculum rdf:resource="https://contacomigo.org/ontology#BrazilianNationalCommonCoreCurriculum"/>
    <cc:belongsToGrade rdf:resource="https://contacomigo.org/ontology#BNCCElementaryYear1"/>
    <cc:belongsToCurriculumDomain rdf:resource="https://contacomigo.org/ontology#BNCCNumbersDomain"/>
    <cc:addressesMathematicalConcept rdf:resource="https://contacomigo.org/ontology#NumberConcept"/>
    <cc:conceptMappingStatus>mapped</cc:conceptMappingStatus>
    <cc:currentActivityCoverageStatus>PARTIALLY_COVERED</cc:currentActivityCoverageStatus>
    <cc:currentActivityCount rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">3</cc:currentActivityCount>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://contacomigo.org/ontology#BNCC_EF01MA03">
    <rdf:type rdf:resource="https://contacomigo.org/ontology#BNCCSkill"/>
    <rdfs:label xml:lang="pt-BR">EF01MA03</rdfs:label>
    <cc:hasCurriculumCode>EF01MA03</cc:hasCurriculumCode>
    <cc:hasOfficialDescription xml:lang="pt-BR">Estimar e comparar quantidades de objetos de dois conjuntos (em torno de 20 elementos), por estimativa e/ou por correspondência (um a um, dois a dois) para indicar “tem mais”, “tem menos” ou “tem a mesma quantidade”.</cc:hasOfficialDescription>
    <cc:belongsToCurriculum rdf:resource="https://contacomigo.org/ontology#BrazilianNationalCommonCoreCurriculum"/>
    <cc:belongsToGrade rdf:resource="https://contacomigo.org/ontology#BNCCElementaryYear1"/>
    <cc:belongsToCurriculumDomain rdf:resource="https://contacomigo.org/ontology#BNCCNumbersDomain"/>
    <cc:addressesMathematicalConcept rdf:resource="https://contacomigo.org/ontology#CountingConcept"/>
