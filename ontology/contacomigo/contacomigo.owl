  <!-- 2º–5º ano concepts (v0.5.0). Local ContaComigo concepts grounded in the
       BNCC objects of knowledge; they do not claim OntoMathEdu equivalents. -->
  <owl:Class rdf:about="https://contacomigo.org/ontology#PlaceValueConcept">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#NumberConcept"/>
    <rdfs:label xml:lang="en">Place value concept</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Conceito de valor posicional (sistema de numeração decimal)</rdfs:label>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <rdfs:comment xml:lang="pt-BR">Conceito local fundamentado nas habilidades BNCC EF02MA01, EF03MA02, EF04MA02.</rdfs:comment>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#DecimalNumberConcept">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#NumberConcept"/>
    <rdfs:label xml:lang="en">Decimal number concept</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Conceito de número decimal</rdfs:label>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <rdfs:comment xml:lang="pt-BR">Conceito local fundamentado nas habilidades BNCC EF04MA10, EF05MA02.</rdfs:comment>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#MultiplicationConcept">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#MathematicalConcept"/>
    <rdfs:label xml:lang="en">Multiplication concept</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Conceito de multiplicação</rdfs:label>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <rdfs:comment xml:lang="pt-BR">Conceito local fundamentado nas habilidades BNCC EF02MA07, EF03MA07, EF04MA06.</rdfs:comment>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#DivisionConcept">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#MathematicalConcept"/>
    <rdfs:label xml:lang="en">Division concept</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Conceito de divisão</rdfs:label>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <rdfs:comment xml:lang="pt-BR">Conceito local fundamentado nas habilidades BNCC EF03MA08, EF04MA07.</rdfs:comment>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#FractionConcept">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#NumberConcept"/>
    <rdfs:label xml:lang="en">Fraction concept</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Conceito de fração</rdfs:label>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <rdfs:comment xml:lang="pt-BR">Conceito local fundamentado nas habilidades BNCC EF04MA09, EF05MA03, EF05MA04.</rdfs:comment>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#PercentageConcept">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#MathematicalConcept"/>
    <rdfs:label xml:lang="en">Percentage concept</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Conceito de porcentagem</rdfs:label>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <rdfs:comment xml:lang="pt-BR">Conceito local fundamentado nas habilidades BNCC EF05MA06.</rdfs:comment>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#EqualityConcept">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#MathematicalConcept"/>
    <rdfs:label xml:lang="en">Equality concept</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Conceito de igualdade e equivalência</rdfs:label>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <rdfs:comment xml:lang="pt-BR">Conceito local fundamentado nas habilidades BNCC EF03MA11, EF04MA14, EF05MA10.</rdfs:comment>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#ProportionalityConcept">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#MathematicalConcept"/>
    <rdfs:label xml:lang="en">Proportionality concept</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Conceito de proporcionalidade</rdfs:label>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <rdfs:comment xml:lang="pt-BR">Conceito local fundamentado nas habilidades BNCC EF05MA12, EF05MA13.</rdfs:comment>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#CombinatoricsConcept">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#MathematicalConcept"/>
    <rdfs:label xml:lang="en">Counting principle concept</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Conceito de princípio multiplicativo de contagem</rdfs:label>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <rdfs:comment xml:lang="pt-BR">Conceito local fundamentado nas habilidades BNCC EF04MA08, EF05MA09.</rdfs:comment>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#MeasurementConcept">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#MathematicalConcept"/>
    <rdfs:label xml:lang="en">Measurement concept</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Conceito de grandezas e medidas</rdfs:label>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <rdfs:comment xml:lang="pt-BR">Conceito local fundamentado nas habilidades BNCC EF03MA18, EF04MA20, EF05MA19.</rdfs:comment>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#TimeMeasurementConcept">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#MeasurementConcept"/>
    <rdfs:label xml:lang="en">Time measurement concept</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Conceito de medida de tempo</rdfs:label>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <rdfs:comment xml:lang="pt-BR">Conceito local fundamentado nas habilidades BNCC EF02MA18, EF03MA22, EF03MA23, EF04MA22.</rdfs:comment>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#MoneyConcept">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#MeasurementConcept"/>
    <rdfs:label xml:lang="en">Money concept</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Conceito de sistema monetário</rdfs:label>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <rdfs:comment xml:lang="pt-BR">Conceito local fundamentado nas habilidades BNCC EF03MA24, EF04MA25.</rdfs:comment>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#AreaPerimeterConcept">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#MeasurementConcept"/>
    <rdfs:label xml:lang="en">Area and perimeter concept</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Conceito de área e perímetro</rdfs:label>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <rdfs:comment xml:lang="pt-BR">Conceito local fundamentado nas habilidades BNCC EF04MA21, EF05MA20.</rdfs:comment>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#DataInterpretationConcept">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#MathematicalConcept"/>
    <rdfs:label xml:lang="en">Data interpretation concept</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Conceito de leitura e interpretação de dados</rdfs:label>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <rdfs:comment xml:lang="pt-BR">Conceito local fundamentado nas habilidades BNCC EF04MA27, EF05MA24.</rdfs:comment>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#SpatialFigureConcept">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#BasicGeometryConcept"/>
    <rdfs:label xml:lang="en">Spatial figure concept</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Conceito de figura geométrica espacial</rdfs:label>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <rdfs:comment xml:lang="pt-BR">Conceito local fundamentado nas habilidades BNCC EF02MA14, EF03MA13, EF04MA17.</rdfs:comment>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#PolygonConcept">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#BasicGeometryConcept"/>
    <rdfs:label xml:lang="en">Polygon concept</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Conceito de polígono (lados e vértices)</rdfs:label>
    <cc:conceptOrigin>aligned ontology concept</cc:conceptOrigin>
    <cc:sourceOntology rdf:resource="http://ontomathpro.org/ontomathedu#"/>
    <cc:sourceIRI rdf:resource="http://ontomathpro.org/ontomathedu#RDv25ipiTlBE1U108mKAvEj"/>
    <cc:alignmentRelation>related</cc:alignmentRelation>
    <cc:alignmentNote xml:lang="pt-BR">A classe fonte tem rótulo inglês "Polygon" (alinhamento adicionado na v0.6.0); o recorte dos anos iniciais é mais restrito e não se declara equivalência.</cc:alignmentNote>
    <rdfs:comment xml:lang="pt-BR">Conceito local fundamentado nas habilidades BNCC EF03MA15, EF05MA17.</rdfs:comment>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#SymmetryConcept">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#BasicGeometryConcept"/>
    <rdfs:label xml:lang="en">Reflection symmetry concept</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Conceito de simetria de reflexão</rdfs:label>
    <cc:conceptOrigin>aligned ontology concept</cc:conceptOrigin>
    <cc:sourceOntology rdf:resource="http://ontomathpro.org/ontomathedu#"/>
    <cc:sourceIRI rdf:resource="http://ontomathpro.org/ontomathedu#RBZTpicxNM7cbhnJJ1IRNyX"/>
    <cc:alignmentRelation>related</cc:alignmentRelation>
    <cc:alignmentNote xml:lang="pt-BR">A classe fonte tem rótulo inglês "Axial symmetry" (alinhamento adicionado na v0.6.0); o recorte dos anos iniciais é mais restrito e não se declara equivalência.</cc:alignmentNote>
    <rdfs:comment xml:lang="pt-BR">Conceito local fundamentado nas habilidades BNCC EF04MA19.</rdfs:comment>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#CoordinateLocationConcept">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#BasicGeometryConcept"/>
    <rdfs:label xml:lang="en">Coordinate location concept</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Conceito de localização por coordenadas</rdfs:label>
    <cc:conceptOrigin>aligned ontology concept</cc:conceptOrigin>
    <cc:sourceOntology rdf:resource="http://ontomathpro.org/ontomathedu#"/>
    <cc:sourceIRI rdf:resource="http://ontomathpro.org/ontomathedu#R7YD3X6bHdrVh0Vfk3nEWoM"/>
    <cc:alignmentRelation>related</cc:alignmentRelation>
    <cc:alignmentNote xml:lang="pt-BR">A classe fonte tem rótulo inglês "Cartesian coordinate system" (alinhamento adicionado na v0.6.0); o recorte dos anos iniciais é mais restrito e não se declara equivalência.</cc:alignmentNote>
    <rdfs:comment xml:lang="pt-BR">Conceito local fundamentado nas habilidades BNCC EF05MA15.</rdfs:comment>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:Class>

  <!-- v0.6.0 concepts for the BNCC skills that had no individual before. Local
       ContaComigo concepts; congruence and similarity are only "related" to
       confirmed OntoMathEdu classes (no equivalence is claimed). -->
  <owl:Class rdf:about="https://contacomigo.org/ontology#SpatialLocationConcept">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#BasicGeometryConcept"/>
    <rdfs:label xml:lang="en">Spatial location and movement concept</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Conceito de localização e movimentação no espaço</rdfs:label>
    <rdfs:comment xml:lang="pt-BR">Conceito local fundamentado nas habilidades BNCC EF01MA11, EF01MA12, EF02MA12, EF02MA13, EF03MA12, EF04MA16 e EF05MA14 (localização de pessoas e objetos segundo pontos de referência, trajetos, plantas e croquis).</rdfs:comment>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#ProbabilityConcept">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#MathematicalConcept"/>
    <rdfs:label xml:lang="en">Chance and probability concept</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Conceito de acaso e probabilidade</rdfs:label>
    <rdfs:comment xml:lang="pt-BR">Conceito local fundamentado nas habilidades BNCC EF01MA20, EF02MA21, EF03MA25, EF04MA26, EF05MA22 e EF05MA23 (classificação de eventos, resultados possíveis e probabilidade de eventos equiprováveis).</rdfs:comment>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#CongruenceConcept">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#BasicGeometryConcept"/>
    <rdfs:label xml:lang="en">Congruence concept</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Conceito de congruência de figuras planas</rdfs:label>
    <rdfs:comment xml:lang="pt-BR">Conceito local fundamentado na habilidade BNCC EF03MA16 (reconhecer figuras congruentes por sobreposição e em malhas).</rdfs:comment>
    <cc:conceptOrigin>aligned ontology concept</cc:conceptOrigin>
    <cc:sourceOntology rdf:resource="http://ontomathpro.org/ontomathedu#"/>
    <cc:sourceIRI rdf:resource="http://ontomathpro.org/ontomathedu#RLfTx5EJyjoizZm1ABPOwY"/>
    <cc:alignmentRelation>related</cc:alignmentRelation>
    <cc:alignmentNote xml:lang="pt-BR">A classe fonte tem rótulo inglês "Congruent geometric figures"; o recorte dos anos iniciais (sobreposição e malhas) é mais restrito, por isso a relação é apenas related.</cc:alignmentNote>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#SimilarityConcept">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#BasicGeometryConcept"/>
    <rdfs:label xml:lang="en">Enlargement and reduction (similarity) concept</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Conceito de ampliação e redução de figuras (semelhança)</rdfs:label>
    <rdfs:comment xml:lang="pt-BR">Conceito local fundamentado na habilidade BNCC EF05MA18 (congruência dos ângulos e proporcionalidade dos lados em ampliações e reduções em malhas quadriculadas).</rdfs:comment>
    <cc:conceptOrigin>aligned ontology concept</cc:conceptOrigin>
    <cc:sourceOntology rdf:resource="http://ontomathpro.org/ontomathedu#"/>
    <cc:sourceIRI rdf:resource="http://ontomathpro.org/ontomathedu#RvAZM1LoovPjUxYGZ0pWvs"/>
    <cc:alignmentRelation>related</cc:alignmentRelation>
    <cc:alignmentNote xml:lang="pt-BR">A classe fonte tem rótulo inglês "Similar figures"; a BNCC do 5º ano não usa o termo semelhança, apenas ampliação e redução, por isso a relação é apenas related.</cc:alignmentNote>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:Class>

  <!-- Curricular, learner, activity, and evidence bridge concepts. -->
  <owl:Class rdf:about="https://contacomigo.org/ontology#CurriculumSkill">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#CurricularKnowledge"/>
    <rdfs:label xml:lang="en">Curriculum skill</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Habilidade curricular</rdfs:label>
    <rdfs:comment xml:lang="en">A skill defined by a curriculum; it is not a mathematical concept or learner characteristic.</rdfs:comment>
    <cc:conceptOrigin>engineering concept</cc:conceptOrigin>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#BNCCSkill">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#CurriculumSkill"/>
    <rdfs:label xml:lang="pt-BR">Habilidade BNCC</rdfs:label>
    <rdfs:label xml:lang="en">BNCC skill</rdfs:label>
    <rdfs:comment xml:lang="en">A curriculum skill whose code and official description are sourced from the Brazilian National Common Core Curriculum.</rdfs:comment>
    <cc:conceptOrigin>aligned ontology concept</cc:conceptOrigin>
    <cc:sourceOntology rdf:resource="https://basenacionalcomum.mec.gov.br/"/>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#Curriculum">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#CurricularKnowledge"/>
    <rdfs:label xml:lang="en">Curriculum</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Currículo</rdfs:label>
    <cc:conceptOrigin>engineering concept</cc:conceptOrigin>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#CurriculumDomain">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#CurricularKnowledge"/>
    <rdfs:label xml:lang="en">Curriculum domain</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Unidade temática curricular</rdfs:label>
    <cc:conceptOrigin>engineering concept</cc:conceptOrigin>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#CurriculumLevel">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#CurricularKnowledge"/>
    <rdfs:label xml:lang="en">Curriculum level</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Etapa ou ano curricular</rdfs:label>
    <cc:conceptOrigin>aligned ontology concept</cc:conceptOrigin>
    <cc:sourceOntology rdf:resource="http://ontomathpro.org/ontomathedu#"/>
    <cc:sourceIRI rdf:resource="http://ontomathpro.org/ontomathedu#EducationalLevel"/>
    <cc:alignmentRelation>adapted</cc:alignmentRelation>
    <cc:alignmentNote xml:lang="pt-BR">Adaptado para permitir níveis curriculares brasileiros; não equivale aos níveis russos ou britânicos distribuídos.</cc:alignmentNote>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#LearnerSkillState">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#LearnerKnowledge"/>
    <rdfs:label xml:lang="en">Learner skill state</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Estado de domínio da habilidade pelo aprendiz</rdfs:label>
    <rdfs:comment xml:lang="en">Semantic reference to the current skill-mastery state whose calculation remains owned by Bayesian Knowledge Tracing.</rdfs:comment>
    <cc:conceptOrigin>engineering concept</cc:conceptOrigin>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#Activity">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#ActivityKnowledge"/>
    <rdfs:label xml:lang="en">Activity</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Atividade</rdfs:label>
    <cc:historicalSourceOntology rdf:resource="http://www.semanticweb.org/ricma/ontologies/2024/11/LASDONT.owl"/>
    <cc:historicalSourceConcept>Treatments_Class</cc:historicalSourceConcept>
    <cc:historicalMappingType>related to</cc:historicalMappingType>
    <rdfs:comment xml:lang="pt-BR">A LASDONT chamava as atividades de tratamentos; o ContaComigo trata atividade educacional como recurso pedagógico, e não como tratamento clínico (ver Batch 02).</rdfs:comment>
    <rdfs:comment xml:lang="en">Semantic root for concrete learning activities and reusable activity-family profiles.</rdfs:comment>
    <cc:conceptOrigin>engineering concept</cc:conceptOrigin>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#LearningActivity">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#Activity"/>
    <rdfs:label xml:lang="en">Learning activity</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Atividade de aprendizagem</rdfs:label>
    <cc:conceptOrigin>engineering concept</cc:conceptOrigin>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#ActivityFamilyProfile">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#Activity"/>
    <rdfs:label xml:lang="en">Activity family profile</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Perfil de família de atividades</rdfs:label>
    <rdfs:comment xml:lang="en">A partial developer-authored summary of a current implementation family; concrete activities require their own materialized metadata.</rdfs:comment>
    <cc:conceptOrigin>engineering concept</cc:conceptOrigin>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#LearningEventEvidence">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#LearningAnalyticsEvidence"/>
    <rdfs:label xml:lang="en">Learning-event evidence</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Evidência de evento de aprendizagem</rdfs:label>
    <rdfs:comment xml:lang="en">Semantic reference to immutable interaction records kept in the Learning Analytics persistence layer.</rdfs:comment>
    <cc:conceptOrigin>engineering concept</cc:conceptOrigin>
  </owl:Class>

  <!-- Queryable semantic relations for the competency questions. -->
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#hasDidacticRelation">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#MathematicalConcept"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#DidacticRelation"/>
    <rdfs:label xml:lang="en">has didactic relation</rdfs:label>
    <rdfs:label xml:lang="pt-BR">tem relação didática</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#prerequisiteConcept">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#PrerequisiteRelation"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#MathematicalConcept"/>
    <rdfs:label xml:lang="en">prerequisite concept</rdfs:label>
    <rdfs:label xml:lang="pt-BR">conceito pré-requisito</rdfs:label>
    <cc:sourceOntology rdf:resource="http://ontomathpro.org/ontomathedu#"/>
    <cc:sourceIRI rdf:resource="http://ontomathpro.org/ontomathedu#hasPrerequisite"/>
    <cc:alignmentRelation>adapted</cc:alignmentRelation>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#dependentConcept">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#PrerequisiteRelation"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#MathematicalConcept"/>
    <rdfs:label xml:lang="en">dependent concept</rdfs:label>
    <rdfs:label xml:lang="pt-BR">conceito dependente</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#addressesMathematicalConcept">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#CurriculumSkill"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#MathematicalConcept"/>
    <rdfs:label xml:lang="en">addresses mathematical concept</rdfs:label>
    <rdfs:label xml:lang="pt-BR">aborda conceito matemático</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#developsMathematicalConcept">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#Activity"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#MathematicalConcept"/>
    <rdfs:label xml:lang="en">develops mathematical concept</rdfs:label>
    <rdfs:label xml:lang="pt-BR">desenvolve conceito matemático</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#requiresPrerequisite">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#LearningActivity"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#MathematicalConcept"/>
    <rdfs:label xml:lang="en">requires prerequisite</rdfs:label>
    <rdfs:label xml:lang="pt-BR">requer pré-requisito</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#providesEvidenceFor">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#LearningAnalyticsEvidence"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#MathematicalConcept"/>
    <rdfs:label xml:lang="en">provides evidence for</rdfs:label>
    <rdfs:label xml:lang="pt-BR">fornece evidência para</rdfs:label>
  </owl:ObjectProperty>

  <!-- Neuroinclusive learner model. Characteristics are contextual entities,
       never essential or permanent types assigned directly to a learner. -->
  <owl:Class rdf:about="https://contacomigo.org/ontology#Learner">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#LearnerKnowledge"/>
    <rdfs:label xml:lang="en">Learner</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Aprendiz</rdfs:label>
    <rdfs:comment xml:lang="en">A learner participating in an educational experience; diagnosis does not entail any learner characteristic.</rdfs:comment>
    <cc:conceptOrigin>engineering concept</cc:conceptOrigin>
  </owl:Class>

  <owl:Class rdf:about="https://contacomigo.org/ontology#LearnerCharacteristic">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#LearnerKnowledge"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="en">Learner characteristic</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Característica do aprendiz</rdfs:label>
    <rdfs:comment xml:lang="en">A contextual, revisable learner-model entity; it is not an essential property or diagnosis.</rdfs:comment>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <dcterms:source rdf:resource="https://doi.org/10.1111/jcpp.13534"/>
  </owl:Class>

  <owl:Class rdf:about="https://contacomigo.org/ontology#ObservedLearnerCharacteristic">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#LearnerCharacteristic"/>
    <rdfs:label xml:lang="en">Observed learner characteristic</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Característica observada do aprendiz</rdfs:label>
    <rdfs:comment xml:lang="en">A time-bounded interpretation supported by contextual evidence from more than an unqualified single interaction or by an explicitly identified assessment source.</rdfs:comment>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <dcterms:source rdf:resource="https://doi.org/10.3102/00346543211020116"/>
  </owl:Class>

  <owl:Class rdf:about="https://contacomigo.org/ontology#ObservedStrength">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#ObservedLearnerCharacteristic"/>
    <rdfs:label xml:lang="en">Observed strength</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Força observada</rdfs:label>
    <rdfs:comment xml:lang="en">Context-specific favorable performance or interaction evidence, subject to an evidence window and revision.</rdfs:comment>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <dcterms:source rdf:resource="https://doi.org/10.1007/s41252-023-00348-z"/>
  </owl:Class>

  <owl:Class rdf:about="https://contacomigo.org/ontology#ObservedPreference">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#ObservedLearnerCharacteristic"/>
    <rdfs:label xml:lang="en">Observed preference</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Preferência observada</rdfs:label>
    <rdfs:comment xml:lang="en">A contextual interaction preference that does not imply superior learning outcomes or a fixed learning style.</rdfs:comment>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <dcterms:source rdf:resource="https://doi.org/10.1111/j.1539-6053.2009.01038.x"/>
  </owl:Class>

  <owl:Class rdf:about="https://contacomigo.org/ontology#SupportNeed">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#ObservedLearnerCharacteristic"/>
    <rdfs:label xml:lang="en">Support need</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Necessidade de suporte</rdfs:label>
    <rdfs:comment xml:lang="en">A contextual requirement for access or participation; it does not by itself assert inability or clinical impairment.</rdfs:comment>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <dcterms:source rdf:resource="https://udlguidelines.cast.org/"/>
  </owl:Class>

  <!-- Evidence entities and sufficiency are separate from characteristics. -->
  <owl:Class rdf:about="https://contacomigo.org/ontology#InteractionEvidence">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#LearningAnalyticsEvidence"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="en">Interaction evidence</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Evidência de interação</rdfs:label>
    <rdfs:comment xml:lang="en">A semantic evidence entity derived from interaction records or aggregations; it does not give a raw event an intrinsic psychological meaning.</rdfs:comment>
    <cc:conceptOrigin>aligned ontology concept</cc:conceptOrigin>
    <cc:sourceOntology rdf:resource="http://www.w3.org/ns/prov#"/>
    <cc:sourceIRI rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <cc:alignmentRelation>narrower</cc:alignmentRelation>
  </owl:Class>

  <owl:Class rdf:about="https://contacomigo.org/ontology#LearningEvidence">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#InteractionEvidence"/>
    <rdfs:label xml:lang="en">Learning evidence</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Evidência de aprendizagem</rdfs:label>
    <rdfs:comment xml:lang="en">Evidence about mathematical learning or performance, distinct from interaction-format fit.</rdfs:comment>
    <cc:conceptOrigin>engineering concept</cc:conceptOrigin>
  </owl:Class>

  <owl:Class rdf:about="https://contacomigo.org/ontology#EvidenceWindow">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#LearnerKnowledge"/>
    <rdfs:label xml:lang="en">Evidence window</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Janela de evidência</rdfs:label>
    <rdfs:comment xml:lang="en">A bounded contextual interval over which evidence is selected and interpreted.</rdfs:comment>
    <cc:conceptOrigin>engineering concept</cc:conceptOrigin>
  </owl:Class>

  <owl:Class rdf:about="https://contacomigo.org/ontology#Observation">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#LearningAnalyticsEvidence"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="en">Observation</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Observação</rdfs:label>
    <rdfs:comment xml:lang="en">A contextual observation produced from one or more persisted records or an explicitly identified human assessment.</rdfs:comment>
    <cc:conceptOrigin>aligned ontology concept</cc:conceptOrigin>
    <cc:sourceOntology rdf:resource="http://www.w3.org/ns/prov#"/>
    <cc:sourceIRI rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <cc:alignmentRelation>narrower</cc:alignmentRelation>
  </owl:Class>

  <owl:Class rdf:about="https://contacomigo.org/ontology#EvidenceSufficiencyAssessment">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#LearnerKnowledge"/>
    <rdfs:label xml:lang="en">Evidence sufficiency assessment</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Avaliação de suficiência de evidência</rdfs:label>
    <rdfs:comment xml:lang="en">A revisable result of applying a documented reasoning policy to an evidence set.</rdfs:comment>
    <cc:conceptOrigin>experimental construct</cc:conceptOrigin>
  </owl:Class>

  <owl:Class rdf:about="https://contacomigo.org/ontology#InsufficientEvidence">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#EvidenceSufficiencyAssessment"/>
    <rdfs:label xml:lang="en">Insufficient evidence</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Evidência insuficiente</rdfs:label>
    <rdfs:comment xml:lang="en">Evidence is unavailable, stale, too sparse, untested for the context, or conflicting. This is not evidence of weakness or a support need.</rdfs:comment>
    <cc:conceptOrigin>experimental construct</cc:conceptOrigin>
  </owl:Class>

  <owl:Class rdf:about="https://contacomigo.org/ontology#LearningSession">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#ActivityKnowledge"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <rdfs:label xml:lang="en">Learning session</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Sessão de aprendizagem</rdfs:label>
    <cc:conceptOrigin>aligned ontology concept</cc:conceptOrigin>
    <cc:sourceOntology rdf:resource="http://www.w3.org/ns/prov#"/>
    <cc:sourceIRI rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <cc:alignmentRelation>narrower</cc:alignmentRelation>
  </owl:Class>

  <owl:Class rdf:about="https://contacomigo.org/ontology#ActivityCharacteristic">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#ActivityKnowledge"/>
    <rdfs:label xml:lang="en">Activity characteristic</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Característica da atividade</rdfs:label>
    <rdfs:comment xml:lang="en">A characteristic of an educational activity, kept outside the learner-characteristic hierarchy.</rdfs:comment>
    <cc:conceptOrigin>engineering concept</cc:conceptOrigin>
  </owl:Class>

  <owl:Class rdf:about="https://contacomigo.org/ontology#ActivityType">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#ActivityCharacteristic"/>
    <rdfs:label xml:lang="en">Activity type</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Tipo de atividade</rdfs:label>
    <cc:conceptOrigin>engineering concept</cc:conceptOrigin>
  </owl:Class>

  <owl:Class rdf:about="https://contacomigo.org/ontology#Modality">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#ActivityCharacteristic"/>
    <rdfs:label xml:lang="en">Modality</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Modalidade</rdfs:label>
    <rdfs:comment xml:lang="en">A presentation or interaction modality; it is not a learner type.</rdfs:comment>
    <cc:conceptOrigin>engineering concept</cc:conceptOrigin>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#Representation">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#ActivityCharacteristic"/>
    <rdfs:label xml:lang="en">Representation</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Representação</rdfs:label>
    <rdfs:comment xml:lang="en">A form in which activity content is presented, kept separate from learner preference.</rdfs:comment>
    <cc:conceptOrigin>engineering concept</cc:conceptOrigin>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#InteractionType">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#ActivityCharacteristic"/>
    <rdfs:label xml:lang="en">Interaction type</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Tipo de interação</rdfs:label>
    <rdfs:comment xml:lang="en">The input or manipulation pattern exposed by an activity.</rdfs:comment>
    <cc:conceptOrigin>engineering concept</cc:conceptOrigin>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#DifficultyProfile">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#ActivityCharacteristic"/>
    <rdfs:label xml:lang="en">Difficulty profile</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Perfil de dificuldade</rdfs:label>
    <rdfs:comment xml:lang="en">A multidimensional developer or expert annotation. It does not replace legacy easy/medium/hard labels and is not learned or clinically validated.</rdfs:comment>
    <cc:conceptOrigin>experimental construct</cc:conceptOrigin>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#ActivityAffordance">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#ActivityCharacteristic"/>
    <rdfs:label xml:lang="en">Activity affordance</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Recurso de interação da atividade</rdfs:label>
    <rdfs:comment xml:lang="en">An interaction or accessibility capability made available by an activity implementation.</rdfs:comment>
    <cc:conceptOrigin>engineering concept</cc:conceptOrigin>
  </owl:Class>

  <!-- Context-specific reinterpretations of the five historical dimensions. -->
  <owl:Class rdf:about="https://contacomigo.org/ontology#VisualInteractionEvidence">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#InteractionEvidence"/>
    <rdfs:label xml:lang="en">Visual interaction evidence</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Evidência de interação visual</rdfs:label>
    <rdfs:comment xml:lang="en">Evidence concerning interaction or performance with visual or pictorial representation.</rdfs:comment>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <dcterms:source rdf:resource="https://udlguidelines.cast.org/"/>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#ObservedVisualStrength">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#ObservedStrength"/>
    <rdfs:label xml:lang="en">Observed visual strength</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Força visual observada</rdfs:label>
    <rdfs:comment xml:lang="en">Comparatively favorable contextual outcomes under visual representation within an identified evidence window.</rdfs:comment>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <cc:historicalSourceOntology rdf:resource="http://www.semanticweb.org/ricma/ontologies/2024/11/LASDONT.owl"/>
    <cc:historicalSourceConcept>Visual_Strength</cc:historicalSourceConcept>
    <cc:historicalMappingType>adapted from</cc:historicalMappingType>
    <dcterms:source rdf:resource="https://doi.org/10.1007/s41252-023-00348-z"/>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#ObservedVisualPreference">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#ObservedPreference"/>
    <rdfs:label xml:lang="en">Observed visual preference</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Preferência visual observada</rdfs:label>
    <rdfs:comment xml:lang="en">A contextual preference for visual interaction; it makes no claim about improved learning.</rdfs:comment>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <cc:historicalSourceOntology rdf:resource="http://www.semanticweb.org/ricma/ontologies/2024/11/LASDONT.owl"/>
    <cc:historicalSourceConcept>Visual_Strength</cc:historicalSourceConcept>
    <cc:historicalMappingType>related to</cc:historicalMappingType>
    <dcterms:source rdf:resource="https://doi.org/10.1111/j.1539-6053.2009.01038.x"/>
  </owl:Class>

  <owl:Class rdf:about="https://contacomigo.org/ontology#AuditoryInteractionEvidence">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#InteractionEvidence"/>
    <rdfs:label xml:lang="en">Auditory interaction evidence</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Evidência de interação auditiva</rdfs:label>
    <rdfs:comment xml:lang="en">Evidence concerning spoken or audio instruction and auditory presentation.</rdfs:comment>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <dcterms:source rdf:resource="https://udlguidelines.cast.org/"/>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#ObservedAuditoryStrength">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#ObservedStrength"/>
    <rdfs:label xml:lang="en">Observed auditory strength</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Força auditiva observada</rdfs:label>
    <rdfs:comment xml:lang="en">Comparatively favorable contextual outcomes with auditory presentation within an identified evidence window.</rdfs:comment>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <cc:historicalSourceOntology rdf:resource="http://www.semanticweb.org/ricma/ontologies/2024/11/LASDONT.owl"/>
    <cc:historicalSourceConcept>Auditive_Strength</cc:historicalSourceConcept>
    <cc:historicalMappingType>adapted from</cc:historicalMappingType>
    <dcterms:source rdf:resource="https://doi.org/10.1007/s41252-023-00348-z"/>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#ObservedAuditoryPreference">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#ObservedPreference"/>
    <rdfs:label xml:lang="en">Observed auditory preference</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Preferência auditiva observada</rdfs:label>
    <rdfs:comment xml:lang="en">A contextual preference for auditory interaction; it makes no claim about improved learning.</rdfs:comment>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <cc:historicalSourceOntology rdf:resource="http://www.semanticweb.org/ricma/ontologies/2024/11/LASDONT.owl"/>
    <cc:historicalSourceConcept>Auditive_Strength</cc:historicalSourceConcept>
    <cc:historicalMappingType>related to</cc:historicalMappingType>
    <dcterms:source rdf:resource="https://doi.org/10.1111/j.1539-6053.2009.01038.x"/>
  </owl:Class>

  <owl:Class rdf:about="https://contacomigo.org/ontology#MotorInteractionEvidence">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#InteractionEvidence"/>
    <rdfs:label xml:lang="en">Motor interaction evidence</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Evidência de interação motora</rdfs:label>
    <rdfs:comment xml:lang="en">Evidence about interaction demands such as dragging, pointing, or target activation, separate from mathematical performance.</rdfs:comment>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <dcterms:source rdf:resource="https://www.w3.org/TR/wcag/"/>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#MotorSupportNeed">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#SupportNeed"/>
    <rdfs:label xml:lang="en">Motor support need</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Necessidade de suporte motor</rdfs:label>
    <rdfs:comment xml:lang="en">A temporary or contextual need for an alternative interaction method; it does not assert mathematical difficulty.</rdfs:comment>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <cc:historicalSourceOntology rdf:resource="http://www.semanticweb.org/ricma/ontologies/2024/11/LASDONT.owl"/>
    <cc:historicalSourceConcept>Motor_Weakness</cc:historicalSourceConcept>
    <cc:historicalMappingType>adapted from</cc:historicalMappingType>
    <dcterms:source rdf:resource="https://www.w3.org/TR/wcag/"/>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#MotorInteractionPreference">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#ObservedPreference"/>
    <rdfs:label xml:lang="en">Motor interaction preference</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Preferência de interação motora</rdfs:label>
    <rdfs:comment xml:lang="en">A contextual preference among available input methods.</rdfs:comment>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <cc:historicalSourceOntology rdf:resource="http://www.semanticweb.org/ricma/ontologies/2024/11/LASDONT.owl"/>
    <cc:historicalSourceConcept>Motor_Strength</cc:historicalSourceConcept>
    <cc:historicalMappingType>related to</cc:historicalMappingType>
    <dcterms:source rdf:resource="https://udlguidelines.cast.org/"/>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#InteractionCompatibilityAssessment">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#LearnerKnowledge"/>
    <rdfs:label xml:lang="en">Interaction compatibility assessment</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Avaliação de compatibilidade de interação</rdfs:label>
    <rdfs:comment xml:lang="en">A contextual assessment of fit between interaction requirements and observed learner support information.</rdfs:comment>
    <cc:conceptOrigin>experimental construct</cc:conceptOrigin>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#MotorDemandCompatibility">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#InteractionCompatibilityAssessment"/>
    <rdfs:label xml:lang="en">Motor demand compatibility</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Compatibilidade com a demanda motora</rdfs:label>
    <rdfs:comment xml:lang="en">A time- and activity-specific assessment; it is not motor ability or a learning style.</rdfs:comment>
    <cc:conceptOrigin>experimental construct</cc:conceptOrigin>
    <cc:historicalSourceOntology rdf:resource="http://www.semanticweb.org/ricma/ontologies/2024/11/LASDONT.owl"/>
    <cc:historicalSourceConcept>Motor_Weakness</cc:historicalSourceConcept>
    <cc:historicalMappingType>narrower than</cc:historicalMappingType>
  </owl:Class>

  <owl:Class rdf:about="https://contacomigo.org/ontology#SensoryInteractionEvidence">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#InteractionEvidence"/>
    <rdfs:label xml:lang="en">Sensory interaction evidence</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Evidência de interação sensorial</rdfs:label>
    <rdfs:comment xml:lang="en">Software-interaction evidence concerning the sensory load of an activity; it is not a clinical sensory assessment.</rdfs:comment>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <dcterms:source rdf:resource="https://pubmed.ncbi.nlm.nih.gov/28266796/"/>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#SensorySupportNeed">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#SupportNeed"/>
    <rdfs:label xml:lang="en">Sensory support need</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Necessidade de suporte sensorial</rdfs:label>
    <rdfs:comment xml:lang="en">An observed contextual requirement to adjust software sensory load, without diagnosing sensory processing.</rdfs:comment>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <cc:historicalSourceOntology rdf:resource="http://www.semanticweb.org/ricma/ontologies/2024/11/LASDONT.owl"/>
    <cc:historicalSourceConcept>Sensory_Weakness</cc:historicalSourceConcept>
    <cc:historicalMappingType>adapted from</cc:historicalMappingType>
    <dcterms:source rdf:resource="https://pubmed.ncbi.nlm.nih.gov/28266796/"/>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#SensoryLoadTolerance">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#ObservedLearnerCharacteristic"/>
    <rdfs:label xml:lang="en">Sensory load tolerance</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Tolerância à carga sensorial</rdfs:label>
    <rdfs:comment xml:lang="en">Observed software-context compatibility with a specified sensory load; it is time-bounded and non-diagnostic.</rdfs:comment>
    <cc:conceptOrigin>experimental construct</cc:conceptOrigin>
    <cc:historicalSourceOntology rdf:resource="http://www.semanticweb.org/ricma/ontologies/2024/11/LASDONT.owl"/>
    <cc:historicalSourceConcept>Sensory_Strength</cc:historicalSourceConcept>
    <cc:historicalMappingType>adapted from</cc:historicalMappingType>
  </owl:Class>

  <owl:Class rdf:about="https://contacomigo.org/ontology#LogicalReasoningEvidence">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#LearningEvidence"/>
    <rdfs:label xml:lang="en">Logical reasoning evidence</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Evidência de raciocínio lógico</rdfs:label>
    <rdfs:comment xml:lang="en">Evidence from identified mathematical reasoning tasks such as comparison, ordering, patterns, composition, decomposition, generalization, or problem solving.</rdfs:comment>
    <cc:conceptOrigin>engineering concept</cc:conceptOrigin>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#ObservedLogicalReasoningStrength">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#ObservedStrength"/>
    <rdfs:label xml:lang="en">Observed logical reasoning strength</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Força de raciocínio lógico observada</rdfs:label>
    <rdfs:comment xml:lang="en">Contextual favorable evidence from mathematical reasoning tasks, not a consequence of diagnosis.</rdfs:comment>
    <cc:conceptOrigin>experimental construct</cc:conceptOrigin>
    <cc:historicalSourceOntology rdf:resource="http://www.semanticweb.org/ricma/ontologies/2024/11/LASDONT.owl"/>
    <cc:historicalSourceConcept>Logical_Strength</cc:historicalSourceConcept>
    <cc:historicalMappingType>narrower than</cc:historicalMappingType>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#ReasoningSupportNeed">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#SupportNeed"/>
    <rdfs:label xml:lang="en">Reasoning support need</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Necessidade de suporte ao raciocínio</rdfs:label>
    <rdfs:comment xml:lang="en">A contextual need for scaffolding in identified mathematical reasoning tasks, distinct from interaction accessibility.</rdfs:comment>
    <cc:conceptOrigin>experimental construct</cc:conceptOrigin>
    <cc:historicalSourceOntology rdf:resource="http://www.semanticweb.org/ricma/ontologies/2024/11/LASDONT.owl"/>
    <cc:historicalSourceConcept>Logical_Weakness</cc:historicalSourceConcept>
    <cc:historicalMappingType>adapted from</cc:historicalMappingType>
  </owl:Class>

  <owl:Class rdf:about="https://contacomigo.org/ontology#MathematicalDifficultyEvidence">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#LearningEvidence"/>
    <rdfs:label xml:lang="en">Mathematical difficulty evidence</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Evidência de dificuldade matemática</rdfs:label>
    <rdfs:comment xml:lang="en">Evidence concerning a mathematical concept or skill; it must not be inferred solely from interaction-format difficulty.</rdfs:comment>
    <cc:conceptOrigin>engineering concept</cc:conceptOrigin>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#InteractionDifficultyEvidence">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#InteractionEvidence"/>
    <rdfs:label xml:lang="en">Interaction difficulty evidence</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Evidência de dificuldade de interação</rdfs:label>
    <rdfs:comment xml:lang="en">Evidence concerning access to or operation of an interaction format; it does not establish mathematical difficulty.</rdfs:comment>
    <cc:conceptOrigin>engineering concept</cc:conceptOrigin>
  </owl:Class>

  <!-- Semantic aggregates materialized from Learning Analytics in B2.3.
       Event names are provenance hints, never single-event inference rules. -->
  <owl:Class rdf:about="https://contacomigo.org/ontology#ActivityPerformanceEvidence">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#LearningEvidence"/>
    <rdfs:label xml:lang="en">Activity performance evidence</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Evidência de desempenho na atividade</rdfs:label>
    <rdfs:comment xml:lang="en">An aggregate of validated performance observations scoped by learner, activity, skill, and evidence window.</rdfs:comment>
    <cc:analyticsSourceEventType>ANSWER_SUBMITTED</cc:analyticsSourceEventType>
    <cc:analyticsSourceEventType>ACTIVITY_COMPLETED</cc:analyticsSourceEventType>
    <cc:conceptOrigin>engineering concept</cc:conceptOrigin>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#AssistanceUsageEvidence">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#InteractionEvidence"/>
    <rdfs:label xml:lang="en">Assistance usage evidence</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Evidência de uso de ajuda</rdfs:label>
    <rdfs:comment xml:lang="en">An aggregate of explicit assistance interactions; it is not direct evidence of inability or disengagement.</rdfs:comment>
    <cc:analyticsSourceEventType>HINT_REQUESTED</cc:analyticsSourceEventType>
    <cc:analyticsSourceEventType>TUTORIAL_OPENED</cc:analyticsSourceEventType>
    <cc:analyticsSourceEventType>INSTRUCTION_REPLAYED</cc:analyticsSourceEventType>
    <cc:conceptOrigin>engineering concept</cc:conceptOrigin>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#ActivityLifecycleEvidence">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#InteractionEvidence"/>
    <rdfs:label xml:lang="en">Activity lifecycle evidence</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Evidência do ciclo de vida da atividade</rdfs:label>
    <rdfs:comment xml:lang="en">An aggregate over presentation, start, completion, and skip transitions.</rdfs:comment>
    <cc:analyticsSourceEventType>ACTIVITY_PRESENTED</cc:analyticsSourceEventType>
    <cc:analyticsSourceEventType>ACTIVITY_STARTED</cc:analyticsSourceEventType>
    <cc:analyticsSourceEventType>ACTIVITY_COMPLETED</cc:analyticsSourceEventType>
    <cc:analyticsSourceEventType>ACTIVITY_SKIPPED</cc:analyticsSourceEventType>
    <cc:conceptOrigin>engineering concept</cc:conceptOrigin>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#ResponseTimingEvidence">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#InteractionEvidence"/>
    <rdfs:label xml:lang="en">Response timing evidence</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Evidência de tempo de resposta</rdfs:label>
    <rdfs:comment xml:lang="en">A contextual timing aggregate. Slow or fast response alone has no psychological, clinical, or mastery meaning.</rdfs:comment>
    <cc:analyticsSourceEventType>ANSWER_SUBMITTED</cc:analyticsSourceEventType>
    <cc:conceptOrigin>engineering concept</cc:conceptOrigin>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#ActivitySkipHistoryEvidence">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#InteractionEvidence"/>
    <rdfs:label xml:lang="en">Activity skip history evidence</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Evidência do histórico de pulos de atividade</rdfs:label>
    <rdfs:comment xml:lang="en">A contextual history of skips. A skip is an interaction signal and is not intrinsically disengagement or rejection.</rdfs:comment>
    <cc:analyticsSourceEventType>ACTIVITY_SKIPPED</cc:analyticsSourceEventType>
    <cc:conceptOrigin>engineering concept</cc:conceptOrigin>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#RecommendationHistoryEvidence">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#InteractionEvidence"/>
    <rdfs:label xml:lang="en">Recommendation history evidence</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Evidência do histórico de recomendações</rdfs:label>
    <rdfs:comment xml:lang="en">An aggregate connecting recommendations to presentation and completion history without calculating a recommendation score.</rdfs:comment>
    <cc:analyticsSourceEventType>RECOMMENDATION_GENERATED</cc:analyticsSourceEventType>
    <cc:analyticsSourceEventType>RECOMMENDATION_PRESENTED</cc:analyticsSourceEventType>
    <cc:analyticsSourceEventType>RECOMMENDATION_COMPLETED</cc:analyticsSourceEventType>
    <cc:conceptOrigin>engineering concept</cc:conceptOrigin>
  </owl:Class>

  <!-- Learner/evidence relations. PROV-O properties are reused by
       subproperty alignment without owl:imports. -->
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#hasObservedCharacteristic">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#Learner"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#ObservedLearnerCharacteristic"/>
    <rdfs:label xml:lang="en">has observed characteristic</rdfs:label>
    <rdfs:label xml:lang="pt-BR">tem característica observada</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#hasInteractionEvidence">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#Learner"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#InteractionEvidence"/>
    <rdfs:label xml:lang="en">has interaction evidence</rdfs:label>
    <rdfs:label xml:lang="pt-BR">tem evidência de interação</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#derivedFromEvidence">
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasDerivedFrom"/>
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#ObservedLearnerCharacteristic"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#LearningAnalyticsEvidence"/>
    <rdfs:label xml:lang="en">derived from evidence</rdfs:label>
    <rdfs:label xml:lang="pt-BR">derivado de evidência</rdfs:label>
    <cc:sourceOntology rdf:resource="http://www.w3.org/ns/prov#"/>
    <cc:sourceIRI rdf:resource="http://www.w3.org/ns/prov#wasDerivedFrom"/>
    <cc:alignmentRelation>narrower</cc:alignmentRelation>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#wasGeneratedBySession">
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasGeneratedBy"/>
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#InteractionEvidence"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#LearningSession"/>
    <rdfs:label xml:lang="en">was generated by learning session</rdfs:label>
    <rdfs:label xml:lang="pt-BR">foi gerado pela sessão de aprendizagem</rdfs:label>
    <cc:sourceOntology rdf:resource="http://www.w3.org/ns/prov#"/>
    <cc:sourceIRI rdf:resource="http://www.w3.org/ns/prov#wasGeneratedBy"/>
    <cc:alignmentRelation>narrower</cc:alignmentRelation>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#concernsLearner">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#LearningAnalyticsEvidence"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#Learner"/>
    <rdfs:label xml:lang="en">concerns learner</rdfs:label>
    <rdfs:label xml:lang="pt-BR">refere-se ao aprendiz</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#concernsActivity">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#LearningAnalyticsEvidence"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#LearningActivity"/>
    <rdfs:label xml:lang="en">concerns activity</rdfs:label>
    <rdfs:label xml:lang="pt-BR">refere-se à atividade</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#concernsActivityType">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#LearningAnalyticsEvidence"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#ActivityType"/>
    <rdfs:label xml:lang="en">concerns activity type</rdfs:label>
    <rdfs:label xml:lang="pt-BR">refere-se ao tipo de atividade</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#concernsModality">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#LearningAnalyticsEvidence"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#Modality"/>
    <rdfs:label xml:lang="en">concerns modality</rdfs:label>
    <rdfs:label xml:lang="pt-BR">refere-se à modalidade</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#concernsSkill">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#LearningAnalyticsEvidence"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#CurriculumSkill"/>
    <rdfs:label xml:lang="en">concerns skill</rdfs:label>
    <rdfs:label xml:lang="pt-BR">refere-se à habilidade</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#observedDuring">
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#EvidenceWindow"/>
    <rdfs:label xml:lang="en">observed during</rdfs:label>
    <rdfs:label xml:lang="pt-BR">observado durante</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#hasEvidenceWindow">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#ObservedLearnerCharacteristic"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#EvidenceWindow"/>
    <rdfs:label xml:lang="en">has evidence window</rdfs:label>
    <rdfs:label xml:lang="pt-BR">tem janela de evidência</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#supportsCharacteristic">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#LearningAnalyticsEvidence"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#ObservedLearnerCharacteristic"/>
    <rdfs:label xml:lang="en">supports characteristic</rdfs:label>
    <rdfs:label xml:lang="pt-BR">sustenta característica</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#contradictsCharacteristic">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#LearningAnalyticsEvidence"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#ObservedLearnerCharacteristic"/>
    <rdfs:label xml:lang="en">contradicts characteristic</rdfs:label>
    <rdfs:label xml:lang="pt-BR">contradiz característica</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#hasEvidenceAssessment">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#LearnerCharacteristic"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#EvidenceSufficiencyAssessment"/>
    <rdfs:label xml:lang="en">has evidence assessment</rdfs:label>
    <rdfs:label xml:lang="pt-BR">tem avaliação de evidência</rdfs:label>
  </owl:ObjectProperty>

  <!-- Evidence metadata. Numeric values describe evidence; no classification
       threshold or inference rule is encoded in OWL. -->
  <owl:DatatypeProperty rdf:about="https://contacomigo.org/ontology#observationCount">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#EvidenceWindow"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
    <rdfs:label xml:lang="en">observation count</rdfs:label>
    <rdfs:label xml:lang="pt-BR">quantidade de observações</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://contacomigo.org/ontology#evidenceConfidence">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#LearnerKnowledge"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">evidence confidence</rdfs:label>
    <rdfs:label xml:lang="pt-BR">confiança da evidência</rdfs:label>
    <rdfs:comment xml:lang="en">A configurable reasoning-layer confidence value; OWL defines no cutoff or classification threshold.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://contacomigo.org/ontology#observedAt">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#LearningAnalyticsEvidence"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:label xml:lang="en">observed at</rdfs:label>
    <rdfs:label xml:lang="pt-BR">observado em</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://contacomigo.org/ontology#validFrom">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#LearnerKnowledge"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:label xml:lang="en">valid from</rdfs:label>
    <rdfs:label xml:lang="pt-BR">válido a partir de</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://contacomigo.org/ontology#validUntil">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#LearnerKnowledge"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:label xml:lang="en">valid until</rdfs:label>
    <rdfs:label xml:lang="pt-BR">válido até</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://contacomigo.org/ontology#evidenceReason">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#EvidenceSufficiencyAssessment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">evidence reason</rdfs:label>
    <rdfs:label xml:lang="pt-BR">motivo da evidência</rdfs:label>
    <rdfs:comment xml:lang="en">A human-readable explanation such as sparse, stale, untested, absent, or conflicting evidence.</rdfs:comment>
  </owl:DatatypeProperty>

  <!-- Activity semantics and developer-authored family profiles. -->
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#addressesBNCCSkill">
    <rdfs:subPropertyOf rdf:resource="https://contacomigo.org/ontology#addressesCurriculumSkill"/>
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#Activity"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#BNCCSkill"/>
    <rdfs:label xml:lang="en">addresses BNCC skill</rdfs:label>
    <rdfs:label xml:lang="pt-BR">aborda habilidade BNCC</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#hasActivityType">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#Activity"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#ActivityType"/>
    <rdfs:label xml:lang="en">has activity type</rdfs:label>
    <rdfs:label xml:lang="pt-BR">tem tipo de atividade</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#hasRepresentation">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#Activity"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#Representation"/>
    <rdfs:label xml:lang="en">has representation</rdfs:label>
    <rdfs:label xml:lang="pt-BR">tem representação</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#hasInteractionType">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#Activity"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#InteractionType"/>
    <rdfs:label xml:lang="en">has interaction type</rdfs:label>
    <rdfs:label xml:lang="pt-BR">tem tipo de interação</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#hasDifficultyProfile">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#Activity"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#DifficultyProfile"/>
    <rdfs:label xml:lang="en">has difficulty profile</rdfs:label>
    <rdfs:label xml:lang="pt-BR">tem perfil de dificuldade</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#hasActivityAffordance">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#Activity"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#ActivityAffordance"/>
    <rdfs:label xml:lang="en">has activity affordance</rdfs:label>
    <rdfs:label xml:lang="pt-BR">tem recurso de interação</rdfs:label>
  </owl:ObjectProperty>

  <owl:DatatypeProperty rdf:about="https://contacomigo.org/ontology#conceptualComplexity">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#DifficultyProfile"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">conceptual complexity</rdfs:label>
    <rdfs:label xml:lang="pt-BR">complexidade conceitual</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://contacomigo.org/ontology#numericalMagnitude">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#DifficultyProfile"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
    <rdfs:label xml:lang="en">numerical magnitude</rdfs:label>
    <rdfs:label xml:lang="pt-BR">magnitude numérica</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://contacomigo.org/ontology#abstractionLevel">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#DifficultyProfile"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">abstraction level</rdfs:label>
    <rdfs:label xml:lang="pt-BR">nível de abstração</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://contacomigo.org/ontology#stepCount">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#DifficultyProfile"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
    <rdfs:label xml:lang="en">step count</rdfs:label>
    <rdfs:label xml:lang="pt-BR">quantidade de passos</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://contacomigo.org/ontology#distractorSimilarity">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#DifficultyProfile"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">distractor similarity</rdfs:label>
    <rdfs:label xml:lang="pt-BR">semelhança dos distratores</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://contacomigo.org/ontology#languageLoad">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#DifficultyProfile"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">language load</rdfs:label>
    <rdfs:label xml:lang="pt-BR">carga de linguagem</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://contacomigo.org/ontology#motorDemand">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#DifficultyProfile"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">motor demand</rdfs:label>
    <rdfs:label xml:lang="pt-BR">demanda motora</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://contacomigo.org/ontology#sensoryLoad">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#DifficultyProfile"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">sensory load</rdfs:label>
    <rdfs:label xml:lang="pt-BR">carga sensorial</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://contacomigo.org/ontology#scaffoldingLevel">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#DifficultyProfile"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">scaffolding level</rdfs:label>
    <rdfs:label xml:lang="pt-BR">nível de andaimento</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://contacomigo.org/ontology#legacyDifficultyLabel">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#LearningActivity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">legacy difficulty label</rdfs:label>
    <rdfs:label xml:lang="pt-BR">rótulo legado de dificuldade</rdfs:label>
    <cc:historicalSourceOntology rdf:resource="http://www.semanticweb.org/ricma/ontologies/2024/11/LASDONT.owl"/>
    <cc:historicalSourceConcept>Easy_Content</cc:historicalSourceConcept>
    <cc:historicalSourceConcept>Mid_Content</cc:historicalSourceConcept>
    <cc:historicalSourceConcept>Hard_Content</cc:historicalSourceConcept>
    <cc:historicalMappingType>related to</cc:historicalMappingType>
    <rdfs:comment xml:lang="en">Compatibility value from the current easy, medium, or hard enum; it does not determine the multidimensional profile.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://contacomigo.org/ontology#requiresDragging">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#Activity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">requires dragging</rdfs:label>
    <rdfs:label xml:lang="pt-BR">exige arrastar</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://contacomigo.org/ontology#requiresReading">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#Activity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">requires reading</rdfs:label>
    <rdfs:label xml:lang="pt-BR">exige leitura</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://contacomigo.org/ontology#usesAudio">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#Activity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">uses audio</rdfs:label>
    <rdfs:label xml:lang="pt-BR">usa áudio</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://contacomigo.org/ontology#usesPictograms">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#Activity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">uses pictograms</rdfs:label>
    <rdfs:label xml:lang="pt-BR">usa pictogramas</rdfs:label>
    <rdfs:comment xml:lang="en">For an activity-family profile, true means the inspected implementation currently supports or uses pictograms; concrete activity materialization must provide its own value.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://contacomigo.org/ontology#activityMappingStatus">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#ActivityFamilyProfile"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">activity mapping status</rdfs:label>
    <rdfs:label xml:lang="pt-BR">situação do mapeamento da atividade</rdfs:label>
    <rdfs:comment xml:lang="en">Allowed family-profile values: PARTIAL, NEEDS_REVIEW, and INCOMPLETE.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://contacomigo.org/ontology#annotationProvenance">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#ActivityCharacteristic"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">annotation provenance</rdfs:label>
    <rdfs:label xml:lang="pt-BR">proveniência da anotação</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://contacomigo.org/ontology#unannotatedDimension">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#DifficultyProfile"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">unannotated dimension</rdfs:label>
    <rdfs:label xml:lang="pt-BR">dimensão não anotada</rdfs:label>
  </owl:DatatypeProperty>

