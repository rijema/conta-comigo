    <cc:hasCurriculumCode>EF05MA09</cc:hasCurriculumCode>
    <cc:hasOfficialDescription xml:lang="pt-BR">Resolver e elaborar problemas simples de contagem envolvendo o princípio multiplicativo, como a determinação do número de agrupamentos possíveis ao se combinar cada elemento de uma coleção com todos os elementos de outra coleção, por meio de diagramas de árvore ou por tabelas.</cc:hasOfficialDescription>
    <cc:belongsToCurriculum rdf:resource="https://contacomigo.org/ontology#BrazilianNationalCommonCoreCurriculum"/>
