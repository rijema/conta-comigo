<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
    xmlns="https://contacomigo.org/ontology#"
    xml:base="https://contacomigo.org/ontology"
    xmlns:cc="https://contacomigo.org/ontology#"
    xmlns:dc="http://purl.org/dc/elements/1.1/"
    xmlns:dcterms="http://purl.org/dc/terms/"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:prov="http://www.w3.org/ns/prov#"
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:skos="http://www.w3.org/2004/02/skos/core#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

  <owl:Ontology rdf:about="https://contacomigo.org/ontology">
    <rdfs:label xml:lang="pt-BR">Ontologia ContaComigo</rdfs:label>
    <rdfs:comment xml:lang="pt-BR">Fundação semântica educacional para matemática inicial. Esta versão não importa nem executa a OntoMathEdu.</rdfs:comment>
    <owl:versionInfo>0.2.0</owl:versionInfo>
    <dcterms:source rdf:resource="http://ontomathpro.org/ontomathedu#"/>
    <dcterms:source rdf:resource="https://github.com/CLLKazan/OntoMathEdu"/>
    <dcterms:source rdf:resource="https://ceur-ws.org/Vol-2634/WiP1.pdf"/>
    <dcterms:source rdf:resource="https://ceur-ws.org/Vol-2784/spaper07.pdf"/>
    <dcterms:source rdf:resource="http://www.semanticweb.org/ricma/ontologies/2024/11/LASDONT.owl"/>
    <dcterms:source rdf:resource="https://doi.org/10.1111/j.1539-6053.2009.01038.x"/>
    <dcterms:source rdf:resource="https://doi.org/10.1111/jcpp.13534"/>
    <dcterms:source rdf:resource="https://doi.org/10.1007/s41252-023-00348-z"/>
    <dcterms:source rdf:resource="https://pubmed.ncbi.nlm.nih.gov/28266796/"/>
    <dcterms:source rdf:resource="https://pubmed.ncbi.nlm.nih.gov/36949273/"/>
    <dcterms:source rdf:resource="https://udlguidelines.cast.org/"/>
    <dcterms:source rdf:resource="https://www.w3.org/TR/wcag/"/>
    <dcterms:source rdf:resource="https://www.w3.org/TR/prov-o/"/>
    <dcterms:source rdf:resource="https://doi.org/10.3102/00346543211020116"/>
  </owl:Ontology>

  <!-- Provenance annotations. Values for alignmentRelation are restricted by
       project convention to imported, equivalent, narrower, broader, related,
       or adapted. This ontology currently uses neither imported nor equivalent. -->
  <owl:AnnotationProperty rdf:about="https://contacomigo.org/ontology#sourceOntology">
    <rdfs:label xml:lang="en">source ontology</rdfs:label>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://contacomigo.org/ontology#sourceIRI">
    <rdfs:label xml:lang="en">source IRI</rdfs:label>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://contacomigo.org/ontology#alignmentRelation">
    <rdfs:label xml:lang="en">alignment relation</rdfs:label>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://contacomigo.org/ontology#alignmentNote">
    <rdfs:label xml:lang="en">alignment note</rdfs:label>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://contacomigo.org/ontology#conceptOrigin">
    <rdfs:label xml:lang="en">concept origin</rdfs:label>
    <rdfs:comment xml:lang="en">Project classification: reused ontology concept, aligned ontology concept, literature-grounded ContaComigo concept, engineering concept, experimental construct, or historical LASDONT concept.</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://contacomigo.org/ontology#historicalSourceOntology">
    <rdfs:label xml:lang="en">historical source ontology</rdfs:label>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://contacomigo.org/ontology#historicalSourceConcept">
    <rdfs:label xml:lang="en">historical source concept</rdfs:label>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://contacomigo.org/ontology#historicalMappingType">
    <rdfs:label xml:lang="en">historical mapping type</rdfs:label>
    <rdfs:comment xml:lang="en">Allowed values: historical predecessor, adapted from, narrower than, broader than, related to, deprecated historical concept, and no longer used.</rdfs:comment>
  </owl:AnnotationProperty>

  <!-- Knowledge-layer partition. -->
  <owl:Class rdf:about="https://contacomigo.org/ontology#KnowledgeEntity">
    <rdfs:label xml:lang="en">Knowledge entity</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Entidade de conhecimento</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="https://contacomigo.org/ontology#MathematicalKnowledge">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#KnowledgeEntity"/>
    <rdfs:label xml:lang="en">Mathematical knowledge</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Conhecimento matemático</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="https://contacomigo.org/ontology#CurricularKnowledge">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#KnowledgeEntity"/>
    <rdfs:label xml:lang="en">Curricular knowledge</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Conhecimento curricular</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="https://contacomigo.org/ontology#LearnerKnowledge">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#KnowledgeEntity"/>
    <rdfs:label xml:lang="en">Learner knowledge</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Conhecimento sobre o estudante</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="https://contacomigo.org/ontology#ActivityKnowledge">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#KnowledgeEntity"/>
    <rdfs:label xml:lang="en">Activity knowledge</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Conhecimento sobre atividades</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="https://contacomigo.org/ontology#LearningAnalyticsEvidence">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#KnowledgeEntity"/>
    <rdfs:label xml:lang="en">Learning Analytics evidence</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Evidência de Learning Analytics</rdfs:label>
  </owl:Class>

  <!-- Mathematical and didactic foundation. -->
  <owl:Class rdf:about="https://contacomigo.org/ontology#MathematicalConcept">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#MathematicalKnowledge"/>
    <rdfs:label xml:lang="en">Mathematical concept</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Conceito matemático</rdfs:label>
    <cc:sourceOntology rdf:resource="http://ontomathpro.org/ontomathedu#"/>
    <cc:sourceIRI rdf:resource="http://ontomathpro.org/ontomathedu#"/>
    <cc:alignmentRelation>adapted</cc:alignmentRelation>
    <cc:alignmentNote xml:lang="pt-BR">Classe local adaptada do princípio de camada de domínio matemático da OntoMathEdu; não existe classe nomeada MathematicalConcept no artefato distribuído.</cc:alignmentNote>
  </owl:Class>

  <owl:Class rdf:about="https://contacomigo.org/ontology#DidacticRelation">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#MathematicalKnowledge"/>
    <rdfs:label xml:lang="en">Didactic relation</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Relação didática</rdfs:label>
    <cc:sourceOntology rdf:resource="http://ontomathpro.org/ontomathedu#"/>
    <cc:sourceIRI rdf:resource="http://ontomathpro.org/ontomathedu#hasPrerequisite"/>
    <cc:alignmentRelation>adapted</cc:alignmentRelation>
    <cc:alignmentNote xml:lang="pt-BR">Relação reificada local inspirada na dimensão didática descrita pela OntoMathEdu; o artefato distribui hasPrerequisite como propriedade de anotação.</cc:alignmentNote>
  </owl:Class>

  <owl:Class rdf:about="https://contacomigo.org/ontology#PrerequisiteRelation">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#DidacticRelation"/>
    <rdfs:label xml:lang="en">Prerequisite relation</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Relação de pré-requisito</rdfs:label>
    <cc:sourceOntology rdf:resource="http://ontomathpro.org/ontomathedu#"/>
    <cc:sourceIRI rdf:resource="http://ontomathpro.org/ontomathedu#hasPrerequisite"/>
    <cc:alignmentRelation>adapted</cc:alignmentRelation>
    <cc:alignmentNote xml:lang="pt-BR">Adaptação reificada e ligada por IRIs; não é equivalente à propriedade de anotação textual da distribuição OntoMathEdu.</cc:alignmentNote>
  </owl:Class>

  <!-- ContaComigo early-mathematics scope. These local concepts do not claim
       that corresponding OntoMathEdu classes exist. -->
  <owl:Class rdf:about="https://contacomigo.org/ontology#NumberConcept">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#MathematicalConcept"/>
    <rdfs:label xml:lang="en">Number concept</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Conceito de número</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#CountingConcept">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#NumberConcept"/>
    <rdfs:label xml:lang="en">Counting concept</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Conceito de contagem</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#ComparisonConcept">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#MathematicalConcept"/>
    <rdfs:label xml:lang="en">Comparison concept</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Conceito de comparação</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#AdditionConcept">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#MathematicalConcept"/>
    <rdfs:label xml:lang="en">Addition concept</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Conceito de adição</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#SubtractionConcept">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#MathematicalConcept"/>
    <rdfs:label xml:lang="en">Subtraction concept</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Conceito de subtração</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#SequencePatternConcept">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#MathematicalConcept"/>
    <rdfs:label xml:lang="en">Sequence and pattern concept</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Conceito de sequência e padrão</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#EarlyProblemSolvingConcept">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#MathematicalConcept"/>
    <rdfs:label xml:lang="en">Early problem-solving concept</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Conceito inicial de resolução de problemas</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#BasicGeometryConcept">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#MathematicalConcept"/>
    <rdfs:label xml:lang="en">Basic geometry concept</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Conceito de geometria básica</rdfs:label>
  </owl:Class>

  <!-- Conservative links to confirmed OntoMathEdu classes. -->
  <owl:Class rdf:about="https://contacomigo.org/ontology#PointConcept">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#BasicGeometryConcept"/>
    <rdfs:label xml:lang="en">Point concept</rdfs:label>
    <cc:sourceOntology rdf:resource="http://ontomathpro.org/ontomathedu#"/>
    <cc:sourceIRI rdf:resource="http://ontomathpro.org/ontomathedu#R71GKMyesTQoOWWvX1M74EE"/>
    <cc:alignmentRelation>related</cc:alignmentRelation>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#AngleConcept">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#BasicGeometryConcept"/>
    <rdfs:label xml:lang="en">Angle concept</rdfs:label>
    <cc:sourceOntology rdf:resource="http://ontomathpro.org/ontomathedu#"/>
    <cc:sourceIRI rdf:resource="http://ontomathpro.org/ontomathedu#R9lMyAYbMeEYN0OdD7cbwZ6"/>
    <cc:alignmentRelation>related</cc:alignmentRelation>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#SquareConcept">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#BasicGeometryConcept"/>
    <rdfs:label xml:lang="en">Square concept</rdfs:label>
    <cc:sourceOntology rdf:resource="http://ontomathpro.org/ontomathedu#"/>
    <cc:sourceIRI rdf:resource="http://ontomathpro.org/ontomathedu#R81puoDaG8DotyXihsGWNY6"/>
    <cc:alignmentRelation>related</cc:alignmentRelation>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#RectangleConcept">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#BasicGeometryConcept"/>
    <rdfs:label xml:lang="en">Rectangle concept</rdfs:label>
    <cc:sourceOntology rdf:resource="http://ontomathpro.org/ontomathedu#"/>
    <cc:sourceIRI rdf:resource="http://ontomathpro.org/ontomathedu#R9x3QFCyHrHe0SoE3ZCZr94"/>
    <cc:alignmentRelation>related</cc:alignmentRelation>
  </owl:Class>

  <!-- Curricular, learner, activity, and evidence bridge concepts. -->
  <owl:Class rdf:about="https://contacomigo.org/ontology#CurriculumSkill">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#CurricularKnowledge"/>
    <rdfs:label xml:lang="en">Curriculum skill</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Habilidade curricular</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#BNCCSkill">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#CurriculumSkill"/>
    <rdfs:label xml:lang="pt-BR">Habilidade BNCC</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#CurriculumLevel">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#CurricularKnowledge"/>
    <rdfs:label xml:lang="en">Curriculum level</rdfs:label>
    <cc:sourceOntology rdf:resource="http://ontomathpro.org/ontomathedu#"/>
    <cc:sourceIRI rdf:resource="http://ontomathpro.org/ontomathedu#EducationalLevel"/>
    <cc:alignmentRelation>adapted</cc:alignmentRelation>
    <cc:alignmentNote xml:lang="pt-BR">Adaptado para permitir níveis curriculares brasileiros; não equivale aos níveis russos ou britânicos distribuídos.</cc:alignmentNote>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#LearnerSkillState">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#LearnerKnowledge"/>
    <rdfs:label xml:lang="en">Learner skill state</rdfs:label>
    <rdfs:comment xml:lang="en">Semantic reference to the current skill-mastery state whose calculation remains owned by Bayesian Knowledge Tracing.</rdfs:comment>
    <cc:conceptOrigin>engineering concept</cc:conceptOrigin>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#LearningActivity">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#ActivityKnowledge"/>
    <rdfs:label xml:lang="en">Learning activity</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#LearningEventEvidence">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#LearningAnalyticsEvidence"/>
    <rdfs:label xml:lang="en">Learning-event evidence</rdfs:label>
    <rdfs:comment xml:lang="en">Semantic reference to immutable interaction records kept in the Learning Analytics persistence layer.</rdfs:comment>
    <cc:conceptOrigin>engineering concept</cc:conceptOrigin>
  </owl:Class>

  <!-- Queryable semantic relations for the competency questions. -->
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#hasDidacticRelation">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#MathematicalConcept"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#DidacticRelation"/>
    <rdfs:label xml:lang="en">has didactic relation</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#prerequisiteConcept">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#PrerequisiteRelation"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#MathematicalConcept"/>
    <rdfs:label xml:lang="en">prerequisite concept</rdfs:label>
    <cc:sourceOntology rdf:resource="http://ontomathpro.org/ontomathedu#"/>
    <cc:sourceIRI rdf:resource="http://ontomathpro.org/ontomathedu#hasPrerequisite"/>
    <cc:alignmentRelation>adapted</cc:alignmentRelation>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#dependentConcept">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#PrerequisiteRelation"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#MathematicalConcept"/>
    <rdfs:label xml:lang="en">dependent concept</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#addressesMathematicalConcept">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#CurriculumSkill"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#MathematicalConcept"/>
    <rdfs:label xml:lang="en">addresses mathematical concept</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#developsMathematicalConcept">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#LearningActivity"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#MathematicalConcept"/>
    <rdfs:label xml:lang="en">develops mathematical concept</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#requiresPrerequisite">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#LearningActivity"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#MathematicalConcept"/>
    <rdfs:label xml:lang="en">requires prerequisite</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#providesEvidenceFor">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#LearningAnalyticsEvidence"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#MathematicalConcept"/>
    <rdfs:label xml:lang="en">provides evidence for</rdfs:label>
  </owl:ObjectProperty>

  <!-- Neuroinclusive learner model. Characteristics are contextual entities,
       never essential or permanent types assigned directly to a learner. -->
  <owl:Class rdf:about="https://contacomigo.org/ontology#Learner">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#LearnerKnowledge"/>
    <rdfs:label xml:lang="en">Learner</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Aprendiz</rdfs:label>
    <rdfs:comment xml:lang="en">A learner participating in an educational experience; diagnosis does not entail any learner characteristic.</rdfs:comment>
    <cc:conceptOrigin>engineering concept</cc:conceptOrigin>
  </owl:Class>

  <owl:Class rdf:about="https://contacomigo.org/ontology#LearnerCharacteristic">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#LearnerKnowledge"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="en">Learner characteristic</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Característica do aprendiz</rdfs:label>
    <rdfs:comment xml:lang="en">A contextual, revisable learner-model entity; it is not an essential property or diagnosis.</rdfs:comment>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <dcterms:source rdf:resource="https://doi.org/10.1111/jcpp.13534"/>
  </owl:Class>

  <owl:Class rdf:about="https://contacomigo.org/ontology#ObservedLearnerCharacteristic">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#LearnerCharacteristic"/>
    <rdfs:label xml:lang="en">Observed learner characteristic</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Característica observada do aprendiz</rdfs:label>
    <rdfs:comment xml:lang="en">A time-bounded interpretation supported by contextual evidence from more than an unqualified single interaction or by an explicitly identified assessment source.</rdfs:comment>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <dcterms:source rdf:resource="https://doi.org/10.3102/00346543211020116"/>
  </owl:Class>

  <owl:Class rdf:about="https://contacomigo.org/ontology#ObservedStrength">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#ObservedLearnerCharacteristic"/>
    <rdfs:label xml:lang="en">Observed strength</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Força observada</rdfs:label>
    <rdfs:comment xml:lang="en">Context-specific favorable performance or interaction evidence, subject to an evidence window and revision.</rdfs:comment>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <dcterms:source rdf:resource="https://doi.org/10.1007/s41252-023-00348-z"/>
  </owl:Class>

  <owl:Class rdf:about="https://contacomigo.org/ontology#ObservedPreference">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#ObservedLearnerCharacteristic"/>
    <rdfs:label xml:lang="en">Observed preference</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Preferência observada</rdfs:label>
    <rdfs:comment xml:lang="en">A contextual interaction preference that does not imply superior learning outcomes or a fixed learning style.</rdfs:comment>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <dcterms:source rdf:resource="https://doi.org/10.1111/j.1539-6053.2009.01038.x"/>
  </owl:Class>

  <owl:Class rdf:about="https://contacomigo.org/ontology#SupportNeed">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#ObservedLearnerCharacteristic"/>
    <rdfs:label xml:lang="en">Support need</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Necessidade de suporte</rdfs:label>
    <rdfs:comment xml:lang="en">A contextual requirement for access or participation; it does not by itself assert inability or clinical impairment.</rdfs:comment>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <dcterms:source rdf:resource="https://udlguidelines.cast.org/"/>
  </owl:Class>

  <!-- Evidence entities and sufficiency are separate from characteristics. -->
  <owl:Class rdf:about="https://contacomigo.org/ontology#InteractionEvidence">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#LearningAnalyticsEvidence"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="en">Interaction evidence</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Evidência de interação</rdfs:label>
    <rdfs:comment xml:lang="en">A semantic evidence entity derived from interaction records or aggregations; it does not give a raw event an intrinsic psychological meaning.</rdfs:comment>
    <cc:conceptOrigin>aligned ontology concept</cc:conceptOrigin>
    <cc:sourceOntology rdf:resource="http://www.w3.org/ns/prov#"/>
    <cc:sourceIRI rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <cc:alignmentRelation>narrower</cc:alignmentRelation>
  </owl:Class>

  <owl:Class rdf:about="https://contacomigo.org/ontology#LearningEvidence">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#InteractionEvidence"/>
    <rdfs:label xml:lang="en">Learning evidence</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Evidência de aprendizagem</rdfs:label>
    <rdfs:comment xml:lang="en">Evidence about mathematical learning or performance, distinct from interaction-format fit.</rdfs:comment>
    <cc:conceptOrigin>engineering concept</cc:conceptOrigin>
  </owl:Class>

  <owl:Class rdf:about="https://contacomigo.org/ontology#EvidenceWindow">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#LearnerKnowledge"/>
    <rdfs:label xml:lang="en">Evidence window</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Janela de evidência</rdfs:label>
    <rdfs:comment xml:lang="en">A bounded contextual interval over which evidence is selected and interpreted.</rdfs:comment>
    <cc:conceptOrigin>engineering concept</cc:conceptOrigin>
  </owl:Class>

  <owl:Class rdf:about="https://contacomigo.org/ontology#Observation">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#LearningAnalyticsEvidence"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="en">Observation</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Observação</rdfs:label>
    <rdfs:comment xml:lang="en">A contextual observation produced from one or more persisted records or an explicitly identified human assessment.</rdfs:comment>
    <cc:conceptOrigin>aligned ontology concept</cc:conceptOrigin>
    <cc:sourceOntology rdf:resource="http://www.w3.org/ns/prov#"/>
    <cc:sourceIRI rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <cc:alignmentRelation>narrower</cc:alignmentRelation>
  </owl:Class>

  <owl:Class rdf:about="https://contacomigo.org/ontology#EvidenceSufficiencyAssessment">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#LearnerKnowledge"/>
    <rdfs:label xml:lang="en">Evidence sufficiency assessment</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Avaliação de suficiência de evidência</rdfs:label>
    <rdfs:comment xml:lang="en">A revisable result of applying a documented reasoning policy to an evidence set.</rdfs:comment>
    <cc:conceptOrigin>experimental construct</cc:conceptOrigin>
  </owl:Class>

  <owl:Class rdf:about="https://contacomigo.org/ontology#InsufficientEvidence">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#EvidenceSufficiencyAssessment"/>
    <rdfs:label xml:lang="en">Insufficient evidence</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Evidência insuficiente</rdfs:label>
    <rdfs:comment xml:lang="en">Evidence is unavailable, stale, too sparse, untested for the context, or conflicting. This is not evidence of weakness or a support need.</rdfs:comment>
    <cc:conceptOrigin>experimental construct</cc:conceptOrigin>
  </owl:Class>

  <owl:Class rdf:about="https://contacomigo.org/ontology#LearningSession">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#ActivityKnowledge"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <rdfs:label xml:lang="en">Learning session</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Sessão de aprendizagem</rdfs:label>
    <cc:conceptOrigin>aligned ontology concept</cc:conceptOrigin>
    <cc:sourceOntology rdf:resource="http://www.w3.org/ns/prov#"/>
    <cc:sourceIRI rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <cc:alignmentRelation>narrower</cc:alignmentRelation>
  </owl:Class>

  <owl:Class rdf:about="https://contacomigo.org/ontology#ActivityCharacteristic">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#ActivityKnowledge"/>
    <rdfs:label xml:lang="en">Activity characteristic</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Característica da atividade</rdfs:label>
    <rdfs:comment xml:lang="en">A characteristic of an educational activity, kept outside the learner-characteristic hierarchy.</rdfs:comment>
    <cc:conceptOrigin>engineering concept</cc:conceptOrigin>
  </owl:Class>

  <owl:Class rdf:about="https://contacomigo.org/ontology#ActivityType">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#ActivityCharacteristic"/>
    <rdfs:label xml:lang="en">Activity type</rdfs:label>
    <cc:conceptOrigin>engineering concept</cc:conceptOrigin>
  </owl:Class>

  <owl:Class rdf:about="https://contacomigo.org/ontology#Modality">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#ActivityCharacteristic"/>
    <rdfs:label xml:lang="en">Modality</rdfs:label>
    <rdfs:comment xml:lang="en">A presentation or interaction modality; it is not a learner type.</rdfs:comment>
    <cc:conceptOrigin>engineering concept</cc:conceptOrigin>
  </owl:Class>

  <!-- Context-specific reinterpretations of the five historical dimensions. -->
  <owl:Class rdf:about="https://contacomigo.org/ontology#VisualInteractionEvidence">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#InteractionEvidence"/>
    <rdfs:label xml:lang="en">Visual interaction evidence</rdfs:label>
    <rdfs:comment xml:lang="en">Evidence concerning interaction or performance with visual or pictorial representation.</rdfs:comment>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <dcterms:source rdf:resource="https://udlguidelines.cast.org/"/>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#ObservedVisualStrength">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#ObservedStrength"/>
    <rdfs:label xml:lang="en">Observed visual strength</rdfs:label>
    <rdfs:comment xml:lang="en">Comparatively favorable contextual outcomes under visual representation within an identified evidence window.</rdfs:comment>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <cc:historicalSourceOntology rdf:resource="http://www.semanticweb.org/ricma/ontologies/2024/11/LASDONT.owl"/>
    <cc:historicalSourceConcept>Visual_Strength</cc:historicalSourceConcept>
    <cc:historicalMappingType>adapted from</cc:historicalMappingType>
    <dcterms:source rdf:resource="https://doi.org/10.1007/s41252-023-00348-z"/>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#ObservedVisualPreference">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#ObservedPreference"/>
    <rdfs:label xml:lang="en">Observed visual preference</rdfs:label>
    <rdfs:comment xml:lang="en">A contextual preference for visual interaction; it makes no claim about improved learning.</rdfs:comment>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <cc:historicalSourceOntology rdf:resource="http://www.semanticweb.org/ricma/ontologies/2024/11/LASDONT.owl"/>
    <cc:historicalSourceConcept>Visual_Strength</cc:historicalSourceConcept>
    <cc:historicalMappingType>related to</cc:historicalMappingType>
    <dcterms:source rdf:resource="https://doi.org/10.1111/j.1539-6053.2009.01038.x"/>
  </owl:Class>

  <owl:Class rdf:about="https://contacomigo.org/ontology#AuditoryInteractionEvidence">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#InteractionEvidence"/>
    <rdfs:label xml:lang="en">Auditory interaction evidence</rdfs:label>
    <rdfs:comment xml:lang="en">Evidence concerning spoken or audio instruction and auditory presentation.</rdfs:comment>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <dcterms:source rdf:resource="https://udlguidelines.cast.org/"/>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#ObservedAuditoryStrength">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#ObservedStrength"/>
    <rdfs:label xml:lang="en">Observed auditory strength</rdfs:label>
    <rdfs:comment xml:lang="en">Comparatively favorable contextual outcomes with auditory presentation within an identified evidence window.</rdfs:comment>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <cc:historicalSourceOntology rdf:resource="http://www.semanticweb.org/ricma/ontologies/2024/11/LASDONT.owl"/>
    <cc:historicalSourceConcept>Auditive_Strength</cc:historicalSourceConcept>
    <cc:historicalMappingType>adapted from</cc:historicalMappingType>
    <dcterms:source rdf:resource="https://doi.org/10.1007/s41252-023-00348-z"/>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#ObservedAuditoryPreference">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#ObservedPreference"/>
    <rdfs:label xml:lang="en">Observed auditory preference</rdfs:label>
    <rdfs:comment xml:lang="en">A contextual preference for auditory interaction; it makes no claim about improved learning.</rdfs:comment>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <cc:historicalSourceOntology rdf:resource="http://www.semanticweb.org/ricma/ontologies/2024/11/LASDONT.owl"/>
    <cc:historicalSourceConcept>Auditive_Strength</cc:historicalSourceConcept>
    <cc:historicalMappingType>related to</cc:historicalMappingType>
    <dcterms:source rdf:resource="https://doi.org/10.1111/j.1539-6053.2009.01038.x"/>
  </owl:Class>

  <owl:Class rdf:about="https://contacomigo.org/ontology#MotorInteractionEvidence">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#InteractionEvidence"/>
    <rdfs:label xml:lang="en">Motor interaction evidence</rdfs:label>
    <rdfs:comment xml:lang="en">Evidence about interaction demands such as dragging, pointing, or target activation, separate from mathematical performance.</rdfs:comment>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <dcterms:source rdf:resource="https://www.w3.org/TR/wcag/"/>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#MotorSupportNeed">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#SupportNeed"/>
    <rdfs:label xml:lang="en">Motor support need</rdfs:label>
    <rdfs:comment xml:lang="en">A temporary or contextual need for an alternative interaction method; it does not assert mathematical difficulty.</rdfs:comment>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <cc:historicalSourceOntology rdf:resource="http://www.semanticweb.org/ricma/ontologies/2024/11/LASDONT.owl"/>
    <cc:historicalSourceConcept>Motor_Weakness</cc:historicalSourceConcept>
    <cc:historicalMappingType>adapted from</cc:historicalMappingType>
    <dcterms:source rdf:resource="https://www.w3.org/TR/wcag/"/>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#MotorInteractionPreference">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#ObservedPreference"/>
    <rdfs:label xml:lang="en">Motor interaction preference</rdfs:label>
    <rdfs:comment xml:lang="en">A contextual preference among available input methods.</rdfs:comment>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <cc:historicalSourceOntology rdf:resource="http://www.semanticweb.org/ricma/ontologies/2024/11/LASDONT.owl"/>
    <cc:historicalSourceConcept>Motor_Strength</cc:historicalSourceConcept>
    <cc:historicalMappingType>related to</cc:historicalMappingType>
    <dcterms:source rdf:resource="https://udlguidelines.cast.org/"/>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#InteractionCompatibilityAssessment">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#LearnerKnowledge"/>
    <rdfs:label xml:lang="en">Interaction compatibility assessment</rdfs:label>
    <rdfs:comment xml:lang="en">A contextual assessment of fit between interaction requirements and observed learner support information.</rdfs:comment>
    <cc:conceptOrigin>experimental construct</cc:conceptOrigin>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#MotorDemandCompatibility">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#InteractionCompatibilityAssessment"/>
    <rdfs:label xml:lang="en">Motor demand compatibility</rdfs:label>
    <rdfs:comment xml:lang="en">A time- and activity-specific assessment; it is not motor ability or a learning style.</rdfs:comment>
    <cc:conceptOrigin>experimental construct</cc:conceptOrigin>
    <cc:historicalSourceOntology rdf:resource="http://www.semanticweb.org/ricma/ontologies/2024/11/LASDONT.owl"/>
    <cc:historicalSourceConcept>Motor_Weakness</cc:historicalSourceConcept>
    <cc:historicalMappingType>narrower than</cc:historicalMappingType>
  </owl:Class>

  <owl:Class rdf:about="https://contacomigo.org/ontology#SensoryInteractionEvidence">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#InteractionEvidence"/>
    <rdfs:label xml:lang="en">Sensory interaction evidence</rdfs:label>
    <rdfs:comment xml:lang="en">Software-interaction evidence concerning the sensory load of an activity; it is not a clinical sensory assessment.</rdfs:comment>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <dcterms:source rdf:resource="https://pubmed.ncbi.nlm.nih.gov/28266796/"/>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#SensorySupportNeed">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#SupportNeed"/>
    <rdfs:label xml:lang="en">Sensory support need</rdfs:label>
    <rdfs:comment xml:lang="en">An observed contextual requirement to adjust software sensory load, without diagnosing sensory processing.</rdfs:comment>
    <cc:conceptOrigin>literature-grounded ContaComigo concept</cc:conceptOrigin>
    <cc:historicalSourceOntology rdf:resource="http://www.semanticweb.org/ricma/ontologies/2024/11/LASDONT.owl"/>
    <cc:historicalSourceConcept>Sensory_Weakness</cc:historicalSourceConcept>
    <cc:historicalMappingType>adapted from</cc:historicalMappingType>
    <dcterms:source rdf:resource="https://pubmed.ncbi.nlm.nih.gov/28266796/"/>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#SensoryLoadTolerance">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#ObservedLearnerCharacteristic"/>
    <rdfs:label xml:lang="en">Sensory load tolerance</rdfs:label>
    <rdfs:comment xml:lang="en">Observed software-context compatibility with a specified sensory load; it is time-bounded and non-diagnostic.</rdfs:comment>
    <cc:conceptOrigin>experimental construct</cc:conceptOrigin>
    <cc:historicalSourceOntology rdf:resource="http://www.semanticweb.org/ricma/ontologies/2024/11/LASDONT.owl"/>
    <cc:historicalSourceConcept>Sensory_Strength</cc:historicalSourceConcept>
    <cc:historicalMappingType>adapted from</cc:historicalMappingType>
  </owl:Class>

  <owl:Class rdf:about="https://contacomigo.org/ontology#LogicalReasoningEvidence">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#LearningEvidence"/>
    <rdfs:label xml:lang="en">Logical reasoning evidence</rdfs:label>
    <rdfs:comment xml:lang="en">Evidence from identified mathematical reasoning tasks such as comparison, ordering, patterns, composition, decomposition, generalization, or problem solving.</rdfs:comment>
    <cc:conceptOrigin>engineering concept</cc:conceptOrigin>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#ObservedLogicalReasoningStrength">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#ObservedStrength"/>
    <rdfs:label xml:lang="en">Observed logical reasoning strength</rdfs:label>
    <rdfs:comment xml:lang="en">Contextual favorable evidence from mathematical reasoning tasks, not a consequence of diagnosis.</rdfs:comment>
    <cc:conceptOrigin>experimental construct</cc:conceptOrigin>
    <cc:historicalSourceOntology rdf:resource="http://www.semanticweb.org/ricma/ontologies/2024/11/LASDONT.owl"/>
    <cc:historicalSourceConcept>Logical_Strength</cc:historicalSourceConcept>
    <cc:historicalMappingType>narrower than</cc:historicalMappingType>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#ReasoningSupportNeed">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#SupportNeed"/>
    <rdfs:label xml:lang="en">Reasoning support need</rdfs:label>
    <rdfs:comment xml:lang="en">A contextual need for scaffolding in identified mathematical reasoning tasks, distinct from interaction accessibility.</rdfs:comment>
    <cc:conceptOrigin>experimental construct</cc:conceptOrigin>
    <cc:historicalSourceOntology rdf:resource="http://www.semanticweb.org/ricma/ontologies/2024/11/LASDONT.owl"/>
    <cc:historicalSourceConcept>Logical_Weakness</cc:historicalSourceConcept>
    <cc:historicalMappingType>adapted from</cc:historicalMappingType>
  </owl:Class>

  <owl:Class rdf:about="https://contacomigo.org/ontology#MathematicalDifficultyEvidence">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#LearningEvidence"/>
    <rdfs:label xml:lang="en">Mathematical difficulty evidence</rdfs:label>
    <rdfs:comment xml:lang="en">Evidence concerning a mathematical concept or skill; it must not be inferred solely from interaction-format difficulty.</rdfs:comment>
    <cc:conceptOrigin>engineering concept</cc:conceptOrigin>
  </owl:Class>
  <owl:Class rdf:about="https://contacomigo.org/ontology#InteractionDifficultyEvidence">
    <rdfs:subClassOf rdf:resource="https://contacomigo.org/ontology#InteractionEvidence"/>
    <rdfs:label xml:lang="en">Interaction difficulty evidence</rdfs:label>
    <rdfs:comment xml:lang="en">Evidence concerning access to or operation of an interaction format; it does not establish mathematical difficulty.</rdfs:comment>
    <cc:conceptOrigin>engineering concept</cc:conceptOrigin>
  </owl:Class>

  <!-- Learner/evidence relations. PROV-O properties are reused by
       subproperty alignment without owl:imports. -->
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#hasObservedCharacteristic">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#Learner"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#ObservedLearnerCharacteristic"/>
    <rdfs:label xml:lang="en">has observed characteristic</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#hasInteractionEvidence">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#Learner"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#InteractionEvidence"/>
    <rdfs:label xml:lang="en">has interaction evidence</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#derivedFromEvidence">
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasDerivedFrom"/>
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#ObservedLearnerCharacteristic"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#LearningAnalyticsEvidence"/>
    <rdfs:label xml:lang="en">derived from evidence</rdfs:label>
    <cc:sourceOntology rdf:resource="http://www.w3.org/ns/prov#"/>
    <cc:sourceIRI rdf:resource="http://www.w3.org/ns/prov#wasDerivedFrom"/>
    <cc:alignmentRelation>narrower</cc:alignmentRelation>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#wasGeneratedBySession">
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasGeneratedBy"/>
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#InteractionEvidence"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#LearningSession"/>
    <rdfs:label xml:lang="en">was generated by learning session</rdfs:label>
    <cc:sourceOntology rdf:resource="http://www.w3.org/ns/prov#"/>
    <cc:sourceIRI rdf:resource="http://www.w3.org/ns/prov#wasGeneratedBy"/>
    <cc:alignmentRelation>narrower</cc:alignmentRelation>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#concernsLearner">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#LearningAnalyticsEvidence"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#Learner"/>
    <rdfs:label xml:lang="en">concerns learner</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#concernsActivity">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#LearningAnalyticsEvidence"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#LearningActivity"/>
    <rdfs:label xml:lang="en">concerns activity</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#concernsActivityType">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#LearningAnalyticsEvidence"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#ActivityType"/>
    <rdfs:label xml:lang="en">concerns activity type</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#concernsModality">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#LearningAnalyticsEvidence"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#Modality"/>
    <rdfs:label xml:lang="en">concerns modality</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#concernsSkill">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#LearningAnalyticsEvidence"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#CurriculumSkill"/>
    <rdfs:label xml:lang="en">concerns skill</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#observedDuring">
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#EvidenceWindow"/>
    <rdfs:label xml:lang="en">observed during</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#hasEvidenceWindow">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#ObservedLearnerCharacteristic"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#EvidenceWindow"/>
    <rdfs:label xml:lang="en">has evidence window</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#supportsCharacteristic">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#LearningAnalyticsEvidence"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#ObservedLearnerCharacteristic"/>
    <rdfs:label xml:lang="en">supports characteristic</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#contradictsCharacteristic">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#LearningAnalyticsEvidence"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#ObservedLearnerCharacteristic"/>
    <rdfs:label xml:lang="en">contradicts characteristic</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#hasEvidenceAssessment">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#LearnerCharacteristic"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#EvidenceSufficiencyAssessment"/>
    <rdfs:label xml:lang="en">has evidence assessment</rdfs:label>
  </owl:ObjectProperty>

  <!-- Evidence metadata. Numeric values describe evidence; no classification
       threshold or inference rule is encoded in OWL. -->
  <owl:DatatypeProperty rdf:about="https://contacomigo.org/ontology#observationCount">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#EvidenceWindow"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
    <rdfs:label xml:lang="en">observation count</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://contacomigo.org/ontology#evidenceConfidence">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#LearnerKnowledge"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">evidence confidence</rdfs:label>
    <rdfs:comment xml:lang="en">A configurable reasoning-layer confidence value; OWL defines no cutoff or classification threshold.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://contacomigo.org/ontology#observedAt">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#LearningAnalyticsEvidence"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:label xml:lang="en">observed at</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://contacomigo.org/ontology#validFrom">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#LearnerKnowledge"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:label xml:lang="en">valid from</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://contacomigo.org/ontology#validUntil">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#LearnerKnowledge"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:label xml:lang="en">valid until</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://contacomigo.org/ontology#evidenceReason">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#EvidenceSufficiencyAssessment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">evidence reason</rdfs:label>
    <rdfs:comment xml:lang="en">A human-readable explanation such as sparse, stale, untested, absent, or conflicting evidence.</rdfs:comment>
  </owl:DatatypeProperty>

</rdf:RDF>
