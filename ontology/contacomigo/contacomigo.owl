  <!-- Concept prerequisites (v0.5.0). Only relations whose dependent concept is
       new in this version, so relations between the original 1º ano skills are
       unchanged. Each one quotes the BNCC text that supports it. -->
  <owl:NamedIndividual rdf:about="https://contacomigo.org/ontology#Prerequisite_AdditionToMultiplication">
    <rdf:type rdf:resource="https://contacomigo.org/ontology#PrerequisiteRelation"/>
    <cc:prerequisiteConcept rdf:resource="https://contacomigo.org/ontology#AdditionConcept"/>
    <cc:dependentConcept rdf:resource="https://contacomigo.org/ontology#MultiplicationConcept"/>
    <cc:mappingOrigin>ContaComigo semantic analysis of BNCC EF02MA07; EF03MA07</cc:mappingOrigin>
    <cc:relationReviewStatus>grounded_in_bncc_text</cc:relationReviewStatus>
    <rdfs:comment xml:lang="pt-BR">A BNCC apresenta a multiplicação "com a ideia de adição de parcelas iguais" (EF02MA07) e "com os significados de adição de parcelas iguais" (EF03MA07).</rdfs:comment>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://contacomigo.org/ontology#Prerequisite_MultiplicationToDivision">
    <rdf:type rdf:resource="https://contacomigo.org/ontology#PrerequisiteRelation"/>
    <cc:prerequisiteConcept rdf:resource="https://contacomigo.org/ontology#MultiplicationConcept"/>
    <cc:dependentConcept rdf:resource="https://contacomigo.org/ontology#DivisionConcept"/>
    <cc:mappingOrigin>ContaComigo semantic analysis of BNCC EF04MA04; EF04MA13</cc:mappingOrigin>
    <cc:relationReviewStatus>needs_professional_review</cc:relationReviewStatus>
    <rdfs:comment xml:lang="pt-BR">A BNCC pede "as relações inversas entre as operações [...] de multiplicação e de divisão" (EF04MA13). No 2º e 3º ano a divisão por repartição aparece junto com a multiplicação; por isso esta relação requer revisão profissional.</rdfs:comment>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://contacomigo.org/ontology#Prerequisite_DivisionToFraction">
    <rdf:type rdf:resource="https://contacomigo.org/ontology#PrerequisiteRelation"/>
    <cc:prerequisiteConcept rdf:resource="https://contacomigo.org/ontology#DivisionConcept"/>
    <cc:dependentConcept rdf:resource="https://contacomigo.org/ontology#FractionConcept"/>
    <cc:mappingOrigin>ContaComigo semantic analysis of BNCC EF03MA09; EF05MA03</cc:mappingOrigin>
    <cc:relationReviewStatus>grounded_in_bncc_text</cc:relationReviewStatus>
    <rdfs:comment xml:lang="pt-BR">A BNCC associa "o quociente de uma divisão [...] às ideias de metade, terça, quarta, quinta e décima partes" (EF03MA09) e frações "ao resultado de uma divisão" (EF05MA03).</rdfs:comment>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://contacomigo.org/ontology#Prerequisite_FractionToPercentage">
    <rdf:type rdf:resource="https://contacomigo.org/ontology#PrerequisiteRelation"/>
    <cc:prerequisiteConcept rdf:resource="https://contacomigo.org/ontology#FractionConcept"/>
    <cc:dependentConcept rdf:resource="https://contacomigo.org/ontology#PercentageConcept"/>
    <cc:mappingOrigin>ContaComigo semantic analysis of BNCC EF05MA06</cc:mappingOrigin>
    <cc:relationReviewStatus>grounded_in_bncc_text</cc:relationReviewStatus>
    <rdfs:comment xml:lang="pt-BR">A BNCC associa 10%, 25%, 50%, 75% e 100% "à décima parte, quarta parte, metade, três quartos e um inteiro" (EF05MA06).</rdfs:comment>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://contacomigo.org/ontology#Prerequisite_PlaceValueToDecimal">
    <rdf:type rdf:resource="https://contacomigo.org/ontology#PrerequisiteRelation"/>
    <cc:prerequisiteConcept rdf:resource="https://contacomigo.org/ontology#PlaceValueConcept"/>
    <cc:dependentConcept rdf:resource="https://contacomigo.org/ontology#DecimalNumberConcept"/>
    <cc:mappingOrigin>ContaComigo semantic analysis of BNCC EF04MA10</cc:mappingOrigin>
    <cc:relationReviewStatus>grounded_in_bncc_text</cc:relationReviewStatus>
    <rdfs:comment xml:lang="pt-BR">A BNCC pede reconhecer "que as regras do sistema de numeração decimal podem ser estendidas para a representação decimal" (EF04MA10).</rdfs:comment>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://contacomigo.org/ontology#Prerequisite_NumberToPlaceValue">
    <rdf:type rdf:resource="https://contacomigo.org/ontology#PrerequisiteRelation"/>
    <cc:prerequisiteConcept rdf:resource="https://contacomigo.org/ontology#NumberConcept"/>
    <cc:dependentConcept rdf:resource="https://contacomigo.org/ontology#PlaceValueConcept"/>
    <cc:mappingOrigin>ContaComigo semantic analysis of BNCC EF01MA07; EF02MA04</cc:mappingOrigin>
    <cc:relationReviewStatus>grounded_in_bncc_text</cc:relationReviewStatus>
    <rdfs:comment xml:lang="pt-BR">A BNCC usa compor e decompor números "contribuindo para a compreensão de características do sistema de numeração decimal" (EF01MA07), ampliando para três ordens no 2º ano (EF02MA04).</rdfs:comment>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://contacomigo.org/ontology#Prerequisite_MeasurementToAreaPerimeter">
    <rdf:type rdf:resource="https://contacomigo.org/ontology#PrerequisiteRelation"/>
    <cc:prerequisiteConcept rdf:resource="https://contacomigo.org/ontology#MeasurementConcept"/>
    <cc:dependentConcept rdf:resource="https://contacomigo.org/ontology#AreaPerimeterConcept"/>
    <cc:mappingOrigin>ContaComigo semantic analysis of BNCC EF04MA20; EF04MA21</cc:mappingOrigin>
    <cc:relationReviewStatus>grounded_in_bncc_text</cc:relationReviewStatus>
    <rdfs:comment xml:lang="pt-BR">A BNCC trata perímetro como medida de comprimento (EF04MA20) antes de comparar áreas em malha (EF04MA21).</rdfs:comment>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://contacomigo.org/ontology#Prerequisite_AdditionToEquality">
    <rdf:type rdf:resource="https://contacomigo.org/ontology#PrerequisiteRelation"/>
    <cc:prerequisiteConcept rdf:resource="https://contacomigo.org/ontology#AdditionConcept"/>
    <cc:dependentConcept rdf:resource="https://contacomigo.org/ontology#EqualityConcept"/>
    <cc:mappingOrigin>ContaComigo semantic analysis of BNCC EF03MA11</cc:mappingOrigin>
    <cc:relationReviewStatus>grounded_in_bncc_text</cc:relationReviewStatus>
    <rdfs:comment xml:lang="pt-BR">A BNCC constrói a ideia de igualdade com "diferentes sentenças de adições ou de subtrações [...] que resultem na mesma soma ou diferença" (EF03MA11).</rdfs:comment>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://contacomigo.org/ontology#Prerequisite_MultiplicationToCombinatorics">
    <rdf:type rdf:resource="https://contacomigo.org/ontology#PrerequisiteRelation"/>
    <cc:prerequisiteConcept rdf:resource="https://contacomigo.org/ontology#MultiplicationConcept"/>
    <cc:dependentConcept rdf:resource="https://contacomigo.org/ontology#CombinatoricsConcept"/>
    <cc:mappingOrigin>ContaComigo semantic analysis of BNCC EF04MA08; EF05MA09</cc:mappingOrigin>
    <cc:relationReviewStatus>grounded_in_bncc_text</cc:relationReviewStatus>
    <rdfs:comment xml:lang="pt-BR">A BNCC trata a contagem de agrupamentos pelo "princípio multiplicativo" (EF05MA09), combinando cada elemento de uma coleção com todos os de outra (EF04MA08).</rdfs:comment>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://contacomigo.org/ontology#Prerequisite_MultiplicationToProportionality">
    <rdf:type rdf:resource="https://contacomigo.org/ontology#PrerequisiteRelation"/>
    <cc:prerequisiteConcept rdf:resource="https://contacomigo.org/ontology#MultiplicationConcept"/>
    <cc:dependentConcept rdf:resource="https://contacomigo.org/ontology#ProportionalityConcept"/>
    <cc:mappingOrigin>ContaComigo semantic analysis of BNCC EF04MA06; EF05MA12</cc:mappingOrigin>
    <cc:relationReviewStatus>grounded_in_bncc_text</cc:relationReviewStatus>
    <rdfs:comment xml:lang="pt-BR">A BNCC lista a proporcionalidade entre os "significados da multiplicação" (EF04MA06) antes dos problemas de proporcionalidade direta (EF05MA12).</rdfs:comment>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://contacomigo.org/ontology#Prerequisite_BasicGeometryToPolygon">
    <rdf:type rdf:resource="https://contacomigo.org/ontology#PrerequisiteRelation"/>
    <cc:prerequisiteConcept rdf:resource="https://contacomigo.org/ontology#BasicGeometryConcept"/>
    <cc:dependentConcept rdf:resource="https://contacomigo.org/ontology#PolygonConcept"/>
    <cc:mappingOrigin>ContaComigo semantic analysis of BNCC EF01MA14; EF02MA15; EF03MA15</cc:mappingOrigin>
    <cc:relationReviewStatus>grounded_in_bncc_text</cc:relationReviewStatus>
    <rdfs:comment xml:lang="pt-BR">A BNCC progride de identificar figuras planas (EF01MA14) e reconhecer características comuns (EF02MA15) para classificá-las por lados e vértices (EF03MA15).</rdfs:comment>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:NamedIndividual>
