  <owl:NamedIndividual rdf:about="https://contacomigo.org/ontology#OptionSelectionInteraction"><rdf:type rdf:resource="https://contacomigo.org/ontology#InteractionType"/><rdfs:label xml:lang="en">Option selection</rdfs:label></owl:NamedIndividual>
