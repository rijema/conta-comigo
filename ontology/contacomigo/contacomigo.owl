    <rdfs:label xml:lang="pt-BR">EF05MA11</rdfs:label>
    <cc:hasCurriculumCode>EF05MA11</cc:hasCurriculumCode>
    <cc:hasOfficialDescription xml:lang="pt-BR">Resolver e elaborar problemas cuja conversão em sentença matemática seja uma igualdade com uma operação em que um dos termos é desconhecido.</cc:hasOfficialDescription>
