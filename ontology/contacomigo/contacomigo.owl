    <rdfs:label xml:lang="en">Drag-and-drop activity family</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Família de atividades de arrastar e soltar</rdfs:label>
    <rdf:type rdf:resource="https://contacomigo.org/ontology#ActivityFamilyProfile"/><cc:hasActivityType rdf:resource="https://contacomigo.org/ontology#DragAndDropActivityType"/><cc:hasRepresentation rdf:resource="https://contacomigo.org/ontology#PictorialRepresentation"/><cc:hasRepresentation rdf:resource="https://contacomigo.org/ontology#SymbolicRepresentation"/><cc:hasInteractionType rdf:resource="https://contacomigo.org/ontology#DragAndDropInteraction"/><cc:hasInteractionType rdf:resource="https://contacomigo.org/ontology#AlternativePlacementInteraction"/><cc:hasDifficultyProfile rdf:resource="https://contacomigo.org/ontology#DragAndDropFamilyDifficulty"/><cc:hasActivityAffordance rdf:resource="https://contacomigo.org/ontology#DraggingAffordance"/><cc:hasActivityAffordance rdf:resource="https://contacomigo.org/ontology#KeyboardAlternativeAffordance"/><cc:hasActivityAffordance rdf:resource="https://contacomigo.org/ontology#PointerSelectionAffordance"/><cc:hasActivityAffordance rdf:resource="https://contacomigo.org/ontology#PictogramAffordance"/><cc:addressesBNCCSkill rdf:resource="https://contacomigo.org/ontology#BNCC_EF01MA01"/><cc:addressesBNCCSkill rdf:resource="https://contacomigo.org/ontology#BNCC_EF01MA03"/><cc:addressesBNCCSkill rdf:resource="https://contacomigo.org/ontology#BNCC_EF01MA06"/><cc:developsMathematicalConcept rdf:resource="https://contacomigo.org/ontology#NumberConcept"/><cc:developsMathematicalConcept rdf:resource="https://contacomigo.org/ontology#ComparisonConcept"/><cc:developsMathematicalConcept rdf:resource="https://contacomigo.org/ontology#AdditionConcept"/><cc:developsMathematicalConcept rdf:resource="https://contacomigo.org/ontology#SequencePatternConcept"/><cc:requiresDragging rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</cc:requiresDragging><cc:usesAudio rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</cc:usesAudio><cc:usesPictograms rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</cc:usesPictograms><cc:activityMappingStatus>NEEDS_REVIEW</cc:activityMappingStatus><rdfs:comment xml:lang="en">Dragging is available, but the inspected component also supports tap selection and keyboard placement; dragging is therefore not strictly required.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://contacomigo.org/ontology#NumberLineActivityFamily">
    <rdfs:label xml:lang="en">Number-line activity family</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Família de atividades de reta numérica</rdfs:label>
    <rdf:type rdf:resource="https://contacomigo.org/ontology#ActivityFamilyProfile"/><cc:hasActivityType rdf:resource="https://contacomigo.org/ontology#NumberLineActivityType"/><cc:hasRepresentation rdf:resource="https://contacomigo.org/ontology#NumberLineRepresentation"/><cc:hasRepresentation rdf:resource="https://contacomigo.org/ontology#SymbolicRepresentation"/><cc:hasInteractionType rdf:resource="https://contacomigo.org/ontology#RangeSelectionInteraction"/><cc:hasDifficultyProfile rdf:resource="https://contacomigo.org/ontology#NumberLineFamilyDifficulty"/><cc:hasActivityAffordance rdf:resource="https://contacomigo.org/ontology#KeyboardAlternativeAffordance"/><cc:hasActivityAffordance rdf:resource="https://contacomigo.org/ontology#PointerSelectionAffordance"/><cc:developsMathematicalConcept rdf:resource="https://contacomigo.org/ontology#NumberConcept"/><cc:developsMathematicalConcept rdf:resource="https://contacomigo.org/ontology#ComparisonConcept"/><cc:requiresDragging rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</cc:requiresDragging><cc:usesAudio rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</cc:usesAudio><cc:usesPictograms rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</cc:usesPictograms><cc:activityMappingStatus>INCOMPLETE</cc:activityMappingStatus><rdfs:comment xml:lang="en">Frontend-only family with no backend enum, seed instance, or current BNCC mapping.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://contacomigo.org/ontology#VisualPuzzleActivityFamily">
    <rdfs:label xml:lang="en">Visual puzzle activity family</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Família de atividades de quebra-cabeça visual</rdfs:label>
    <rdf:type rdf:resource="https://contacomigo.org/ontology#ActivityFamilyProfile"/><cc:hasActivityType rdf:resource="https://contacomigo.org/ontology#VisualPuzzleActivityType"/><cc:activityMappingStatus>INCOMPLETE</cc:activityMappingStatus><rdfs:comment xml:lang="en">Backend enum value without a dedicated current renderer or seed instance; no representation, interaction, curriculum, or concept metadata is assigned.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://contacomigo.org/ontology#VideoQuestionActivityFamily">
    <rdfs:label xml:lang="en">Video question activity family</rdfs:label>
