  <owl:NamedIndividual rdf:about="https://contacomigo.org/ontology#BNCC_EF01MA07">
    <rdf:type rdf:resource="https://contacomigo.org/ontology#BNCCSkill"/>
    <rdfs:label xml:lang="pt-BR">EF01MA07</rdfs:label>
    <cc:hasCurriculumCode>EF01MA07</cc:hasCurriculumCode>
    <cc:hasOfficialDescription xml:lang="pt-BR">Compor e decompor número de até duas ordens, por meio de diferentes adições, com o suporte de material manipulável, contribuindo para a compreensão de características do sistema de numeração decimal e o desenvolvimento de estratégias de cálculo.</cc:hasOfficialDescription>
    <cc:belongsToCurriculum rdf:resource="https://contacomigo.org/ontology#BrazilianNationalCommonCoreCurriculum"/>
    <cc:belongsToGrade rdf:resource="https://contacomigo.org/ontology#BNCCElementaryYear1"/>
    <cc:belongsToCurriculumDomain rdf:resource="https://contacomigo.org/ontology#BNCCNumbersDomain"/>
    <cc:addressesMathematicalConcept rdf:resource="https://contacomigo.org/ontology#NumberConcept"/>
    <cc:addressesMathematicalConcept rdf:resource="https://contacomigo.org/ontology#AdditionConcept"/>
    <cc:conceptMappingStatus>mapped</cc:conceptMappingStatus>
    <cc:currentActivityCoverageStatus>NEEDS_REVIEW</cc:currentActivityCoverageStatus>
    <cc:currentActivityCount rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">3</cc:currentActivityCount>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://contacomigo.org/ontology#BNCC_EF01MA08">
    <rdf:type rdf:resource="https://contacomigo.org/ontology#BNCCSkill"/>
    <rdfs:label xml:lang="pt-BR">EF01MA08</rdfs:label>
    <cc:hasCurriculumCode>EF01MA08</cc:hasCurriculumCode>
    <cc:hasOfficialDescription xml:lang="pt-BR">Resolver e elaborar problemas de adição e de subtração, envolvendo números de até dois algarismos, com os significados de juntar, acrescentar, separar e retirar, com o suporte de imagens e/ou material manipulável, utilizando estratégias e formas de registro pessoais.</cc:hasOfficialDescription>
    <cc:belongsToCurriculum rdf:resource="https://contacomigo.org/ontology#BrazilianNationalCommonCoreCurriculum"/>
    <cc:belongsToGrade rdf:resource="https://contacomigo.org/ontology#BNCCElementaryYear1"/>
    <cc:belongsToCurriculumDomain rdf:resource="https://contacomigo.org/ontology#BNCCNumbersDomain"/>
    <cc:addressesMathematicalConcept rdf:resource="https://contacomigo.org/ontology#AdditionConcept"/>
    <cc:addressesMathematicalConcept rdf:resource="https://contacomigo.org/ontology#SubtractionConcept"/>
    <cc:addressesMathematicalConcept rdf:resource="https://contacomigo.org/ontology#EarlyProblemSolvingConcept"/>
    <cc:conceptMappingStatus>mapped</cc:conceptMappingStatus>
    <cc:currentActivityCoverageStatus>PARTIALLY_COVERED</cc:currentActivityCoverageStatus>
    <cc:currentActivityCount rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</cc:currentActivityCount>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://contacomigo.org/ontology#BNCC_EF01MA14">
    <rdf:type rdf:resource="https://contacomigo.org/ontology#BNCCSkill"/>
    <rdfs:label xml:lang="pt-BR">EF01MA14</rdfs:label>
    <cc:hasCurriculumCode>EF01MA14</cc:hasCurriculumCode>
    <cc:hasOfficialDescription xml:lang="pt-BR">Identificar e nomear figuras planas (círculo, quadrado, retângulo e triângulo) em desenhos apresentados em diferentes disposições ou em contornos de faces de sólidos geométricos.</cc:hasOfficialDescription>
    <cc:belongsToCurriculum rdf:resource="https://contacomigo.org/ontology#BrazilianNationalCommonCoreCurriculum"/>
    <cc:belongsToGrade rdf:resource="https://contacomigo.org/ontology#BNCCElementaryYear1"/>
    <cc:belongsToCurriculumDomain rdf:resource="https://contacomigo.org/ontology#BNCCGeometryDomain"/>
    <cc:addressesMathematicalConcept rdf:resource="https://contacomigo.org/ontology#BasicGeometryConcept"/>
    <cc:addressesMathematicalConcept rdf:resource="https://contacomigo.org/ontology#SquareConcept"/>
    <cc:addressesMathematicalConcept rdf:resource="https://contacomigo.org/ontology#RectangleConcept"/>
    <cc:conceptMappingStatus>partial</cc:conceptMappingStatus>
    <cc:currentActivityCoverageStatus>PARTIALLY_COVERED</cc:currentActivityCoverageStatus>
    <cc:currentActivityCount rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</cc:currentActivityCount>
    <rdfs:comment xml:lang="en">Circle and triangle concepts are not yet represented in the ContaComigo mathematical layer; the mapping is therefore partial.</rdfs:comment>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:NamedIndividual>

