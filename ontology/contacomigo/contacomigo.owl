  <!-- BNCC curriculum layer. Official skill descriptions are preserved as
       literals; mathematical mappings are local semantic analyses. -->
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#belongsToCurriculum">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#CurriculumSkill"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#Curriculum"/>
    <rdfs:label xml:lang="en">belongs to curriculum</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#belongsToGrade">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#CurriculumSkill"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#CurriculumLevel"/>
    <rdfs:label xml:lang="en">belongs to grade</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#belongsToCurriculumDomain">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#CurriculumSkill"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#CurriculumDomain"/>
    <rdfs:label xml:lang="en">belongs to curriculum domain</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#addressesCurriculumSkill">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#Activity"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#CurriculumSkill"/>
    <owl:inverseOf rdf:resource="https://contacomigo.org/ontology#isAddressedByActivity"/>
    <rdfs:label xml:lang="en">addresses curriculum skill</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://contacomigo.org/ontology#isAddressedByActivity">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#CurriculumSkill"/>
    <rdfs:range rdf:resource="https://contacomigo.org/ontology#LearningActivity"/>
    <rdfs:label xml:lang="en">is addressed by activity</rdfs:label>
  </owl:ObjectProperty>

  <owl:DatatypeProperty rdf:about="https://contacomigo.org/ontology#hasCurriculumCode">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#CurriculumSkill"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">has curriculum code</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://contacomigo.org/ontology#hasOfficialDescription">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#CurriculumSkill"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:label xml:lang="en">has official description</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://contacomigo.org/ontology#conceptMappingStatus">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#CurriculumSkill"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">concept mapping status</rdfs:label>
    <rdfs:comment xml:lang="en">Allowed values in this version: mapped, partial, and pending_review.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://contacomigo.org/ontology#currentActivityCoverageStatus">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#CurriculumSkill"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">current activity coverage status</rdfs:label>
    <rdfs:comment xml:lang="en">Snapshot classification: COVERED, PARTIALLY_COVERED, NOT_COVERED, or NEEDS_REVIEW.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://contacomigo.org/ontology#currentActivityCount">
    <rdfs:domain rdf:resource="https://contacomigo.org/ontology#CurriculumSkill"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
    <rdfs:label xml:lang="en">current activity count</rdfs:label>
    <rdfs:comment xml:lang="en">Number of seed activities currently claiming the skill code; this is coverage metadata, not evidence of pedagogical alignment.</rdfs:comment>
  </owl:DatatypeProperty>

