ictograms><cc:activityMappingStatus>NEEDS_REVIEW</cc:activityMappingStatus><rdfs:comment xml:lang="en">Dragging is available, but the inspected component also supports tap selection and keyboard placement; dragging is therefore not strictly required.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://contacomigo.org/ontology#NumberLineActivityFamily">
