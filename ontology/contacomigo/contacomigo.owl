    <rdfs:label xml:lang="pt-BR">EF05MA23</rdfs:label>
    <cc:hasCurriculumCode>EF05MA23</cc:hasCurriculumCode>
    <cc:hasOfficialDescription xml:lang="pt-BR">Determinar a probabilidade de ocorrência de um resultado em eventos aleatórios, quando todos os resultados possíveis têm a mesma chance de ocorrer (equiprováveis).</cc:hasOfficialDescription>
    <cc:hasKnowledgeObject xml:lang="pt-BR">Cálculo de probabilidade de eventos equiprováveis</cc:hasKnowledgeObject>
    <cc:belongsToCurriculum rdf:resource="https://contacomigo.org/ontology#BrazilianNationalCommonCoreCurriculum"/>
    <cc:belongsToGrade rdf:resource="https://contacomigo.org/ontology#BNCCElementaryYear5"/>
    <cc:belongsToCurriculumDomain rdf:resource="https://contacomigo.org/ontology#BNCCStatisticsDomain"/>
    <cc:addressesMathematicalConcept rdf:resource="https://contacomigo.org/ontology#ProbabilityConcept"/>
    <cc:conceptMappingStatus>partial</cc:conceptMappingStatus>
    <cc:currentActivityCoverageStatus>NOT_COVERED</cc:currentActivityCoverageStatus>
    <cc:currentActivityCount rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</cc:currentActivityCount>
    <rdfs:comment xml:lang="pt-BR">Mapeamento habilidade-conceito proposto pelo ContaComigo (v0.6.0) a partir do texto oficial; aguarda revisão profissional.</rdfs:comment>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://contacomigo.org/ontology#BNCC_EF05MA24">
    <rdf:type rdf:resource="https://contacomigo.org/ontology#BNCCSkill"/>
    <rdfs:label xml:lang="pt-BR">EF05MA24</rdfs:label>
    <cc:hasCurriculumCode>EF05MA24</cc:hasCurriculumCode>
    <cc:hasOfficialDescription xml:lang="pt-BR">Interpretar dados estatísticos apresentados em textos, tabelas e gráficos (colunas ou linhas), referentes a outras áreas do conhecimento ou a outros contextos, como saúde e trânsito, e produzir textos com o objetivo de sintetizar conclusões.</cc:hasOfficialDescription>
    <cc:hasKnowledgeObject xml:lang="pt-BR">Leitura, coleta, classificação interpretação e representação de dados em tabelas de dupla entrada, gráfico de colunas agrupadas, gráficos pictóricos e gráfico de linhas</cc:hasKnowledgeObject>
    <cc:belongsToCurriculum rdf:resource="https://contacomigo.org/ontology#BrazilianNationalCommonCoreCurriculum"/>
    <cc:belongsToGrade rdf:resource="https://contacomigo.org/ontology#BNCCElementaryYear5"/>
    <cc:belongsToCurriculumDomain rdf:resource="https://contacomigo.org/ontology#BNCCStatisticsDomain"/>
    <cc:addressesMathematicalConcept rdf:resource="https://contacomigo.org/ontology#DataInterpretationConcept"/>
    <cc:conceptMappingStatus>partial</cc:conceptMappingStatus>
    <cc:currentActivityCoverageStatus>PARTIALLY_COVERED</cc:currentActivityCoverageStatus>
    <cc:currentActivityCount rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</cc:currentActivityCount>
    <rdfs:comment xml:lang="pt-BR">Mapeamento habilidade-conceito proposto pelo ContaComigo (v0.5.0) a partir do texto oficial; aguarda revisão profissional.</rdfs:comment>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://contacomigo.org/ontology#BNCC_EF05MA25">
    <rdf:type rdf:resource="https://contacomigo.org/ontology#BNCCSkill"/>
    <rdfs:label xml:lang="pt-BR">EF05MA25</rdfs:label>
    <cc:hasCurriculumCode>EF05MA25</cc:hasCurriculumCode>
    <cc:hasOfficialDescription xml:lang="pt-BR">Realizar pesquisa envolvendo variáveis categóricas e numéricas, organizar dados coletados por meio de tabelas, gráficos de colunas, pictóricos e de linhas, com e sem uso de tecnologias digitais, e apresentar texto escrito sobre a finalidade da pesquisa e a síntese dos resultados.</cc:hasOfficialDescription>
    <cc:hasKnowledgeObject xml:lang="pt-BR">Leitura, coleta, classificação interpretação e representação de dados em tabelas de dupla entrada, gráfico de colunas agrupadas, gráficos pictóricos e gráfico de linhas</cc:hasKnowledgeObject>
    <cc:belongsToCurriculum rdf:resource="https://contacomigo.org/ontology#BrazilianNationalCommonCoreCurriculum"/>
    <cc:belongsToGrade rdf:resource="https://contacomigo.org/ontology#BNCCElementaryYear5"/>
    <cc:belongsToCurriculumDomain rdf:resource="https://contacomigo.org/ontology#BNCCStatisticsDomain"/>
    <cc:addressesMathematicalConcept rdf:resource="https://contacomigo.org/ontology#DataInterpretationConcept"/>
    <cc:conceptMappingStatus>partial</cc:conceptMappingStatus>
    <cc:currentActivityCoverageStatus>NOT_COVERED</cc:currentActivityCoverageStatus>
    <cc:currentActivityCount rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</cc:currentActivityCount>
    <rdfs:comment xml:lang="pt-BR">Mapeamento habilidade-conceito proposto pelo ContaComigo (v0.6.0) a partir do texto oficial; aguarda revisão profissional.</rdfs:comment>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:NamedIndividual>

  <!-- Each curriculum-to-mathematics assertion is a ContaComigo semantic
       analysis grounded in, but not directly asserted by, the official BNCC. -->
  <owl:Axiom><owl:annotatedSource rdf:resource="https://contacomigo.org/ontology#BNCC_EF01MA01"/><owl:annotatedProperty rdf:resource="https://contacomigo.org/ontology#addressesMathematicalConcept"/><owl:annotatedTarget rdf:resource="https://contacomigo.org/ontology#NumberConcept"/><cc:mappingOrigin>ContaComigo semantic analysis</cc:mappingOrigin></owl:Axiom>
  <owl:Axiom><owl:annotatedSource rdf:resource="https://contacomigo.org/ontology#BNCC_EF01MA03"/><owl:annotatedProperty rdf:resource="https://contacomigo.org/ontology#addressesMathematicalConcept"/><owl:annotatedTarget rdf:resource="https://contacomigo.org/ontology#CountingConcept"/><cc:mappingOrigin>ContaComigo semantic analysis</cc:mappingOrigin></owl:Axiom>
  <owl:Axiom><owl:annotatedSource rdf:resource="https://contacomigo.org/ontology#BNCC_EF01MA03"/><owl:annotatedProperty rdf:resource="https://contacomigo.org/ontology#addressesMathematicalConcept"/><owl:annotatedTarget rdf:resource="https://contacomigo.org/ontology#ComparisonConcept"/><cc:mappingOrigin>ContaComigo semantic analysis</cc:mappingOrigin></owl:Axiom>
  <owl:Axiom><owl:annotatedSource rdf:resource="https://contacomigo.org/ontology#BNCC_EF01MA06"/><owl:annotatedProperty rdf:resource="https://contacomigo.org/ontology#addressesMathematicalConcept"/><owl:annotatedTarget rdf:resource="https://contacomigo.org/ontology#AdditionConcept"/><cc:mappingOrigin>ContaComigo semantic analysis</cc:mappingOrigin></owl:Axiom>
  <owl:Axiom><owl:annotatedSource rdf:resource="https://contacomigo.org/ontology#BNCC_EF01MA06"/><owl:annotatedProperty rdf:resource="https://contacomigo.org/ontology#addressesMathematicalConcept"/><owl:annotatedTarget rdf:resource="https://contacomigo.org/ontology#EarlyProblemSolvingConcept"/><cc:mappingOrigin>ContaComigo semantic analysis</cc:mappingOrigin></owl:Axiom>
  <owl:Axiom><owl:annotatedSource rdf:resource="https://contacomigo.org/ontology#BNCC_EF01MA07"/><owl:annotatedProperty rdf:resource="https://contacomigo.org/ontology#addressesMathematicalConcept"/><owl:annotatedTarget rdf:resource="https://contacomigo.org/ontology#NumberConcept"/><cc:mappingOrigin>ContaComigo semantic analysis</cc:mappingOrigin></owl:Axiom>
  <owl:Axiom><owl:annotatedSource rdf:resource="https://contacomigo.org/ontology#BNCC_EF01MA07"/><owl:annotatedProperty rdf:resource="https://contacomigo.org/ontology#addressesMathematicalConcept"/><owl:annotatedTarget rdf:resource="https://contacomigo.org/ontology#AdditionConcept"/><cc:mappingOrigin>ContaComigo semantic analysis</cc:mappingOrigin></owl:Axiom>
  <owl:Axiom><owl:annotatedSource rdf:resource="https://contacomigo.org/ontology#BNCC_EF01MA08"/><owl:annotatedProperty rdf:resource="https://contacomigo.org/ontology#addressesMathematicalConcept"/><owl:annotatedTarget rdf:resource="https://contacomigo.org/ontology#AdditionConcept"/><cc:mappingOrigin>ContaComigo semantic analysis</cc:mappingOrigin></owl:Axiom>
  <owl:Axiom><owl:annotatedSource rdf:resource="https://contacomigo.org/ontology#BNCC_EF01MA08"/><owl:annotatedProperty rdf:resource="https://contacomigo.org/ontology#addressesMathematicalConcept"/><owl:annotatedTarget rdf:resource="https://contacomigo.org/ontology#SubtractionConcept"/><cc:mappingOrigin>ContaComigo semantic analysis</cc:mappingOrigin></owl:Axiom>
  <owl:Axiom><owl:annotatedSource rdf:resource="https://contacomigo.org/ontology#BNCC_EF01MA08"/><owl:annotatedProperty rdf:resource="https://contacomigo.org/ontology#addressesMathematicalConcept"/><owl:annotatedTarget rdf:resource="https://contacomigo.org/ontology#EarlyProblemSolvingConcept"/><cc:mappingOrigin>ContaComigo semantic analysis</cc:mappingOrigin></owl:Axiom>
  <owl:Axiom><owl:annotatedSource rdf:resource="https://contacomigo.org/ontology#BNCC_EF01MA14"/><owl:annotatedProperty rdf:resource="https://contacomigo.org/ontology#addressesMathematicalConcept"/><owl:annotatedTarget rdf:resource="https://contacomigo.org/ontology#BasicGeometryConcept"/><cc:mappingOrigin>ContaComigo semantic analysis</cc:mappingOrigin></owl:Axiom>
  <owl:Axiom><owl:annotatedSource rdf:resource="https://contacomigo.org/ontology#BNCC_EF01MA14"/><owl:annotatedProperty rdf:resource="https://contacomigo.org/ontology#addressesMathematicalConcept"/><owl:annotatedTarget rdf:resource="https://contacomigo.org/ontology#SquareConcept"/><cc:mappingOrigin>ContaComigo semantic analysis</cc:mappingOrigin></owl:Axiom>
  <owl:Axiom><owl:annotatedSource rdf:resource="https://contacomigo.org/ontology#BNCC_EF01MA14"/><owl:annotatedProperty rdf:resource="https://contacomigo.org/ontology#addressesMathematicalConcept"/><owl:annotatedTarget rdf:resource="https://contacomigo.org/ontology#RectangleConcept"/><cc:mappingOrigin>ContaComigo semantic analysis</cc:mappingOrigin></owl:Axiom>

  <!-- Concept prerequisites (v0.5.0). Only relations whose dependent concept is
       new in this version, so relations between the original 1º ano skills are
       unchanged. Each one quotes the BNCC text that supports it. -->
  <owl:NamedIndividual rdf:about="https://contacomigo.org/ontology#Prerequisite_AdditionToMultiplication">
    <rdfs:label xml:lang="en">addition → multiplication prerequisite</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Pré-requisito: adição → multiplicação</rdfs:label>
    <rdf:type rdf:resource="https://contacomigo.org/ontology#PrerequisiteRelation"/>
    <cc:prerequisiteConcept rdf:resource="https://contacomigo.org/ontology#AdditionConcept"/>
    <cc:dependentConcept rdf:resource="https://contacomigo.org/ontology#MultiplicationConcept"/>
    <cc:mappingOrigin>ContaComigo semantic analysis of BNCC EF02MA07; EF03MA07</cc:mappingOrigin>
    <cc:relationReviewStatus>grounded_in_bncc_text</cc:relationReviewStatus>
    <rdfs:comment xml:lang="pt-BR">A BNCC apresenta a multiplicação "com a ideia de adição de parcelas iguais" (EF02MA07) e "com os significados de adição de parcelas iguais" (EF03MA07).</rdfs:comment>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://contacomigo.org/ontology#Prerequisite_MultiplicationToDivision">
    <rdfs:label xml:lang="en">multiplication → division prerequisite</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Pré-requisito: multiplicação → divisão</rdfs:label>
    <rdf:type rdf:resource="https://contacomigo.org/ontology#PrerequisiteRelation"/>
    <cc:prerequisiteConcept rdf:resource="https://contacomigo.org/ontology#MultiplicationConcept"/>
    <cc:dependentConcept rdf:resource="https://contacomigo.org/ontology#DivisionConcept"/>
    <cc:mappingOrigin>ContaComigo semantic analysis of BNCC EF04MA04; EF04MA13</cc:mappingOrigin>
    <cc:relationReviewStatus>needs_professional_review</cc:relationReviewStatus>
    <rdfs:comment xml:lang="pt-BR">A BNCC pede "as relações inversas entre as operações [...] de multiplicação e de divisão" (EF04MA13). No 2º e 3º ano a divisão por repartição aparece junto com a multiplicação; por isso esta relação requer revisão profissional.</rdfs:comment>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://contacomigo.org/ontology#Prerequisite_DivisionToFraction">
    <rdfs:label xml:lang="en">division → fraction prerequisite</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Pré-requisito: divisão → fração</rdfs:label>
    <rdf:type rdf:resource="https://contacomigo.org/ontology#PrerequisiteRelation"/>
    <cc:prerequisiteConcept rdf:resource="https://contacomigo.org/ontology#DivisionConcept"/>
    <cc:dependentConcept rdf:resource="https://contacomigo.org/ontology#FractionConcept"/>
    <cc:mappingOrigin>ContaComigo semantic analysis of BNCC EF03MA09; EF05MA03</cc:mappingOrigin>
    <cc:relationReviewStatus>grounded_in_bncc_text</cc:relationReviewStatus>
    <rdfs:comment xml:lang="pt-BR">A BNCC associa "o quociente de uma divisão [...] às ideias de metade, terça, quarta, quinta e décima partes" (EF03MA09) e frações "ao resultado de uma divisão" (EF05MA03).</rdfs:comment>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://contacomigo.org/ontology#Prerequisite_FractionToPercentage">
    <rdfs:label xml:lang="en">fraction → percentage prerequisite</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Pré-requisito: fração → porcentagem</rdfs:label>
    <rdf:type rdf:resource="https://contacomigo.org/ontology#PrerequisiteRelation"/>
    <cc:prerequisiteConcept rdf:resource="https://contacomigo.org/ontology#FractionConcept"/>
    <cc:dependentConcept rdf:resource="https://contacomigo.org/ontology#PercentageConcept"/>
    <cc:mappingOrigin>ContaComigo semantic analysis of BNCC EF05MA06</cc:mappingOrigin>
    <cc:relationReviewStatus>grounded_in_bncc_text</cc:relationReviewStatus>
    <rdfs:comment xml:lang="pt-BR">A BNCC associa 10%, 25%, 50%, 75% e 100% "à décima parte, quarta parte, metade, três quartos e um inteiro" (EF05MA06).</rdfs:comment>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://contacomigo.org/ontology#Prerequisite_PlaceValueToDecimal">
    <rdfs:label xml:lang="en">place value → decimal prerequisite</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Pré-requisito: valor posicional → número decimal</rdfs:label>
    <rdf:type rdf:resource="https://contacomigo.org/ontology#PrerequisiteRelation"/>
    <cc:prerequisiteConcept rdf:resource="https://contacomigo.org/ontology#PlaceValueConcept"/>
    <cc:dependentConcept rdf:resource="https://contacomigo.org/ontology#DecimalNumberConcept"/>
    <cc:mappingOrigin>ContaComigo semantic analysis of BNCC EF04MA10</cc:mappingOrigin>
    <cc:relationReviewStatus>grounded_in_bncc_text</cc:relationReviewStatus>
    <rdfs:comment xml:lang="pt-BR">A BNCC pede reconhecer "que as regras do sistema de numeração decimal podem ser estendidas para a representação decimal" (EF04MA10).</rdfs:comment>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://contacomigo.org/ontology#Prerequisite_NumberToPlaceValue">
    <rdfs:label xml:lang="en">number → place value prerequisite</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Pré-requisito: número → valor posicional</rdfs:label>
    <rdf:type rdf:resource="https://contacomigo.org/ontology#PrerequisiteRelation"/>
    <cc:prerequisiteConcept rdf:resource="https://contacomigo.org/ontology#NumberConcept"/>
    <cc:dependentConcept rdf:resource="https://contacomigo.org/ontology#PlaceValueConcept"/>
    <cc:mappingOrigin>ContaComigo semantic analysis of BNCC EF01MA07; EF02MA04</cc:mappingOrigin>
    <cc:relationReviewStatus>grounded_in_bncc_text</cc:relationReviewStatus>
    <rdfs:comment xml:lang="pt-BR">A BNCC usa compor e decompor números "contribuindo para a compreensão de características do sistema de numeração decimal" (EF01MA07), ampliando para três ordens no 2º ano (EF02MA04).</rdfs:comment>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://contacomigo.org/ontology#Prerequisite_MeasurementToAreaPerimeter">
    <rdfs:label xml:lang="en">measurement → area perimeter prerequisite</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Pré-requisito: grandezas e medidas → área e perímetro</rdfs:label>
    <rdf:type rdf:resource="https://contacomigo.org/ontology#PrerequisiteRelation"/>
    <cc:prerequisiteConcept rdf:resource="https://contacomigo.org/ontology#MeasurementConcept"/>
    <cc:dependentConcept rdf:resource="https://contacomigo.org/ontology#AreaPerimeterConcept"/>
    <cc:mappingOrigin>ContaComigo semantic analysis of BNCC EF04MA20; EF04MA21</cc:mappingOrigin>
    <cc:relationReviewStatus>grounded_in_bncc_text</cc:relationReviewStatus>
    <rdfs:comment xml:lang="pt-BR">A BNCC trata perímetro como medida de comprimento (EF04MA20) antes de comparar áreas em malha (EF04MA21).</rdfs:comment>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://contacomigo.org/ontology#Prerequisite_AdditionToEquality">
    <rdfs:label xml:lang="en">addition → equality prerequisite</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Pré-requisito: adição → igualdade</rdfs:label>
    <rdf:type rdf:resource="https://contacomigo.org/ontology#PrerequisiteRelation"/>
    <cc:prerequisiteConcept rdf:resource="https://contacomigo.org/ontology#AdditionConcept"/>
    <cc:dependentConcept rdf:resource="https://contacomigo.org/ontology#EqualityConcept"/>
    <cc:mappingOrigin>ContaComigo semantic analysis of BNCC EF03MA11</cc:mappingOrigin>
    <cc:relationReviewStatus>grounded_in_bncc_text</cc:relationReviewStatus>
    <rdfs:comment xml:lang="pt-BR">A BNCC constrói a ideia de igualdade com "diferentes sentenças de adições ou de subtrações [...] que resultem na mesma soma ou diferença" (EF03MA11).</rdfs:comment>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://contacomigo.org/ontology#Prerequisite_MultiplicationToCombinatorics">
    <rdfs:label xml:lang="en">multiplication → combinatorics prerequisite</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Pré-requisito: multiplicação → princípio multiplicativo de contagem</rdfs:label>
    <rdf:type rdf:resource="https://contacomigo.org/ontology#PrerequisiteRelation"/>
    <cc:prerequisiteConcept rdf:resource="https://contacomigo.org/ontology#MultiplicationConcept"/>
    <cc:dependentConcept rdf:resource="https://contacomigo.org/ontology#CombinatoricsConcept"/>
    <cc:mappingOrigin>ContaComigo semantic analysis of BNCC EF04MA08; EF05MA09</cc:mappingOrigin>
    <cc:relationReviewStatus>grounded_in_bncc_text</cc:relationReviewStatus>
    <rdfs:comment xml:lang="pt-BR">A BNCC trata a contagem de agrupamentos pelo "princípio multiplicativo" (EF05MA09), combinando cada elemento de uma coleção com todos os de outra (EF04MA08).</rdfs:comment>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://contacomigo.org/ontology#Prerequisite_MultiplicationToProportionality">
    <rdfs:label xml:lang="en">multiplication → proportionality prerequisite</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Pré-requisito: multiplicação → proporcionalidade</rdfs:label>
    <rdf:type rdf:resource="https://contacomigo.org/ontology#PrerequisiteRelation"/>
    <cc:prerequisiteConcept rdf:resource="https://contacomigo.org/ontology#MultiplicationConcept"/>
    <cc:dependentConcept rdf:resource="https://contacomigo.org/ontology#ProportionalityConcept"/>
    <cc:mappingOrigin>ContaComigo semantic analysis of BNCC EF04MA06; EF05MA12</cc:mappingOrigin>
    <cc:relationReviewStatus>grounded_in_bncc_text</cc:relationReviewStatus>
    <rdfs:comment xml:lang="pt-BR">A BNCC lista a proporcionalidade entre os "significados da multiplicação" (EF04MA06) antes dos problemas de proporcionalidade direta (EF05MA12).</rdfs:comment>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://contacomigo.org/ontology#Prerequisite_BasicGeometryToPolygon">
    <rdfs:label xml:lang="en">basic geometry → polygon prerequisite</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Pré-requisito: geometria básica → polígono</rdfs:label>
    <rdf:type rdf:resource="https://contacomigo.org/ontology#PrerequisiteRelation"/>
    <cc:prerequisiteConcept rdf:resource="https://contacomigo.org/ontology#BasicGeometryConcept"/>
    <cc:dependentConcept rdf:resource="https://contacomigo.org/ontology#PolygonConcept"/>
    <cc:mappingOrigin>ContaComigo semantic analysis of BNCC EF01MA14; EF02MA15; EF03MA15</cc:mappingOrigin>
    <cc:relationReviewStatus>grounded_in_bncc_text</cc:relationReviewStatus>
    <rdfs:comment xml:lang="pt-BR">A BNCC progride de identificar figuras planas (EF01MA14) e reconhecer características comuns (EF02MA15) para classificá-las por lados e vértices (EF03MA15).</rdfs:comment>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:NamedIndividual>
  <!-- Concept prerequisites (v0.6.0). Dependent concepts are new or 5º ano
       concepts, so the relations of the original 1º ano skills are unchanged. -->
  <owl:NamedIndividual rdf:about="https://contacomigo.org/ontology#Prerequisite_SpatialLocationToCoordinateLocation">
    <rdfs:label xml:lang="en">spatial location → coordinate location prerequisite</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Pré-requisito: localização no espaço → coordenadas</rdfs:label>
    <rdf:type rdf:resource="https://contacomigo.org/ontology#PrerequisiteRelation"/>
    <cc:prerequisiteConcept rdf:resource="https://contacomigo.org/ontology#SpatialLocationConcept"/>
    <cc:dependentConcept rdf:resource="https://contacomigo.org/ontology#CoordinateLocationConcept"/>
    <cc:mappingOrigin>ContaComigo semantic analysis of BNCC EF04MA16; EF05MA14</cc:mappingOrigin>
    <cc:relationReviewStatus>grounded_in_bncc_text</cc:relationReviewStatus>
    <rdfs:comment xml:lang="pt-BR">A BNCC pede "diferentes representações para a localização de objetos no plano, como mapas, células em planilhas eletrônicas e coordenadas geográficas, a fim de desenvolver as primeiras noções de coordenadas cartesianas" (EF05MA14), depois de descrever localização "por meio de malhas quadriculadas e representações como desenhos, mapas, planta baixa e croquis" (EF04MA16).</rdfs:comment>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://contacomigo.org/ontology#Prerequisite_ProportionalityToSimilarity">
    <rdfs:label xml:lang="en">proportionality → similarity prerequisite</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Pré-requisito: proporcionalidade → ampliação e redução</rdfs:label>
    <rdf:type rdf:resource="https://contacomigo.org/ontology#PrerequisiteRelation"/>
    <cc:prerequisiteConcept rdf:resource="https://contacomigo.org/ontology#ProportionalityConcept"/>
    <cc:dependentConcept rdf:resource="https://contacomigo.org/ontology#SimilarityConcept"/>
    <cc:mappingOrigin>ContaComigo semantic analysis of BNCC EF05MA18</cc:mappingOrigin>
    <cc:relationReviewStatus>grounded_in_bncc_text</cc:relationReviewStatus>
    <rdfs:comment xml:lang="pt-BR">A BNCC caracteriza ampliação e redução pela "proporcionalidade entre os lados correspondentes de figuras poligonais" (EF05MA18).</rdfs:comment>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://contacomigo.org/ontology#Prerequisite_CongruenceToSimilarity">
    <rdfs:label xml:lang="en">congruence → similarity prerequisite</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Pré-requisito: congruência → ampliação e redução</rdfs:label>
    <rdf:type rdf:resource="https://contacomigo.org/ontology#PrerequisiteRelation"/>
    <cc:prerequisiteConcept rdf:resource="https://contacomigo.org/ontology#CongruenceConcept"/>
    <cc:dependentConcept rdf:resource="https://contacomigo.org/ontology#SimilarityConcept"/>
    <cc:mappingOrigin>ContaComigo semantic analysis of BNCC EF03MA16; EF05MA18</cc:mappingOrigin>
    <cc:relationReviewStatus>needs_professional_review</cc:relationReviewStatus>
    <rdfs:comment xml:lang="pt-BR">A BNCC pede "Reconhecer figuras congruentes" (EF03MA16) e, no 5º ano, "a congruência dos ângulos" em ampliações e reduções (EF05MA18). A congruência de figuras e a de ângulos não são a mesma noção; por isso esta relação requer revisão profissional.</rdfs:comment>
    <dcterms:source rdf:resource="https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf"/>
  </owl:NamedIndividual>
