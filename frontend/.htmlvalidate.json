{
  "extends": ["html-validate:recommended"],
  "rules": {
    "attr-boolean-style": "error",
    "attr-spacing": "error",
    "close-attr": "error",
    "close-tag-mismatch": "error",
    "color-contrast": "error",
    "deprecated": "error",
    "doctype-html": "error",
    "element-permitted-content": "error",
    "empty-heading": "error",
    "form-dup-name": "error",
    "form-dup-id": "error",
    "heading-level": "warn",
    "id-dup": "error",
    "input-duplicate-label": "warn",
    "input-missing-label": "warn",
    "input-type": "error",
    "invalid-html-structure": "error",
    "no-conditional-comment": "error",
    "no-dup-attr": "error",
    "no-dup-class-style": "warn",
    "no-dup-id": "error",
    "no-dup-landmark": "error",
    "no-hidden-overflow": "warn",
    "no-implicit-button-type": "warn",
    "no-inline-style": "off",
    "no-raw-characters": "error",
    "no-redundant-for-attribute": "warn",
    "no-redundant-role": "warn",
    "no-trailing-whitespace": "warn",
    "no-unknown-elements": "error",
    "require-sri": "off",
    "script-type": "error",
    "text-content-too-long": "warn",
    "unrecognized-char-ref": "error",
    "void-content": "error",
    "void-style": "error",
    "wcag/h64a": "error",
    "wcag/h67": "error",
    "wcag/h71": "warn",
    "wcag/aria": "error"
  }
}
