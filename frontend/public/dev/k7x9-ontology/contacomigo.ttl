###  https://contacomigo.org/ontology#Prerequisite_AdditionToEquality
cc:Prerequisite_AdditionToEquality rdf:type owl:NamedIndividual ,
                                            cc:PrerequisiteRelation ;
                                   cc:dependentConcept cc:EqualityConcept ;
                                   cc:prerequisiteConcept cc:AdditionConcept ;
                                   dcterms:source <https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf> ;
                                   rdfs:comment "A BNCC constrói a ideia de igualdade com \"diferentes sentenças de adições ou de subtrações [...] que resultem na mesma soma ou diferença\" (EF03MA11)."@pt-br ;
                                   rdfs:label "Pré-requisito: adição → igualdade"@pt-br ,
                                              "addition → equality prerequisite"@en ;
                                   cc:mappingOrigin "ContaComigo semantic analysis of BNCC EF03MA11" ;
                                   cc:relationReviewStatus "grounded_in_bncc_text" .


###  https://contacomigo.org/ontology#Prerequisite_AdditionToMultiplication
cc:Prerequisite_AdditionToMultiplication rdf:type owl:NamedIndividual ,
                                                  cc:PrerequisiteRelation ;
                                         cc:dependentConcept cc:MultiplicationConcept ;
                                         cc:prerequisiteConcept cc:AdditionConcept ;
                                         dcterms:source <https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf> ;
                                         rdfs:comment "A BNCC apresenta a multiplicação \"com a ideia de adição de parcelas iguais\" (EF02MA07) e \"com os significados de adição de parcelas iguais\" (EF03MA07)."@pt-br ;
                                         rdfs:label "Pré-requisito: adição → multiplicação"@pt-br ,
                                                    "addition → multiplication prerequisite"@en ;
                                         cc:mappingOrigin "ContaComigo semantic analysis of BNCC EF02MA07; EF03MA07" ;
                                         cc:relationReviewStatus "grounded_in_bncc_text" .


###  https://contacomigo.org/ontology#Prerequisite_BasicGeometryToPolygon
cc:Prerequisite_BasicGeometryToPolygon rdf:type owl:NamedIndividual ,
                                                cc:PrerequisiteRelation ;
                                       cc:dependentConcept cc:PolygonConcept ;
                                       cc:prerequisiteConcept cc:BasicGeometryConcept ;
                                       dcterms:source <https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf> ;
                                       rdfs:comment "A BNCC progride de identificar figuras planas (EF01MA14) e reconhecer características comuns (EF02MA15) para classificá-las por lados e vértices (EF03MA15)."@pt-br ;
                                       rdfs:label "Pré-requisito: geometria básica → polígono"@pt-br ,
                                                  "basic geometry → polygon prerequisite"@en ;
                                       cc:mappingOrigin "ContaComigo semantic analysis of BNCC EF01MA14; EF02MA15; EF03MA15" ;
                                       cc:relationReviewStatus "grounded_in_bncc_text" .


###  https://contacomigo.org/ontology#Prerequisite_CongruenceToSimilarity
cc:Prerequisite_CongruenceToSimilarity rdf:type owl:NamedIndividual ,
                                                cc:PrerequisiteRelation ;
                                       cc:dependentConcept cc:SimilarityConcept ;
                                       cc:prerequisiteConcept cc:CongruenceConcept ;
                                       dcterms:source <https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf> ;
                                       rdfs:comment "A BNCC pede \"Reconhecer figuras congruentes\" (EF03MA16) e, no 5º ano, \"a congruência dos ângulos\" em ampliações e reduções (EF05MA18). A congruência de figuras e a de ângulos não são a mesma noção; a relação foi confirmada em revisão profissional."@pt-br ;
                                       rdfs:label "Pré-requisito: congruência → ampliação e redução"@pt-br ,
                                                  "congruence → similarity prerequisite"@en ;
                                       cc:mappingOrigin "ContaComigo semantic analysis of BNCC EF03MA16; EF05MA18" ;
                                       cc:relationReviewStatus "reviewed_by_professional" .


###  https://contacomigo.org/ontology#Prerequisite_DivisionToFraction
cc:Prerequisite_DivisionToFraction rdf:type owl:NamedIndividual ,
                                            cc:PrerequisiteRelation ;
                                   cc:dependentConcept cc:FractionConcept ;
                                   cc:prerequisiteConcept cc:DivisionConcept ;
                                   dcterms:source <https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf> ;
                                   rdfs:comment "A BNCC associa \"o quociente de uma divisão [...] às ideias de metade, terça, quarta, quinta e décima partes\" (EF03MA09) e frações \"ao resultado de uma divisão\" (EF05MA03)."@pt-br ;
                                   rdfs:label "Pré-requisito: divisão → fração"@pt-br ,
                                              "division → fraction prerequisite"@en ;
                                   cc:mappingOrigin "ContaComigo semantic analysis of BNCC EF03MA09; EF05MA03" ;
                                   cc:relationReviewStatus "grounded_in_bncc_text" .


###  https://contacomigo.org/ontology#Prerequisite_FractionToPercentage
cc:Prerequisite_FractionToPercentage rdf:type owl:NamedIndividual ,
                                              cc:PrerequisiteRelation ;
                                     cc:dependentConcept cc:PercentageConcept ;
                                     cc:prerequisiteConcept cc:FractionConcept ;
                                     dcterms:source <https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf> ;
                                     rdfs:comment "A BNCC associa 10%, 25%, 50%, 75% e 100% \"à décima parte, quarta parte, metade, três quartos e um inteiro\" (EF05MA06)."@pt-br ;
                                     rdfs:label "Pré-requisito: fração → porcentagem"@pt-br ,
                                                "fraction → percentage prerequisite"@en ;
                                     cc:mappingOrigin "ContaComigo semantic analysis of BNCC EF05MA06" ;
                                     cc:relationReviewStatus "grounded_in_bncc_text" .


###  https://contacomigo.org/ontology#Prerequisite_MeasurementToAreaPerimeter
cc:Prerequisite_MeasurementToAreaPerimeter rdf:type owl:NamedIndividual ,
                                                    cc:PrerequisiteRelation ;
                                           cc:dependentConcept cc:AreaPerimeterConcept ;
                                           cc:prerequisiteConcept cc:MeasurementConcept ;
                                           dcterms:source <https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf> ;
                                           rdfs:comment "A BNCC trata perímetro como medida de comprimento (EF04MA20) antes de comparar áreas em malha (EF04MA21)."@pt-br ;
                                           rdfs:label "Pré-requisito: grandezas e medidas → área e perímetro"@pt-br ,
                                                      "measurement → area perimeter prerequisite"@en ;
                                           cc:mappingOrigin "ContaComigo semantic analysis of BNCC EF04MA20; EF04MA21" ;
                                           cc:relationReviewStatus "grounded_in_bncc_text" .


###  https://contacomigo.org/ontology#Prerequisite_MultiplicationToCombinatorics
cc:Prerequisite_MultiplicationToCombinatorics rdf:type owl:NamedIndividual ,
                                                       cc:PrerequisiteRelation ;
                                              cc:dependentConcept cc:CombinatoricsConcept ;
                                              cc:prerequisiteConcept cc:MultiplicationConcept ;
                                              dcterms:source <https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf> ;
                                              rdfs:comment "A BNCC trata a contagem de agrupamentos pelo \"princípio multiplicativo\" (EF05MA09), combinando cada elemento de uma coleção com todos os de outra (EF04MA08)."@pt-br ;
                                              rdfs:label "Pré-requisito: multiplicação → princípio multiplicativo de contagem"@pt-br ,
                                                         "multiplication → combinatorics prerequisite"@en ;
                                              cc:mappingOrigin "ContaComigo semantic analysis of BNCC EF04MA08; EF05MA09" ;
                                              cc:relationReviewStatus "grounded_in_bncc_text" .


###  https://contacomigo.org/ontology#Prerequisite_MultiplicationToDivision
cc:Prerequisite_MultiplicationToDivision rdf:type owl:NamedIndividual ,
                                                  cc:PrerequisiteRelation ;
                                         cc:dependentConcept cc:DivisionConcept ;
                                         cc:prerequisiteConcept cc:MultiplicationConcept ;
                                         dcterms:source <https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf> ;
                                         rdfs:comment "A BNCC pede \"as relações inversas entre as operações [...] de multiplicação e de divisão\" (EF04MA13). No 2º e 3º ano a divisão por repartição aparece junto com a multiplicação; a relação foi confirmada em revisão profissional."@pt-br ;
                                         rdfs:label "Pré-requisito: multiplicação → divisão"@pt-br ,
                                                    "multiplication → division prerequisite"@en ;
                                         cc:mappingOrigin "ContaComigo semantic analysis of BNCC EF04MA04; EF04MA13" ;
                                         cc:relationReviewStatus "reviewed_by_professional" .


###  https://contacomigo.org/ontology#Prerequisite_MultiplicationToProportionality
cc:Prerequisite_MultiplicationToProportionality rdf:type owl:NamedIndividual ,
                                                         cc:PrerequisiteRelation ;
                                                cc:dependentConcept cc:ProportionalityConcept ;
                                                cc:prerequisiteConcept cc:MultiplicationConcept ;
                                                dcterms:source <https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf> ;
                                                rdfs:comment "A BNCC lista a proporcionalidade entre os \"significados da multiplicação\" (EF04MA06) antes dos problemas de proporcionalidade direta (EF05MA12)."@pt-br ;
                                                rdfs:label "Pré-requisito: multiplicação → proporcionalidade"@pt-br ,
                                                           "multiplication → proportionality prerequisite"@en ;
                                                cc:mappingOrigin "ContaComigo semantic analysis of BNCC EF04MA06; EF05MA12" ;
                                                cc:relationReviewStatus "grounded_in_bncc_text" .


###  https://contacomigo.org/ontology#Prerequisite_NumberToPlaceValue
cc:Prerequisite_NumberToPlaceValue rdf:type owl:NamedIndividual ,
                                            cc:PrerequisiteRelation ;
                                   cc:dependentConcept cc:PlaceValueConcept ;
                                   cc:prerequisiteConcept cc:NumberConcept ;
                                   dcterms:source <https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf> ;
                                   rdfs:comment "A BNCC usa compor e decompor números \"contribuindo para a compreensão de características do sistema de numeração decimal\" (EF01MA07), ampliando para três ordens no 2º ano (EF02MA04)."@pt-br ;
                                   rdfs:label "Pré-requisito: número → valor posicional"@pt-br ,
                                              "number → place value prerequisite"@en ;
                                   cc:mappingOrigin "ContaComigo semantic analysis of BNCC EF01MA07; EF02MA04" ;
                                   cc:relationReviewStatus "grounded_in_bncc_text" .


###  https://contacomigo.org/ontology#Prerequisite_PlaceValueToDecimal
