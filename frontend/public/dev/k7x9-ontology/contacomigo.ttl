###  https://contacomigo.org/ontology#Prerequisite_SpatialLocationToCoordinateLocation
cc:Prerequisite_SpatialLocationToCoordinateLocation rdf:type owl:NamedIndividual ,
                                                             cc:PrerequisiteRelation ;
                                                    cc:dependentConcept cc:CoordinateLocationConcept ;
                                                    cc:prerequisiteConcept cc:SpatialLocationConcept ;
                                                    dcterms:source <https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf> ;
                                                    rdfs:comment "A BNCC pede \"diferentes representações para a localização de objetos no plano, como mapas, células em planilhas eletrônicas e coordenadas geográficas, a fim de desenvolver as primeiras noções de coordenadas cartesianas\" (EF05MA14), depois de descrever localização \"por meio de malhas quadriculadas e representações como desenhos, mapas, planta baixa e croquis\" (EF04MA16)."@pt-br ;
                                                    rdfs:label "Pré-requisito: localização no espaço → coordenadas"@pt-br ,
                                                               "spatial location → coordinate location prerequisite"@en ;
                                                    cc:mappingOrigin "ContaComigo semantic analysis of BNCC EF04MA16; EF05MA14" ;
                                                    cc:relationReviewStatus "grounded_in_bncc_text" .


