###  https://contacomigo.org/ontology#stepCount
cc:stepCount rdf:type owl:DatatypeProperty ;
             rdfs:domain cc:DifficultyProfile ;
             rdfs:range xsd:nonNegativeInteger ;
             rdfs:label "quantidade de passos"@pt-br ,
                        "step count"@en .


###  https://contacomigo.org/ontology#unannotatedDimension
cc:unannotatedDimension rdf:type owl:DatatypeProperty ;
                        rdfs:domain cc:DifficultyProfile ;
                        rdfs:range xsd:string ;
                        rdfs:label "dimensão não anotada"@pt-br ,
