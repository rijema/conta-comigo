                                             cc:PrerequisiteRelation ;
                                    cc:dependentConcept cc:DecimalNumberConcept ;
                                    cc:prerequisiteConcept cc:PlaceValueConcept ;
                                    dcterms:source <https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf> ;
                                    rdfs:comment "A BNCC pede reconhecer \"que as regras do sistema de numeração decimal podem ser estendidas para a representação decimal\" (EF04MA10)."@pt-br ;
                                    rdfs:label "Pré-requisito: valor posicional → número decimal"@pt-br ,
                                               "place value → decimal prerequisite"@en ;
                                    cc:mappingOrigin "ContaComigo semantic analysis of BNCC EF04MA10" ;
                                    cc:relationReviewStatus "grounded_in_bncc_text" .


###  https://contacomigo.org/ontology#Prerequisite_ProportionalityToSimilarity
