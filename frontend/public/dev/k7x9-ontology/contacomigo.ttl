#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( cc:ActivityAffordance
                cc:ActivityType
                cc:DifficultyProfile
                cc:InteractionType
                cc:Modality
                cc:Representation
              ) ;
  rdfs:comment "Dimensões independentes de caracterização de atividades: tipo, modalidade, representação, interação, perfil de dificuldade e recurso de interação (BATCH_02, semântica de atividades, seções 4 e 5)."@pt-br
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( cc:ActivityKnowledge
                cc:CurricularKnowledge
                cc:LearnerKnowledge
                cc:LearningAnalyticsEvidence
                cc:MathematicalKnowledge
              ) ;
  rdfs:comment "As cinco camadas de conhecimento não compartilham indivíduos. Fundamento: BATCH_02 (modelo do aprendiz) mantém conceitos matemáticos e relações didáticas separados de características do aprendiz, de características de atividade e de evidências; BATCH_02 (BNCC) representa a BNCC como camada curricular separada da ontologia matemática, do modelo do aprendiz e das atividades."@pt-br
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( cc:Curriculum
                cc:CurriculumDomain
                cc:CurriculumLevel
                cc:CurriculumSkill
              ) ;
  rdfs:comment "Na estrutura da BNCC, habilidade, documento curricular, unidade temática e ano escolar são elementos de natureza diferente."@pt-br
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( cc:BNCCAlgebraDomain
                        cc:BNCCGeometryDomain
                        cc:BNCCMeasuresDomain
                        cc:BNCCNumbersDomain
                        cc:BNCCStatisticsDomain
                      ) ;
  rdfs:comment "As cinco unidades temáticas de Matemática da BNCC são indivíduos distintos."@pt-br
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( cc:BNCCElementaryYear1
                        cc:BNCCElementaryYear2
                        cc:BNCCElementaryYear3
                        cc:BNCCElementaryYear4
                        cc:BNCCElementaryYear5
                      ) ;
  rdfs:comment "Os cinco anos são indivíduos distintos; sem isso, uma habilidade ligada a dois anos levaria o raciocinador a igualar os anos em vez de apontar a inconsistência."@pt-br
] .


