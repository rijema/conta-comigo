                     rdfs:subClassOf cc:MathematicalConcept .


###  https://contacomigo.org/ontology#CongruenceConcept
cc:CongruenceConcept rdf:type owl:Class ;
                     rdfs:subClassOf cc:BasicGeometryConcept .


###  https://contacomigo.org/ontology#CoordinateLocationConcept
cc:CoordinateLocationConcept rdf:type owl:Class ;
                             rdfs:subClassOf cc:BasicGeometryConcept .


###  https://contacomigo.org/ontology#CountingConcept
cc:CountingConcept rdf:type owl:Class ;
                   rdfs:subClassOf cc:NumberConcept .


###  https://contacomigo.org/ontology#CurricularKnowledge
cc:CurricularKnowledge rdf:type owl:Class ;
                       rdfs:subClassOf cc:KnowledgeEntity ;
                       rdfs:label "Conhecimento curricular"@pt-br ,
                                  "Curricular knowledge"@en ;
                       cc:conceptOrigin "engineering concept" .


###  https://contacomigo.org/ontology#Curriculum
cc:Curriculum rdf:type owl:Class ;
              rdfs:subClassOf cc:CurricularKnowledge ;
              rdfs:label "Curriculum"@en ,
                         "Currículo"@pt-br ;
              cc:conceptOrigin "engineering concept" .


###  https://contacomigo.org/ontology#CurriculumDomain
cc:CurriculumDomain rdf:type owl:Class ;
                    rdfs:subClassOf cc:CurricularKnowledge ;
                    rdfs:label "Curriculum domain"@en ,
                               "Unidade temática curricular"@pt-br ;
                    cc:conceptOrigin "engineering concept" .


###  https://contacomigo.org/ontology#CurriculumLevel
cc:CurriculumLevel rdf:type owl:Class ;
                   rdfs:subClassOf cc:CurricularKnowledge ;
                   rdfs:label "Curriculum level"@en ,
                              "Etapa ou ano curricular"@pt-br ;
                   cc:alignmentNote "Adaptado para permitir níveis curriculares brasileiros; não equivale aos níveis russos ou britânicos distribuídos."@pt-br ;
                   cc:alignmentRelation "adapted" ;
                   cc:conceptOrigin "aligned ontology concept" ;
                   cc:sourceIRI <http://ontomathpro.org/ontomathedu#EducationalLevel> ;
                   cc:sourceOntology <http://ontomathpro.org/ontomathedu#> .


###  https://contacomigo.org/ontology#CurriculumSkill
cc:CurriculumSkill rdf:type owl:Class ;
                   rdfs:subClassOf cc:CurricularKnowledge ;
                   rdfs:comment "A skill defined by a curriculum; it is not a mathematical concept or learner characteristic."@en ;
                   rdfs:label "Curriculum skill"@en ,
                              "Habilidade curricular"@pt-br ;
                   cc:conceptOrigin "engineering concept" .


###  https://contacomigo.org/ontology#DataInterpretationConcept
cc:DataInterpretationConcept rdf:type owl:Class ;
                             rdfs:subClassOf cc:MathematicalConcept .


###  https://contacomigo.org/ontology#DecimalNumberConcept
cc:DecimalNumberConcept rdf:type owl:Class ;
                        rdfs:subClassOf cc:NumberConcept .


###  https://contacomigo.org/ontology#DidacticRelation
cc:DidacticRelation rdf:type owl:Class ;
                    rdfs:subClassOf cc:MathematicalKnowledge ;
                    owl:disjointWith cc:MathematicalConcept ;
                    rdfs:label "Didactic relation"@en ,
                               "Relação didática"@pt-br ;
                    cc:alignmentNote "Relação reificada local inspirada na dimensão didática descrita pela OntoMathEdu; o artefato distribui hasPrerequisite como propriedade de anotação."@pt-br ;
                    cc:alignmentRelation "adapted" ;
                    cc:conceptOrigin "aligned ontology concept" ;
                    cc:sourceIRI <http://ontomathpro.org/ontomathedu#hasPrerequisite> ;
                    cc:sourceOntology <http://ontomathpro.org/ontomathedu#> .

[ rdf:type owl:Axiom ;
   owl:annotatedSource cc:DidacticRelation ;
   owl:annotatedProperty owl:disjointWith ;
   owl:annotatedTarget cc:MathematicalConcept ;
   rdfs:comment "Um conceito matemático não é uma relação didática entre conceitos (relações didáticas são reificadas, BATCH_02 OntoMathEdu). Os subconceitos matemáticos não são declarados disjuntos: o BATCH_02 registra que essas partições não afirmam disjunção."@pt-br
 ] .


###  https://contacomigo.org/ontology#DifficultyProfile
cc:DifficultyProfile rdf:type owl:Class ;
                     rdfs:subClassOf cc:ActivityCharacteristic ;
                     rdfs:comment "A multidimensional developer or expert annotation. It does not replace legacy easy/medium/hard labels and is not learned or clinically validated."@en ;
                     rdfs:label "Difficulty profile"@en ,
                                "Perfil de dificuldade"@pt-br ;
                     cc:conceptOrigin "experimental construct" .


###  https://contacomigo.org/ontology#DivisionConcept
cc:DivisionConcept rdf:type owl:Class ;
                   rdfs:subClassOf cc:MathematicalConcept .


###  https://contacomigo.org/ontology#EarlyProblemSolvingConcept
cc:EarlyProblemSolvingConcept rdf:type owl:Class ;
                              rdfs:subClassOf cc:MathematicalConcept .


###  https://contacomigo.org/ontology#EqualityConcept
cc:EqualityConcept rdf:type owl:Class ;
                   rdfs:subClassOf cc:MathematicalConcept .


###  https://contacomigo.org/ontology#EvidenceSufficiencyAssessment
cc:EvidenceSufficiencyAssessment rdf:type owl:Class ;
                                 rdfs:subClassOf cc:LearnerKnowledge ;
                                 rdfs:comment "A revisable result of applying a documented reasoning policy to an evidence set."@en ;
                                 rdfs:label "Avaliação de suficiência de evidência"@pt-br ,
                                            "Evidence sufficiency assessment"@en ;
                                 cc:conceptOrigin "experimental construct" .


###  https://contacomigo.org/ontology#EvidenceWindow
cc:EvidenceWindow rdf:type owl:Class ;
                  rdfs:subClassOf cc:LearnerKnowledge ;
                  rdfs:comment "A bounded contextual interval over which evidence is selected and interpreted."@en ;
                  rdfs:label "Evidence window"@en ,
                             "Janela de evidência"@pt-br ;
                  cc:conceptOrigin "engineering concept" .


###  https://contacomigo.org/ontology#FractionConcept
cc:FractionConcept rdf:type owl:Class ;
                   rdfs:subClassOf cc:NumberConcept .


###  https://contacomigo.org/ontology#InsufficientEvidence
cc:InsufficientEvidence rdf:type owl:Class ;
                        rdfs:subClassOf cc:EvidenceSufficiencyAssessment ;
                        rdfs:comment "Evidence is unavailable, stale, too sparse, untested for the context, or conflicting. This is not evidence of weakness or a support need."@en ;
                        rdfs:label "Evidência insuficiente"@pt-br ,
                                   "Insufficient evidence"@en ;
                        cc:conceptOrigin "experimental construct" .


###  https://contacomigo.org/ontology#InteractionCompatibilityAssessment
cc:InteractionCompatibilityAssessment rdf:type owl:Class ;
                                      rdfs:subClassOf cc:LearnerKnowledge ;
                                      rdfs:comment "A contextual assessment of fit between interaction requirements and observed learner support information."@en ;
                                      rdfs:label "Avaliação de compatibilidade de interação"@pt-br ,
                                                 "Interaction compatibility assessment"@en ;
                                      cc:conceptOrigin "experimental construct" .


###  https://contacomigo.org/ontology#InteractionDifficultyEvidence
cc:InteractionDifficultyEvidence rdf:type owl:Class ;
                                 rdfs:subClassOf cc:InteractionEvidence ;
                                 rdfs:comment "Evidence concerning access to or operation of an interaction format; it does not establish mathematical difficulty."@en ;
                                 rdfs:label "Evidência de dificuldade de interação"@pt-br ,
                                            "Interaction difficulty evidence"@en ;
                                 cc:conceptOrigin "engineering concept" .


###  https://contacomigo.org/ontology#InteractionEvidence
cc:InteractionEvidence rdf:type owl:Class ;
                       rdfs:subClassOf prov:Entity ,
                                       cc:LearningAnalyticsEvidence ;
                       rdfs:comment "A semantic evidence entity derived from interaction records or aggregations; it does not give a raw event an intrinsic psychological meaning."@en ;
                       rdfs:label "Evidência de interação"@pt-br ,
                                  "Interaction evidence"@en ;
                       cc:alignmentRelation "narrower" ;
                       cc:conceptOrigin "aligned ontology concept" ;
                       cc:sourceIRI prov:Entity ;
                       cc:sourceOntology prov: .


###  https://contacomigo.org/ontology#InteractionType
cc:InteractionType rdf:type owl:Class ;
                   rdfs:subClassOf cc:ActivityCharacteristic ;
                   rdfs:comment "The input or manipulation pattern exposed by an activity."@en ;
                   rdfs:label "Interaction type"@en ,
                              "Tipo de interação"@pt-br ;
                   cc:conceptOrigin "engineering concept" .


###  https://contacomigo.org/ontology#KnowledgeEntity
cc:KnowledgeEntity rdf:type owl:Class ;
                   rdfs:label "Entidade de conhecimento"@pt-br ,
                              "Knowledge entity"@en ;
                   cc:conceptOrigin "engineering concept" .


###  https://contacomigo.org/ontology#Learner
cc:Learner rdf:type owl:Class ;
           rdfs:subClassOf cc:LearnerKnowledge ;
           rdfs:comment "A learner participating in an educational experience; diagnosis does not entail any learner characteristic."@en ;
           rdfs:label "Aprendiz"@pt-br ,
                      "Learner"@en ;
           cc:conceptOrigin "engineering concept" .


###  https://contacomigo.org/ontology#LearnerCharacteristic
cc:LearnerCharacteristic rdf:type owl:Class ;
                         rdfs:subClassOf prov:Entity ,
                                         cc:LearnerKnowledge ;
                         dcterms:source <https://doi.org/10.1111/jcpp.13534> ;
                         rdfs:comment "A contextual, revisable learner-model entity; it is not an essential property or diagnosis."@en ;
                         rdfs:label "Característica do aprendiz"@pt-br ,
                                    "Learner characteristic"@en ;
                         cc:conceptOrigin "literature-grounded ContaComigo concept" .


###  https://contacomigo.org/ontology#LearnerKnowledge
cc:LearnerKnowledge rdf:type owl:Class ;
                    rdfs:subClassOf cc:KnowledgeEntity ;
                    rdfs:label "Conhecimento sobre o estudante"@pt-br ,
                               "Learner knowledge"@en ;
                    cc:conceptOrigin "engineering concept" .


###  https://contacomigo.org/ontology#LearnerSkillState
cc:LearnerSkillState rdf:type owl:Class ;
                     rdfs:subClassOf cc:LearnerKnowledge ;
                     rdfs:comment "Semantic reference to the current skill-mastery state whose calculation remains owned by Bayesian Knowledge Tracing."@en ;
                     rdfs:label "Estado de domínio da habilidade pelo aprendiz"@pt-br ,
                                "Learner skill state"@en ;
                     cc:conceptOrigin "engineering concept" .


###  https://contacomigo.org/ontology#LearningActivity
cc:LearningActivity rdf:type owl:Class ;
                    rdfs:subClassOf cc:Activity ;
                    rdfs:label "Atividade de aprendizagem"@pt-br ,
                               "Learning activity"@en ;
                    cc:conceptOrigin "engineering concept" .


###  https://contacomigo.org/ontology#LearningAnalyticsEvidence
cc:LearningAnalyticsEvidence rdf:type owl:Class ;
                             rdfs:subClassOf cc:KnowledgeEntity ;
                             rdfs:label "Evidência de Learning Analytics"@pt-br ,
                                        "Learning Analytics evidence"@en ;
                             cc:conceptOrigin "engineering concept" .


###  https://contacomigo.org/ontology#LearningEventEvidence
cc:LearningEventEvidence rdf:type owl:Class ;
                         rdfs:subClassOf cc:LearningAnalyticsEvidence ;
                         rdfs:comment "Semantic reference to immutable interaction records kept in the Learning Analytics persistence layer."@en ;
                         rdfs:label "Evidência de evento de aprendizagem"@pt-br ,
                                    "Learning-event evidence"@en ;
                         cc:conceptOrigin "engineering concept" .


###  https://contacomigo.org/ontology#LearningEvidence
cc:LearningEvidence rdf:type owl:Class ;
                    rdfs:subClassOf cc:InteractionEvidence ;
                    rdfs:comment "Evidence about mathematical learning or performance, distinct from interaction-format fit."@en ;
                    rdfs:label "Evidência de aprendizagem"@pt-br ,
                               "Learning evidence"@en ;
                    cc:conceptOrigin "engineering concept" .


###  https://contacomigo.org/ontology#LearningSession
cc:LearningSession rdf:type owl:Class ;
                   rdfs:subClassOf prov:Activity ,
                                   cc:ActivityKnowledge ;
                   rdfs:label "Learning session"@en ,
                              "Sessão de aprendizagem"@pt-br ;
                   cc:alignmentRelation "narrower" ;
                   cc:conceptOrigin "aligned ontology concept" ;
                   cc:sourceIRI prov:Activity ;
                   cc:sourceOntology prov: .


###  https://contacomigo.org/ontology#LogicalReasoningEvidence
cc:LogicalReasoningEvidence rdf:type owl:Class ;
                            rdfs:subClassOf cc:LearningEvidence ;
                            rdfs:comment "Evidence from identified mathematical reasoning tasks such as comparison, ordering, patterns, composition, decomposition, generalization, or problem solving."@en ;
                            rdfs:label "Evidência de raciocínio lógico"@pt-br ,
                                       "Logical reasoning evidence"@en ;
                            cc:conceptOrigin "engineering concept" .


###  https://contacomigo.org/ontology#MathematicalConcept
cc:MathematicalConcept rdf:type owl:Class ;
                       rdfs:subClassOf cc:MathematicalKnowledge ;
                       rdfs:label "Conceito matemático"@pt-br ,
                                  "Mathematical concept"@en ;
                       cc:alignmentNote "Classe local adaptada do princípio de camada de domínio matemático da OntoMathEdu; não existe classe nomeada MathematicalConcept no artefato distribuído."@pt-br ;
                       cc:alignmentRelation "adapted" ;
                       cc:conceptOrigin "aligned ontology concept" ;
                       cc:sourceIRI <http://ontomathpro.org/ontomathedu#> ;
                       cc:sourceOntology <http://ontomathpro.org/ontomathedu#> .


###  https://contacomigo.org/ontology#MathematicalDifficultyEvidence
cc:MathematicalDifficultyEvidence rdf:type owl:Class ;
                                  rdfs:subClassOf cc:LearningEvidence ;
                                  rdfs:comment "Evidence concerning a mathematical concept or skill; it must not be inferred solely from interaction-format difficulty."@en ;
                                  rdfs:label "Evidência de dificuldade matemática"@pt-br ,
                                             "Mathematical difficulty evidence"@en ;
                                  cc:conceptOrigin "engineering concept" .


###  https://contacomigo.org/ontology#MathematicalKnowledge
cc:MathematicalKnowledge rdf:type owl:Class ;
                         rdfs:subClassOf cc:KnowledgeEntity ;
                         rdfs:label "Conhecimento matemático"@pt-br ,
                                    "Mathematical knowledge"@en ;
                         cc:conceptOrigin "engineering concept" .


###  https://contacomigo.org/ontology#MeasurementConcept
cc:MeasurementConcept rdf:type owl:Class ;
                      rdfs:subClassOf cc:MathematicalConcept .


###  https://contacomigo.org/ontology#Modality
cc:Modality rdf:type owl:Class ;
            rdfs:subClassOf cc:ActivityCharacteristic ;
            rdfs:comment "A presentation or interaction modality; it is not a learner type."@en ;
            rdfs:label "Modalidade"@pt-br ,
                       "Modality"@en ;
            cc:conceptOrigin "engineering concept" .


###  https://contacomigo.org/ontology#MoneyConcept
cc:MoneyConcept rdf:type owl:Class ;
                rdfs:subClassOf cc:MeasurementConcept .


###  https://contacomigo.org/ontology#MotorDemandCompatibility
cc:MotorDemandCompatibility rdf:type owl:Class ;
                            rdfs:subClassOf cc:InteractionCompatibilityAssessment ;
                            rdfs:comment "A time- and activity-specific assessment; it is not motor ability or a learning style."@en ;
                            rdfs:label "Compatibilidade com a demanda motora"@pt-br ,
                                       "Motor demand compatibility"@en ;
                            cc:conceptOrigin "experimental construct" ;
                            cc:historicalMappingType "narrower than" ;
                            cc:historicalSourceConcept "Motor_Weakness" ;
                            cc:historicalSourceOntology <http://www.semanticweb.org/ricma/ontologies/2024/11/LASDONT.owl> .


###  https://contacomigo.org/ontology#MotorInteractionEvidence
cc:MotorInteractionEvidence rdf:type owl:Class ;
                            rdfs:subClassOf cc:InteractionEvidence ;
                            dcterms:source <https://www.w3.org/TR/wcag/> ;
                            rdfs:comment "Evidence about interaction demands such as dragging, pointing, or target activation, separate from mathematical performance."@en ;
                            rdfs:label "Evidência de interação motora"@pt-br ,
                                       "Motor interaction evidence"@en ;
                            cc:conceptOrigin "literature-grounded ContaComigo concept" .


###  https://contacomigo.org/ontology#MotorInteractionPreference
cc:MotorInteractionPreference rdf:type owl:Class ;
                              rdfs:subClassOf cc:ObservedPreference ;
                              dcterms:source <https://udlguidelines.cast.org/> ;
                              rdfs:comment "A contextual preference among available input methods."@en ;
                              rdfs:label "Motor interaction preference"@en ,
                                         "Preferência de interação motora"@pt-br ;
                              cc:conceptOrigin "literature-grounded ContaComigo concept" ;
                              cc:historicalMappingType "related to" ;
                              cc:historicalSourceConcept "Motor_Strength" ;
                              cc:historicalSourceOntology <http://www.semanticweb.org/ricma/ontologies/2024/11/LASDONT.owl> .


###  https://contacomigo.org/ontology#MotorSupportNeed
cc:MotorSupportNeed rdf:type owl:Class ;
                    rdfs:subClassOf cc:SupportNeed ;
                    dcterms:source <https://www.w3.org/TR/wcag/> ;
                    rdfs:comment "A temporary or contextual need for an alternative interaction method; it does not assert mathematical difficulty."@en ;
                    rdfs:label "Motor support need"@en ,
                               "Necessidade de suporte motor"@pt-br ;
                    cc:conceptOrigin "literature-grounded ContaComigo concept" ;
                    cc:historicalMappingType "adapted from" ;
                    cc:historicalSourceConcept "Motor_Weakness" ;
                    cc:historicalSourceOntology <http://www.semanticweb.org/ricma/ontologies/2024/11/LASDONT.owl> .


###  https://contacomigo.org/ontology#MultiplicationConcept
cc:MultiplicationConcept rdf:type owl:Class ;
                         rdfs:subClassOf cc:MathematicalConcept .


###  https://contacomigo.org/ontology#NumberConcept
cc:NumberConcept rdf:type owl:Class ;
                 rdfs:subClassOf cc:MathematicalConcept .


###  https://contacomigo.org/ontology#Observation
cc:Observation rdf:type owl:Class ;
               rdfs:subClassOf prov:Entity ,
                               cc:LearningAnalyticsEvidence ;
               rdfs:comment "A contextual observation produced from one or more persisted records or an explicitly identified human assessment."@en ;
               rdfs:label "Observation"@en ,
                          "Observação"@pt-br ;
               cc:alignmentRelation "narrower" ;
               cc:conceptOrigin "aligned ontology concept" ;
               cc:sourceIRI prov:Entity ;
               cc:sourceOntology prov: .


###  https://contacomigo.org/ontology#ObservedAuditoryPreference
cc:ObservedAuditoryPreference rdf:type owl:Class ;
                              rdfs:subClassOf cc:ObservedPreference ;
                              dcterms:source <https://doi.org/10.1111/j.1539-6053.2009.01038.x> ;
                              rdfs:comment "A contextual preference for auditory interaction; it makes no claim about improved learning."@en ;
                              rdfs:label "Observed auditory preference"@en ,
                                         "Preferência auditiva observada"@pt-br ;
                              cc:conceptOrigin "literature-grounded ContaComigo concept" ;
                              cc:historicalMappingType "related to" ;
                              cc:historicalSourceConcept "Auditive_Strength" ;
                              cc:historicalSourceOntology <http://www.semanticweb.org/ricma/ontologies/2024/11/LASDONT.owl> .


###  https://contacomigo.org/ontology#ObservedAuditoryStrength
cc:ObservedAuditoryStrength rdf:type owl:Class ;
                            rdfs:subClassOf cc:ObservedStrength ;
                            dcterms:source <https://doi.org/10.1007/s41252-023-00348-z> ;
                            rdfs:comment "Comparatively favorable contextual outcomes with auditory presentation within an identified evidence window."@en ;
                            rdfs:label "Força auditiva observada"@pt-br ,
                                       "Observed auditory strength"@en ;
                            cc:conceptOrigin "literature-grounded ContaComigo concept" ;
                            cc:historicalMappingType "adapted from" ;
                            cc:historicalSourceConcept "Auditive_Strength" ;
                            cc:historicalSourceOntology <http://www.semanticweb.org/ricma/ontologies/2024/11/LASDONT.owl> .


###  https://contacomigo.org/ontology#ObservedLearnerCharacteristic
cc:ObservedLearnerCharacteristic rdf:type owl:Class ;
                                 rdfs:subClassOf cc:LearnerCharacteristic ;
                                 dcterms:source <https://doi.org/10.3102/00346543211020116> ;
                                 rdfs:comment "A time-bounded interpretation supported by contextual evidence from more than an unqualified single interaction or by an explicitly identified assessment source."@en ;
                                 rdfs:label "Característica observada do aprendiz"@pt-br ,
                                            "Observed learner characteristic"@en ;
                                 cc:conceptOrigin "literature-grounded ContaComigo concept" .


###  https://contacomigo.org/ontology#ObservedLogicalReasoningStrength
cc:ObservedLogicalReasoningStrength rdf:type owl:Class ;
                                    rdfs:subClassOf cc:ObservedStrength ;
                                    rdfs:comment "Contextual favorable evidence from mathematical reasoning tasks, not a consequence of diagnosis."@en ;
                                    rdfs:label "Força de raciocínio lógico observada"@pt-br ,
                                               "Observed logical reasoning strength"@en ;
                                    cc:conceptOrigin "experimental construct" ;
                                    cc:historicalMappingType "narrower than" ;
                                    cc:historicalSourceConcept "Logical_Strength" ;
                                    cc:historicalSourceOntology <http://www.semanticweb.org/ricma/ontologies/2024/11/LASDONT.owl> .


###  https://contacomigo.org/ontology#ObservedPreference
cc:ObservedPreference rdf:type owl:Class ;
                      rdfs:subClassOf cc:ObservedLearnerCharacteristic ;
                      dcterms:source <https://doi.org/10.1111/j.1539-6053.2009.01038.x> ;
                      rdfs:comment "A contextual interaction preference that does not imply superior learning outcomes or a fixed learning style."@en ;
                      rdfs:label "Observed preference"@en ,
                                 "Preferência observada"@pt-br ;
                      cc:conceptOrigin "literature-grounded ContaComigo concept" .


###  https://contacomigo.org/ontology#ObservedStrength
cc:ObservedStrength rdf:type owl:Class ;
                    rdfs:subClassOf cc:ObservedLearnerCharacteristic ;
                    dcterms:source <https://doi.org/10.1007/s41252-023-00348-z> ;
                    rdfs:comment "Context-specific favorable performance or interaction evidence, subject to an evidence window and revision."@en ;
                    rdfs:label "Força observada"@pt-br ,
                               "Observed strength"@en ;
                    cc:conceptOrigin "literature-grounded ContaComigo concept" .


###  https://contacomigo.org/ontology#ObservedVisualPreference
cc:ObservedVisualPreference rdf:type owl:Class ;
                            rdfs:subClassOf cc:ObservedPreference ;
                            dcterms:source <https://doi.org/10.1111/j.1539-6053.2009.01038.x> ;
                            rdfs:comment "A contextual preference for visual interaction; it makes no claim about improved learning."@en ;
                            rdfs:label "Observed visual preference"@en ,
                                       "Preferência visual observada"@pt-br ;
                            cc:conceptOrigin "literature-grounded ContaComigo concept" ;
                            cc:historicalMappingType "related to" ;
                            cc:historicalSourceConcept "Visual_Strength" ;
                            cc:historicalSourceOntology <http://www.semanticweb.org/ricma/ontologies/2024/11/LASDONT.owl> .


###  https://contacomigo.org/ontology#ObservedVisualStrength
cc:ObservedVisualStrength rdf:type owl:Class ;
                          rdfs:subClassOf cc:ObservedStrength ;
                          dcterms:source <https://doi.org/10.1007/s41252-023-00348-z> ;
                          rdfs:comment "Comparatively favorable contextual outcomes under visual representation within an identified evidence window."@en ;
                          rdfs:label "Força visual observada"@pt-br ,
                                     "Observed visual strength"@en ;
                          cc:conceptOrigin "literature-grounded ContaComigo concept" ;
                          cc:historicalMappingType "adapted from" ;
                          cc:historicalSourceConcept "Visual_Strength" ;
                          cc:historicalSourceOntology <http://www.semanticweb.org/ricma/ontologies/2024/11/LASDONT.owl> .


###  https://contacomigo.org/ontology#PercentageConcept
cc:PercentageConcept rdf:type owl:Class ;
                     rdfs:subClassOf cc:MathematicalConcept .


###  https://contacomigo.org/ontology#PlaceValueConcept
cc:PlaceValueConcept rdf:type owl:Class ;
                     rdfs:subClassOf cc:NumberConcept .


###  https://contacomigo.org/ontology#PointConcept
cc:PointConcept rdf:type owl:Class ;
                rdfs:subClassOf cc:BasicGeometryConcept ;
                rdfs:label "Conceito de ponto"@pt-br ,
                           "Point concept"@en ;
                cc:alignmentRelation "related" ;
                cc:conceptOrigin "aligned ontology concept" ;
                cc:sourceIRI <http://ontomathpro.org/ontomathedu#R71GKMyesTQoOWWvX1M74EE> ;
                cc:sourceOntology <http://ontomathpro.org/ontomathedu#> .


###  https://contacomigo.org/ontology#PolygonConcept
cc:PolygonConcept rdf:type owl:Class ;
                  rdfs:subClassOf cc:BasicGeometryConcept .


###  https://contacomigo.org/ontology#PrerequisiteRelation
cc:PrerequisiteRelation rdf:type owl:Class ;
                        rdfs:subClassOf cc:DidacticRelation ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cc:dependentConcept ;
                                          owl:someValuesFrom cc:MathematicalConcept
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cc:prerequisiteConcept ;
                                          owl:someValuesFrom cc:MathematicalConcept
                                        ] ;
                        rdfs:label "Prerequisite relation"@en ,
                                   "Relação de pré-requisito"@pt-br ;
                        cc:alignmentNote "Adaptação reificada e ligada por IRIs; não é equivalente à propriedade de anotação textual da distribuição OntoMathEdu."@pt-br ;
                        cc:alignmentRelation "adapted" ;
                        cc:conceptOrigin "aligned ontology concept" ;
                        cc:sourceIRI <http://ontomathpro.org/ontomathedu#hasPrerequisite> ;
                        cc:sourceOntology <http://ontomathpro.org/ontomathedu#> .


###  https://contacomigo.org/ontology#ProbabilityConcept
cc:ProbabilityConcept rdf:type owl:Class ;
                      rdfs:subClassOf cc:MathematicalConcept .


###  https://contacomigo.org/ontology#ProportionalityConcept
cc:ProportionalityConcept rdf:type owl:Class ;
                          rdfs:subClassOf cc:MathematicalConcept .


###  https://contacomigo.org/ontology#ReasoningSupportNeed
cc:ReasoningSupportNeed rdf:type owl:Class ;
                        rdfs:subClassOf cc:SupportNeed ;
                        rdfs:comment "A contextual need for scaffolding in identified mathematical reasoning tasks, distinct from interaction accessibility."@en ;
                        rdfs:label "Necessidade de suporte ao raciocínio"@pt-br ,
                                   "Reasoning support need"@en ;
                        cc:conceptOrigin "experimental construct" ;
                        cc:historicalMappingType "adapted from" ;
                        cc:historicalSourceConcept "Logical_Weakness" ;
                        cc:historicalSourceOntology <http://www.semanticweb.org/ricma/ontologies/2024/11/LASDONT.owl> .


###  https://contacomigo.org/ontology#RecommendationHistoryEvidence
cc:RecommendationHistoryEvidence rdf:type owl:Class ;
                                 rdfs:subClassOf cc:InteractionEvidence ;
                                 rdfs:comment "An aggregate connecting recommendations to presentation and completion history without calculating a recommendation score."@en ;
                                 rdfs:label "Evidência do histórico de recomendações"@pt-br ,
                                            "Recommendation history evidence"@en ;
                                 cc:analyticsSourceEventType "RECOMMENDATION_COMPLETED" ,
                                                             "RECOMMENDATION_GENERATED" ,
                                                             "RECOMMENDATION_PRESENTED" ;
                                 cc:conceptOrigin "engineering concept" .


###  https://contacomigo.org/ontology#RectangleConcept
cc:RectangleConcept rdf:type owl:Class ;
                    rdfs:subClassOf cc:BasicGeometryConcept .


###  https://contacomigo.org/ontology#Representation
cc:Representation rdf:type owl:Class ;
                  rdfs:subClassOf cc:ActivityCharacteristic ;
                  rdfs:comment "A form in which activity content is presented, kept separate from learner preference."@en ;
                  rdfs:label "Representation"@en ,
                             "Representação"@pt-br ;
                  cc:conceptOrigin "engineering concept" .


###  https://contacomigo.org/ontology#ResponseTimingEvidence
cc:ResponseTimingEvidence rdf:type owl:Class ;
                          rdfs:subClassOf cc:InteractionEvidence ;
                          rdfs:comment "A contextual timing aggregate. Slow or fast response alone has no psychological, clinical, or mastery meaning."@en ;
                          rdfs:label "Evidência de tempo de resposta"@pt-br ,
                                     "Response timing evidence"@en ;
                          cc:analyticsSourceEventType "ANSWER_SUBMITTED" ;
                          cc:conceptOrigin "engineering concept" .


###  https://contacomigo.org/ontology#SensoryInteractionEvidence
cc:SensoryInteractionEvidence rdf:type owl:Class ;
                              rdfs:subClassOf cc:InteractionEvidence ;
                              dcterms:source <https://pubmed.ncbi.nlm.nih.gov/28266796/> ;
                              rdfs:comment "Software-interaction evidence concerning the sensory load of an activity; it is not a clinical sensory assessment."@en ;
                              rdfs:label "Evidência de interação sensorial"@pt-br ,
                                         "Sensory interaction evidence"@en ;
                              cc:conceptOrigin "literature-grounded ContaComigo concept" .


###  https://contacomigo.org/ontology#SensoryLoadTolerance
cc:SensoryLoadTolerance rdf:type owl:Class ;
                        rdfs:subClassOf cc:ObservedLearnerCharacteristic ;
                        rdfs:comment "Observed software-context compatibility with a specified sensory load; it is time-bounded and non-diagnostic."@en ;
                        rdfs:label "Sensory load tolerance"@en ,
                                   "Tolerância à carga sensorial"@pt-br ;
                        cc:conceptOrigin "experimental construct" ;
                        cc:historicalMappingType "adapted from" ;
                        cc:historicalSourceConcept "Sensory_Strength" ;
                        cc:historicalSourceOntology <http://www.semanticweb.org/ricma/ontologies/2024/11/LASDONT.owl> .


###  https://contacomigo.org/ontology#SensorySupportNeed
cc:SensorySupportNeed rdf:type owl:Class ;
                      rdfs:subClassOf cc:SupportNeed ;
                      dcterms:source <https://pubmed.ncbi.nlm.nih.gov/28266796/> ;
                      rdfs:comment "An observed contextual requirement to adjust software sensory load, without diagnosing sensory processing."@en ;
                      rdfs:label "Necessidade de suporte sensorial"@pt-br ,
                                 "Sensory support need"@en ;
                      cc:conceptOrigin "literature-grounded ContaComigo concept" ;
                      cc:historicalMappingType "adapted from" ;
                      cc:historicalSourceConcept "Sensory_Weakness" ;
                      cc:historicalSourceOntology <http://www.semanticweb.org/ricma/ontologies/2024/11/LASDONT.owl> .


###  https://contacomigo.org/ontology#SequencePatternConcept
cc:SequencePatternConcept rdf:type owl:Class ;
                          rdfs:subClassOf cc:MathematicalConcept .


###  https://contacomigo.org/ontology#SimilarityConcept
cc:SimilarityConcept rdf:type owl:Class ;
                     rdfs:subClassOf cc:BasicGeometryConcept .


###  https://contacomigo.org/ontology#SpatialFigureConcept
cc:SpatialFigureConcept rdf:type owl:Class ;
                        rdfs:subClassOf cc:BasicGeometryConcept .


###  https://contacomigo.org/ontology#SpatialLocationConcept
cc:SpatialLocationConcept rdf:type owl:Class ;
                          rdfs:subClassOf cc:BasicGeometryConcept .


###  https://contacomigo.org/ontology#SquareConcept
cc:SquareConcept rdf:type owl:Class ;
                 rdfs:subClassOf cc:BasicGeometryConcept .


###  https://contacomigo.org/ontology#SubtractionConcept
cc:SubtractionConcept rdf:type owl:Class ;
                      rdfs:subClassOf cc:MathematicalConcept .


###  https://contacomigo.org/ontology#SupportNeed
cc:SupportNeed rdf:type owl:Class ;
               rdfs:subClassOf cc:ObservedLearnerCharacteristic ;
               dcterms:source <https://udlguidelines.cast.org/> ;
               rdfs:comment "A contextual requirement for access or participation; it does not by itself assert inability or clinical impairment."@en ;
               rdfs:label "Necessidade de suporte"@pt-br ,
                          "Support need"@en ;
               cc:conceptOrigin "literature-grounded ContaComigo concept" .


###  https://contacomigo.org/ontology#SymmetryConcept
cc:SymmetryConcept rdf:type owl:Class ;
                   rdfs:subClassOf cc:BasicGeometryConcept .


###  https://contacomigo.org/ontology#TimeMeasurementConcept
cc:TimeMeasurementConcept rdf:type owl:Class ;
                          rdfs:subClassOf cc:MeasurementConcept .


###  https://contacomigo.org/ontology#VisualInteractionEvidence
cc:VisualInteractionEvidence rdf:type owl:Class ;
                             rdfs:subClassOf cc:InteractionEvidence ;
                             dcterms:source <https://udlguidelines.cast.org/> ;
                             rdfs:comment "Evidence concerning interaction or performance with visual or pictorial representation."@en ;
                             rdfs:label "Evidência de interação visual"@pt-br ,
                                        "Visual interaction evidence"@en ;
                             cc:conceptOrigin "literature-grounded ContaComigo concept" .


