#################################################################
#    Classes
#################################################################

###  http://www.w3.org/ns/prov#Activity
prov:Activity rdf:type owl:Class .


###  http://www.w3.org/ns/prov#Entity
prov:Entity rdf:type owl:Class .


###  https://contacomigo.org/ontology#Activity
cc:Activity rdf:type owl:Class ;
            rdfs:subClassOf cc:ActivityKnowledge ;
            owl:disjointWith cc:ActivityCharacteristic ;
            rdfs:comment "A LASDONT chamava as atividades de tratamentos; o ContaComigo trata atividade educacional como recurso pedagógico, e não como tratamento clínico (ver Batch 02)."@pt-br ,
                         "Semantic root for concrete learning activities and reusable activity-family profiles."@en ;
            rdfs:label "Activity"@en ,
                       "Atividade"@pt-br ;
            cc:conceptOrigin "engineering concept" ;
            cc:historicalMappingType "related to" ;
            cc:historicalSourceConcept "Treatments_Class" ;
            cc:historicalSourceOntology <http://www.semanticweb.org/ricma/ontologies/2024/11/LASDONT.owl> .

[ rdf:type owl:Axiom ;
   owl:annotatedSource cc:Activity ;
   owl:annotatedProperty owl:disjointWith ;
   owl:annotatedTarget cc:ActivityCharacteristic ;
   rdfs:comment "Uma atividade não é uma de suas características; as características descrevem atividades por meio de propriedades (BATCH_02, semântica de atividades)."@pt-br
 ] .


###  https://contacomigo.org/ontology#ActivityAffordance
cc:ActivityAffordance rdf:type owl:Class ;
                      rdfs:subClassOf cc:ActivityCharacteristic ;
                      rdfs:comment "An interaction or accessibility capability made available by an activity implementation."@en ;
                      rdfs:label "Activity affordance"@en ,
                                 "Recurso de interação da atividade"@pt-br ;
                      cc:conceptOrigin "engineering concept" .


###  https://contacomigo.org/ontology#ActivityCharacteristic
cc:ActivityCharacteristic rdf:type owl:Class ;
                          rdfs:subClassOf cc:ActivityKnowledge ;
                          rdfs:comment "A characteristic of an educational activity, kept outside the learner-characteristic hierarchy."@en ;
                          rdfs:label "Activity characteristic"@en ,
                                     "Característica da atividade"@pt-br ;
                          cc:conceptOrigin "engineering concept" .


###  https://contacomigo.org/ontology#ActivityFamilyProfile
cc:ActivityFamilyProfile rdf:type owl:Class ;
                         rdfs:subClassOf cc:Activity ;
                         rdfs:comment "A partial developer-authored summary of a current implementation family; concrete activities require their own materialized metadata."@en ;
                         rdfs:label "Activity family profile"@en ,
                                    "Perfil de família de atividades"@pt-br ;
                         cc:conceptOrigin "engineering concept" .


###  https://contacomigo.org/ontology#ActivityKnowledge
cc:ActivityKnowledge rdf:type owl:Class ;
                     rdfs:subClassOf cc:KnowledgeEntity ;
                     rdfs:label "Activity knowledge"@en ,
                                "Conhecimento sobre atividades"@pt-br ;
                     cc:conceptOrigin "engineering concept" .


###  https://contacomigo.org/ontology#ActivityLifecycleEvidence
cc:ActivityLifecycleEvidence rdf:type owl:Class ;
                             rdfs:subClassOf cc:InteractionEvidence ;
                             rdfs:comment "An aggregate over presentation, start, completion, and skip transitions."@en ;
                             rdfs:label "Activity lifecycle evidence"@en ,
                                        "Evidência do ciclo de vida da atividade"@pt-br ;
                             cc:analyticsSourceEventType "ACTIVITY_COMPLETED" ,
                                                         "ACTIVITY_PRESENTED" ,
                                                         "ACTIVITY_SKIPPED" ,
                                                         "ACTIVITY_STARTED" ;
                             cc:conceptOrigin "engineering concept" .


###  https://contacomigo.org/ontology#ActivityPerformanceEvidence
cc:ActivityPerformanceEvidence rdf:type owl:Class ;
                               rdfs:subClassOf cc:LearningEvidence ;
                               rdfs:comment "An aggregate of validated performance observations scoped by learner, activity, skill, and evidence window."@en ;
                               rdfs:label "Activity performance evidence"@en ,
                                          "Evidência de desempenho na atividade"@pt-br ;
                               cc:analyticsSourceEventType "ACTIVITY_COMPLETED" ,
                                                           "ANSWER_SUBMITTED" ;
                               cc:conceptOrigin "engineering concept" .


###  https://contacomigo.org/ontology#ActivitySkipHistoryEvidence
cc:ActivitySkipHistoryEvidence rdf:type owl:Class ;
                               rdfs:subClassOf cc:InteractionEvidence ;
                               rdfs:comment "A contextual history of skips. A skip is an interaction signal and is not intrinsically disengagement or rejection."@en ;
                               rdfs:label "Activity skip history evidence"@en ,
                                          "Evidência do histórico de pulos de atividade"@pt-br ;
                               cc:analyticsSourceEventType "ACTIVITY_SKIPPED" ;
                               cc:conceptOrigin "engineering concept" .


###  https://contacomigo.org/ontology#ActivityType
cc:ActivityType rdf:type owl:Class ;
                rdfs:subClassOf cc:ActivityCharacteristic ;
                rdfs:label "Activity type"@en ,
                           "Tipo de atividade"@pt-br ;
                cc:conceptOrigin "engineering concept" .


###  https://contacomigo.org/ontology#AdditionConcept
cc:AdditionConcept rdf:type owl:Class ;
                   rdfs:subClassOf cc:MathematicalConcept .


###  https://contacomigo.org/ontology#AngleConcept
cc:AngleConcept rdf:type owl:Class ;
                rdfs:subClassOf cc:BasicGeometryConcept .


###  https://contacomigo.org/ontology#AreaPerimeterConcept
cc:AreaPerimeterConcept rdf:type owl:Class ;
                        rdfs:subClassOf cc:MeasurementConcept .


###  https://contacomigo.org/ontology#AssistanceUsageEvidence
cc:AssistanceUsageEvidence rdf:type owl:Class ;
                           rdfs:subClassOf cc:InteractionEvidence ;
                           rdfs:comment "An aggregate of explicit assistance interactions; it is not direct evidence of inability or disengagement."@en ;
                           rdfs:label "Assistance usage evidence"@en ,
                                      "Evidência de uso de ajuda"@pt-br ;
                           cc:analyticsSourceEventType "HINT_REQUESTED" ,
                                                       "INSTRUCTION_REPLAYED" ,
                                                       "TUTORIAL_OPENED" ;
                           cc:conceptOrigin "engineering concept" .


###  https://contacomigo.org/ontology#AuditoryInteractionEvidence
cc:AuditoryInteractionEvidence rdf:type owl:Class ;
                               rdfs:subClassOf cc:InteractionEvidence ;
                               dcterms:source <https://udlguidelines.cast.org/> ;
                               rdfs:comment "Evidence concerning spoken or audio instruction and auditory presentation."@en ;
                               rdfs:label "Auditory interaction evidence"@en ,
                                          "Evidência de interação auditiva"@pt-br ;
                               cc:conceptOrigin "literature-grounded ContaComigo concept" .


###  https://contacomigo.org/ontology#BNCCAlgebraSkill
cc:BNCCAlgebraSkill rdf:type owl:Class ;
                    owl:equivalentClass [ owl:intersectionOf ( cc:BNCCSkill
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty cc:belongsToCurriculumDomain ;
                                                                 owl:hasValue cc:BNCCAlgebraDomain
                                                               ]
                                                             ) ;
                                          rdf:type owl:Class
                                        ] ;
                    dcterms:source <https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf> ;
                    rdfs:comment "Classe definida: toda habilidade BNCC classificada nos quadros oficiais na unidade temática indicada. A pertença é inferida pelo raciocinador a partir de cc:belongsToCurriculumDomain."@pt-br ;
                    rdfs:label "BNCC skill in the Algebra thematic unit"@en ,
                               "Habilidade BNCC da unidade temática Álgebra"@pt-br ;
                    cc:conceptOrigin "literature-grounded ContaComigo concept" .


###  https://contacomigo.org/ontology#BNCCGeometrySkill
cc:BNCCGeometrySkill rdf:type owl:Class ;
                     owl:equivalentClass [ owl:intersectionOf ( cc:BNCCSkill
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty cc:belongsToCurriculumDomain ;
                                                                  owl:hasValue cc:BNCCGeometryDomain
                                                                ]
                                                              ) ;
                                           rdf:type owl:Class
                                         ] ;
                     dcterms:source <https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf> ;
                     rdfs:comment "Classe definida: toda habilidade BNCC classificada nos quadros oficiais na unidade temática indicada. A pertença é inferida pelo raciocinador a partir de cc:belongsToCurriculumDomain."@pt-br ;
                     rdfs:label "BNCC skill in the Geometry thematic unit"@en ,
                                "Habilidade BNCC da unidade temática Geometria"@pt-br ;
                     cc:conceptOrigin "literature-grounded ContaComigo concept" .


###  https://contacomigo.org/ontology#BNCCMeasuresSkill
cc:BNCCMeasuresSkill rdf:type owl:Class ;
                     owl:equivalentClass [ owl:intersectionOf ( cc:BNCCSkill
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty cc:belongsToCurriculumDomain ;
                                                                  owl:hasValue cc:BNCCMeasuresDomain
                                                                ]
                                                              ) ;
                                           rdf:type owl:Class
                                         ] ;
                     dcterms:source <https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf> ;
                     rdfs:comment "Classe definida: toda habilidade BNCC classificada nos quadros oficiais na unidade temática indicada. A pertença é inferida pelo raciocinador a partir de cc:belongsToCurriculumDomain."@pt-br ;
                     rdfs:label "BNCC skill in the Quantities and Measures thematic unit"@en ,
                                "Habilidade BNCC da unidade temática Grandezas e medidas"@pt-br ;
                     cc:conceptOrigin "literature-grounded ContaComigo concept" .


###  https://contacomigo.org/ontology#BNCCNumbersSkill
cc:BNCCNumbersSkill rdf:type owl:Class ;
                    owl:equivalentClass [ owl:intersectionOf ( cc:BNCCSkill
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty cc:belongsToCurriculumDomain ;
                                                                 owl:hasValue cc:BNCCNumbersDomain
                                                               ]
                                                             ) ;
                                          rdf:type owl:Class
                                        ] ;
                    dcterms:source <https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf> ;
                    rdfs:comment "Classe definida: toda habilidade BNCC classificada nos quadros oficiais na unidade temática indicada. A pertença é inferida pelo raciocinador a partir de cc:belongsToCurriculumDomain."@pt-br ;
                    rdfs:label "BNCC skill in the Numbers thematic unit"@en ,
                               "Habilidade BNCC da unidade temática Números"@pt-br ;
                    cc:conceptOrigin "literature-grounded ContaComigo concept" .


###  https://contacomigo.org/ontology#BNCCSkill
cc:BNCCSkill rdf:type owl:Class ;
             rdfs:subClassOf cc:CurriculumSkill ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty cc:addressesMathematicalConcept ;
                               owl:someValuesFrom cc:MathematicalConcept
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty cc:belongsToCurriculumDomain ;
                               owl:someValuesFrom cc:CurriculumDomain
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty cc:belongsToGrade ;
                               owl:someValuesFrom cc:CurriculumLevel
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty cc:belongsToCurriculum ;
                               owl:hasValue cc:BrazilianNationalCommonCoreCurriculum
                             ] ;
             rdfs:comment "A curriculum skill whose code and official description are sourced from the Brazilian National Common Core Curriculum."@en ;
             rdfs:label "BNCC skill"@en ,
                        "Habilidade BNCC"@pt-br ;
             cc:conceptOrigin "aligned ontology concept" ;
             cc:sourceOntology <https://basenacionalcomum.mec.gov.br/> .


###  https://contacomigo.org/ontology#BNCCStatisticsSkill
cc:BNCCStatisticsSkill rdf:type owl:Class ;
                       owl:equivalentClass [ owl:intersectionOf ( cc:BNCCSkill
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty cc:belongsToCurriculumDomain ;
                                                                    owl:hasValue cc:BNCCStatisticsDomain
                                                                  ]
                                                                ) ;
                                             rdf:type owl:Class
                                           ] ;
                       dcterms:source <https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf> ;
                       rdfs:comment "Classe definida: toda habilidade BNCC classificada nos quadros oficiais na unidade temática indicada. A pertença é inferida pelo raciocinador a partir de cc:belongsToCurriculumDomain."@pt-br ;
                       rdfs:label "BNCC skill in the Probability and Statistics thematic unit"@en ,
                                  "Habilidade BNCC da unidade temática Probabilidade e estatística"@pt-br ;
                       cc:conceptOrigin "literature-grounded ContaComigo concept" .


