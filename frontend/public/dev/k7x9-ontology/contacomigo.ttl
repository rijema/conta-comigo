#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/creator
dcterms:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
dcterms:license rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/source
dcterms:source rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#changeNote
skos:changeNote rdf:type owl:AnnotationProperty .


###  https://contacomigo.org/ontology#alignmentNote
cc:alignmentNote rdf:type owl:AnnotationProperty ;
                 rdfs:label "alignment note"@en ,
                            "nota de alinhamento"@pt-br .


###  https://contacomigo.org/ontology#alignmentRelation
cc:alignmentRelation rdf:type owl:AnnotationProperty ;
                     rdfs:label "alignment relation"@en ,
                                "relação de alinhamento"@pt-br .


###  https://contacomigo.org/ontology#analyticsSourceEventType
cc:analyticsSourceEventType rdf:type owl:AnnotationProperty ;
                            rdfs:comment "LearningEvent type that may contribute to an aggregate; it never asserts a learner characteristic from one event."@en ;
                            rdfs:label "analytics source event type"@en ,
                                       "tipo de evento de origem (Learning Analytics)"@pt-br .


###  https://contacomigo.org/ontology#conceptOrigin
cc:conceptOrigin rdf:type owl:AnnotationProperty ;
                 rdfs:comment "Project classification: reused ontology concept, aligned ontology concept, literature-grounded ContaComigo concept, engineering concept, experimental construct, or historical LASDONT concept."@en ;
                 rdfs:label "concept origin"@en ,
                            "origem do conceito"@pt-br .


###  https://contacomigo.org/ontology#historicalMappingType
cc:historicalMappingType rdf:type owl:AnnotationProperty ;
                         rdfs:comment "Allowed values: historical predecessor, adapted from, narrower than, broader than, related to, deprecated historical concept, and no longer used."@en ;
                         rdfs:label "historical mapping type"@en ,
                                    "tipo de mapeamento histórico"@pt-br .


###  https://contacomigo.org/ontology#historicalSourceConcept
cc:historicalSourceConcept rdf:type owl:AnnotationProperty ;
                           rdfs:label "conceito histórico de origem"@pt-br ,
                                      "historical source concept"@en .


###  https://contacomigo.org/ontology#historicalSourceOntology
cc:historicalSourceOntology rdf:type owl:AnnotationProperty ;
                            rdfs:label "historical source ontology"@en ,
                                       "ontologia histórica de origem"@pt-br .


###  https://contacomigo.org/ontology#mappingOrigin
cc:mappingOrigin rdf:type owl:AnnotationProperty ;
                 rdfs:comment "Provenance category for a curriculum-to-mathematics mapping."@en ;
                 rdfs:label "mapping origin"@en ,
                            "origem do mapeamento"@pt-br .


###  https://contacomigo.org/ontology#relationReviewStatus
cc:relationReviewStatus rdf:type owl:AnnotationProperty ;
                        rdfs:comment "Provenance of a didactic relation: grounded_in_bncc_text, or reviewed_by_professional when the BNCC text supports it only partially and a professional confirmed it."@en ;
                        rdfs:label "relation review status"@en ,
                                   "situação de revisão da relação"@pt-br .


###  https://contacomigo.org/ontology#sourceIRI
cc:sourceIRI rdf:type owl:AnnotationProperty ;
             rdfs:label "IRI de origem"@pt-br ,
                        "source IRI"@en .


###  https://contacomigo.org/ontology#sourceOntology
cc:sourceOntology rdf:type owl:AnnotationProperty ;
                  rdfs:label "ontologia de origem"@pt-br ,
                             "source ontology"@en .


#################################################################
#    Object Properties
#################################################################

###  http://www.w3.org/ns/prov#wasDerivedFrom
prov:wasDerivedFrom rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/prov#wasGeneratedBy
prov:wasGeneratedBy rdf:type owl:ObjectProperty .


###  https://contacomigo.org/ontology#addressesBNCCSkill
cc:addressesBNCCSkill rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf cc:addressesCurriculumSkill ;
                      rdfs:domain cc:Activity ;
                      rdfs:range cc:BNCCSkill ;
                      rdfs:label "aborda habilidade BNCC"@pt-br ,
                                 "addresses BNCC skill"@en .


###  https://contacomigo.org/ontology#addressesCurriculumSkill
cc:addressesCurriculumSkill rdf:type owl:ObjectProperty ;
                            owl:inverseOf cc:isAddressedByActivity ;
                            rdfs:domain cc:Activity ;
                            rdfs:range cc:CurriculumSkill ;
                            rdfs:label "aborda habilidade curricular"@pt-br ,
                                       "addresses curriculum skill"@en .


###  https://contacomigo.org/ontology#addressesMathematicalConcept
cc:addressesMathematicalConcept rdf:type owl:ObjectProperty ;
                                rdfs:domain cc:CurriculumSkill ;
                                rdfs:range cc:MathematicalConcept ;
                                rdfs:label "aborda conceito matemático"@pt-br ,
                                           "addresses mathematical concept"@en .


###  https://contacomigo.org/ontology#belongsToCurriculum
cc:belongsToCurriculum rdf:type owl:ObjectProperty ,
                                owl:FunctionalProperty ;
                       rdfs:domain cc:CurriculumSkill ;
                       rdfs:range cc:Curriculum ;
                       rdfs:comment "Cada habilidade pertence a um único documento curricular."@pt-br ;
                       rdfs:label "belongs to curriculum"@en ,
                                  "pertence ao currículo"@pt-br .


###  https://contacomigo.org/ontology#belongsToCurriculumDomain
cc:belongsToCurriculumDomain rdf:type owl:ObjectProperty ,
                                      owl:FunctionalProperty ;
                             rdfs:domain cc:CurriculumSkill ;
                             rdfs:range cc:CurriculumDomain ;
                             rdfs:comment "Cada habilidade aparece em uma única unidade temática nos quadros da BNCC."@pt-br ;
                             rdfs:label "belongs to curriculum domain"@en ,
                                        "pertence à unidade temática"@pt-br .


###  https://contacomigo.org/ontology#belongsToGrade
cc:belongsToGrade rdf:type owl:ObjectProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain cc:CurriculumSkill ;
                  rdfs:range cc:CurriculumLevel ;
                  rdfs:comment "Cada habilidade da BNCC pertence a um único ano; o próprio código (EF01MA… a EF05MA…) identifica o ano."@pt-br ;
                  rdfs:label "belongs to grade"@en ,
                             "pertence ao ano escolar"@pt-br .


###  https://contacomigo.org/ontology#concernsActivity
cc:concernsActivity rdf:type owl:ObjectProperty ;
                    rdfs:domain cc:LearningAnalyticsEvidence ;
                    rdfs:range cc:LearningActivity ;
                    rdfs:label "concerns activity"@en ,
                               "refere-se à atividade"@pt-br .


###  https://contacomigo.org/ontology#concernsActivityType
cc:concernsActivityType rdf:type owl:ObjectProperty ;
                        rdfs:domain cc:LearningAnalyticsEvidence ;
                        rdfs:range cc:ActivityType ;
                        rdfs:label "concerns activity type"@en ,
                                   "refere-se ao tipo de atividade"@pt-br .


###  https://contacomigo.org/ontology#concernsLearner
cc:concernsLearner rdf:type owl:ObjectProperty ;
                   rdfs:domain cc:LearningAnalyticsEvidence ;
                   rdfs:range cc:Learner ;
                   rdfs:label "concerns learner"@en ,
                              "refere-se ao aprendiz"@pt-br .


###  https://contacomigo.org/ontology#concernsModality
cc:concernsModality rdf:type owl:ObjectProperty ;
                    rdfs:domain cc:LearningAnalyticsEvidence ;
                    rdfs:range cc:Modality ;
                    rdfs:label "concerns modality"@en ,
                               "refere-se à modalidade"@pt-br .


###  https://contacomigo.org/ontology#concernsSkill
cc:concernsSkill rdf:type owl:ObjectProperty ;
                 rdfs:domain cc:LearningAnalyticsEvidence ;
                 rdfs:range cc:CurriculumSkill ;
                 rdfs:label "concerns skill"@en ,
                            "refere-se à habilidade"@pt-br .


###  https://contacomigo.org/ontology#contradictsCharacteristic
cc:contradictsCharacteristic rdf:type owl:ObjectProperty ;
                             rdfs:domain cc:LearningAnalyticsEvidence ;
                             rdfs:range cc:ObservedLearnerCharacteristic ;
                             rdfs:label "contradicts characteristic"@en ,
                                        "contradiz característica"@pt-br .


###  https://contacomigo.org/ontology#dependentConcept
cc:dependentConcept rdf:type owl:ObjectProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain cc:PrerequisiteRelation ;
                    rdfs:range cc:MathematicalConcept ;
                    rdfs:comment "Cada relação de pré-requisito reificada liga exatamente um conceito dependente."@pt-br ;
                    rdfs:label "conceito dependente"@pt-br ,
                               "dependent concept"@en .


###  https://contacomigo.org/ontology#derivedFromEvidence
cc:derivedFromEvidence rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf prov:wasDerivedFrom ;
                       rdfs:domain cc:ObservedLearnerCharacteristic ;
                       rdfs:range cc:LearningAnalyticsEvidence ;
                       rdfs:label "derivado de evidência"@pt-br ,
                                  "derived from evidence"@en ;
                       cc:alignmentRelation "narrower" ;
                       cc:sourceIRI prov:wasDerivedFrom ;
                       cc:sourceOntology prov: .


###  https://contacomigo.org/ontology#developsMathematicalConcept
cc:developsMathematicalConcept rdf:type owl:ObjectProperty ;
                               rdfs:domain cc:Activity ;
                               rdfs:range cc:MathematicalConcept ;
                               rdfs:label "desenvolve conceito matemático"@pt-br ,
                                          "develops mathematical concept"@en .


###  https://contacomigo.org/ontology#hasActivityAffordance
cc:hasActivityAffordance rdf:type owl:ObjectProperty ;
                         rdfs:domain cc:Activity ;
                         rdfs:range cc:ActivityAffordance ;
                         rdfs:label "has activity affordance"@en ,
                                    "tem recurso de interação"@pt-br .


###  https://contacomigo.org/ontology#hasActivityType
cc:hasActivityType rdf:type owl:ObjectProperty ;
                   rdfs:domain cc:Activity ;
                   rdfs:range cc:ActivityType ;
                   rdfs:label "has activity type"@en ,
                              "tem tipo de atividade"@pt-br .


###  https://contacomigo.org/ontology#hasDidacticRelation
cc:hasDidacticRelation rdf:type owl:ObjectProperty ;
                       rdfs:domain cc:MathematicalConcept ;
                       rdfs:range cc:DidacticRelation ;
                       rdfs:label "has didactic relation"@en ,
                                  "tem relação didática"@pt-br .


###  https://contacomigo.org/ontology#hasDifficultyProfile
cc:hasDifficultyProfile rdf:type owl:ObjectProperty ;
                        rdfs:domain cc:Activity ;
                        rdfs:range cc:DifficultyProfile ;
                        rdfs:label "has difficulty profile"@en ,
                                   "tem perfil de dificuldade"@pt-br .


###  https://contacomigo.org/ontology#hasEvidenceAssessment
cc:hasEvidenceAssessment rdf:type owl:ObjectProperty ;
                         rdfs:domain cc:LearnerCharacteristic ;
                         rdfs:range cc:EvidenceSufficiencyAssessment ;
                         rdfs:label "has evidence assessment"@en ,
                                    "tem avaliação de evidência"@pt-br .


###  https://contacomigo.org/ontology#hasEvidenceWindow
cc:hasEvidenceWindow rdf:type owl:ObjectProperty ;
                     rdfs:domain cc:ObservedLearnerCharacteristic ;
                     rdfs:range cc:EvidenceWindow ;
                     rdfs:label "has evidence window"@en ,
                                "tem janela de evidência"@pt-br .


###  https://contacomigo.org/ontology#hasInteractionEvidence
cc:hasInteractionEvidence rdf:type owl:ObjectProperty ;
                          rdfs:domain cc:Learner ;
                          rdfs:range cc:InteractionEvidence ;
                          rdfs:label "has interaction evidence"@en ,
                                     "tem evidência de interação"@pt-br .


###  https://contacomigo.org/ontology#hasInteractionType
cc:hasInteractionType rdf:type owl:ObjectProperty ;
                      rdfs:domain cc:Activity ;
                      rdfs:range cc:InteractionType ;
                      rdfs:label "has interaction type"@en ,
                                 "tem tipo de interação"@pt-br .


###  https://contacomigo.org/ontology#hasObservedCharacteristic
cc:hasObservedCharacteristic rdf:type owl:ObjectProperty ;
                             rdfs:domain cc:Learner ;
                             rdfs:range cc:ObservedLearnerCharacteristic ;
                             rdfs:label "has observed characteristic"@en ,
                                        "tem característica observada"@pt-br .


###  https://contacomigo.org/ontology#hasRepresentation
cc:hasRepresentation rdf:type owl:ObjectProperty ;
                     rdfs:domain cc:Activity ;
                     rdfs:range cc:Representation ;
                     rdfs:label "has representation"@en ,
                                "tem representação"@pt-br .


###  https://contacomigo.org/ontology#isAddressedByActivity
cc:isAddressedByActivity rdf:type owl:ObjectProperty ;
                         rdfs:domain cc:CurriculumSkill ;
                         rdfs:range cc:Activity ;
                         rdfs:label "is addressed by activity"@en ,
                                    "é abordada por atividade"@pt-br .


###  https://contacomigo.org/ontology#isPrerequisiteOf
cc:isPrerequisiteOf rdf:type owl:ObjectProperty ,
                             owl:TransitiveProperty ;
                    rdfs:domain cc:MathematicalConcept ;
                    rdfs:range cc:MathematicalConcept ;
                    owl:propertyChainAxiom ( [ owl:inverseOf cc:prerequisiteConcept
                                             ]
                                             cc:dependentConcept
                                           ) ;
                    dcterms:source <https://doi.org/10.1007/978-3-642-58625-5> ;
                    rdfs:comment "Visão direta das relações de pré-requisito reificadas: se uma PrerequisiteRelation liga o conceito A (prerequisiteConcept) ao conceito B (dependentConcept), então A é pré-requisito de B. A relação é transitiva, como a relação de precedência entre itens de conhecimento na teoria dos espaços de conhecimento (Doignon e Falmagne, 1999)."@pt-br ;
                    rdfs:label "is prerequisite of"@en ,
                               "é pré-requisito de"@pt-br .


###  https://contacomigo.org/ontology#observedDuring
cc:observedDuring rdf:type owl:ObjectProperty ;
                  rdfs:range cc:EvidenceWindow ;
                  rdfs:label "observado durante"@pt-br ,
                             "observed during"@en .


###  https://contacomigo.org/ontology#prerequisiteConcept
cc:prerequisiteConcept rdf:type owl:ObjectProperty ,
                                owl:FunctionalProperty ;
                       rdfs:domain cc:PrerequisiteRelation ;
                       rdfs:range cc:MathematicalConcept ;
                       rdfs:comment "Cada relação de pré-requisito reificada liga exatamente um conceito anterior."@pt-br ;
                       rdfs:label "conceito pré-requisito"@pt-br ,
                                  "prerequisite concept"@en ;
                       cc:alignmentRelation "adapted" ;
                       cc:sourceIRI <http://ontomathpro.org/ontomathedu#hasPrerequisite> ;
                       cc:sourceOntology <http://ontomathpro.org/ontomathedu#> .


###  https://contacomigo.org/ontology#providesEvidenceFor
cc:providesEvidenceFor rdf:type owl:ObjectProperty ;
                       rdfs:domain cc:LearningAnalyticsEvidence ;
                       rdfs:range cc:MathematicalConcept ;
                       rdfs:label "fornece evidência para"@pt-br ,
                                  "provides evidence for"@en .


###  https://contacomigo.org/ontology#requiresPrerequisite
cc:requiresPrerequisite rdf:type owl:ObjectProperty ;
                        rdfs:domain cc:LearningActivity ;
                        rdfs:range cc:MathematicalConcept ;
                        rdfs:label "requer pré-requisito"@pt-br ,
                                   "requires prerequisite"@en .


###  https://contacomigo.org/ontology#supportsCharacteristic
cc:supportsCharacteristic rdf:type owl:ObjectProperty ;
                          rdfs:domain cc:LearningAnalyticsEvidence ;
                          rdfs:range cc:ObservedLearnerCharacteristic ;
                          rdfs:label "supports characteristic"@en ,
                                     "sustenta característica"@pt-br .


###  https://contacomigo.org/ontology#wasGeneratedBySession
cc:wasGeneratedBySession rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf prov:wasGeneratedBy ;
                         rdfs:domain cc:InteractionEvidence ;
                         rdfs:range cc:LearningSession ;
                         rdfs:label "foi gerado pela sessão de aprendizagem"@pt-br ,
                                    "was generated by learning session"@en ;
                         cc:alignmentRelation "narrower" ;
                         cc:sourceIRI prov:wasGeneratedBy ;
                         cc:sourceOntology prov: .


#################################################################
#    Data properties
#################################################################

###  https://contacomigo.org/ontology#abstractionLevel
cc:abstractionLevel rdf:type owl:DatatypeProperty ;
                    rdfs:domain cc:DifficultyProfile ;
                    rdfs:range xsd:string ;
                    rdfs:label "abstraction level"@en ,
                               "nível de abstração"@pt-br .


###  https://contacomigo.org/ontology#activityMappingStatus
cc:activityMappingStatus rdf:type owl:DatatypeProperty ;
                         rdfs:domain cc:ActivityFamilyProfile ;
                         rdfs:range xsd:string ;
                         rdfs:comment "Allowed family-profile values: PARTIAL, NEEDS_REVIEW, and INCOMPLETE."@en ;
                         rdfs:label "activity mapping status"@en ,
                                    "situação do mapeamento da atividade"@pt-br .


###  https://contacomigo.org/ontology#annotationProvenance
cc:annotationProvenance rdf:type owl:DatatypeProperty ;
                        rdfs:domain cc:ActivityCharacteristic ;
                        rdfs:range xsd:string ;
                        rdfs:label "annotation provenance"@en ,
                                   "proveniência da anotação"@pt-br .


###  https://contacomigo.org/ontology#conceptMappingStatus
cc:conceptMappingStatus rdf:type owl:DatatypeProperty ;
                        rdfs:domain cc:CurriculumSkill ;
                        rdfs:range xsd:string ;
                        rdfs:comment "Allowed values in this version: mapped, partial, and pending_review."@en ;
                        rdfs:label "concept mapping status"@en ,
                                   "situação do mapeamento de conceitos"@pt-br .


###  https://contacomigo.org/ontology#conceptualComplexity
cc:conceptualComplexity rdf:type owl:DatatypeProperty ;
                        rdfs:domain cc:DifficultyProfile ;
                        rdfs:range xsd:string ;
                        rdfs:label "complexidade conceitual"@pt-br ,
                                   "conceptual complexity"@en .


###  https://contacomigo.org/ontology#currentActivityCount
cc:currentActivityCount rdf:type owl:DatatypeProperty ;
                        rdfs:domain cc:CurriculumSkill ;
                        rdfs:range xsd:nonNegativeInteger ;
                        rdfs:comment "Number of seed activities currently claiming the skill code; this is coverage metadata, not evidence of pedagogical alignment."@en ;
                        rdfs:label "current activity count"@en ,
                                   "quantidade atual de atividades"@pt-br .


###  https://contacomigo.org/ontology#currentActivityCoverageStatus
cc:currentActivityCoverageStatus rdf:type owl:DatatypeProperty ;
                                 rdfs:domain cc:CurriculumSkill ;
                                 rdfs:range xsd:string ;
                                 rdfs:comment "Snapshot classification: COVERED, PARTIALLY_COVERED, NOT_COVERED, or NEEDS_REVIEW."@en ;
                                 rdfs:label "current activity coverage status"@en ,
                                            "situação atual de cobertura por atividades"@pt-br .


###  https://contacomigo.org/ontology#distractorSimilarity
cc:distractorSimilarity rdf:type owl:DatatypeProperty ;
                        rdfs:domain cc:DifficultyProfile ;
                        rdfs:range xsd:string ;
                        rdfs:label "distractor similarity"@en ,
                                   "semelhança dos distratores"@pt-br .


###  https://contacomigo.org/ontology#evidenceConfidence
cc:evidenceConfidence rdf:type owl:DatatypeProperty ;
                      rdfs:domain cc:LearnerKnowledge ;
                      rdfs:range xsd:decimal ;
                      rdfs:comment "A configurable reasoning-layer confidence value; OWL defines no cutoff or classification threshold."@en ;
                      rdfs:label "confiança da evidência"@pt-br ,
                                 "evidence confidence"@en .


###  https://contacomigo.org/ontology#evidenceReason
cc:evidenceReason rdf:type owl:DatatypeProperty ;
                  rdfs:domain cc:EvidenceSufficiencyAssessment ;
                  rdfs:range xsd:string ;
                  rdfs:comment "A human-readable explanation such as sparse, stale, untested, absent, or conflicting evidence."@en ;
                  rdfs:label "evidence reason"@en ,
                             "motivo da evidência"@pt-br .


###  https://contacomigo.org/ontology#hasCurriculumCode
cc:hasCurriculumCode rdf:type owl:DatatypeProperty ,
                              owl:FunctionalProperty ;
                     rdfs:domain cc:CurriculumSkill ;
                     rdfs:range xsd:string ;
                     rdfs:comment "Cada habilidade tem um único código alfanumérico na BNCC."@pt-br ;
                     rdfs:label "has curriculum code"@en ,
                                "tem código curricular"@pt-br .


###  https://contacomigo.org/ontology#hasKnowledgeObject
cc:hasKnowledgeObject rdf:type owl:DatatypeProperty ;
                      rdfs:domain cc:CurriculumSkill ;
                      rdfs:range rdf:langString ;
                      dcterms:source <https://basenacionalcomum.mec.gov.br/images/BNCC_EI_EF_110518_versaofinal_site.pdf> ;
                      rdfs:comment "Objeto de conhecimento da BNCC, copiado da linha do quadro oficial de Matemática em que a habilidade aparece. Quando a linha lista mais de um objeto, cada um é um valor; dentro da linha a BNCC não associa objetos a habilidades individualmente."@pt-br ;
                      rdfs:label "has knowledge object"@en ,
                                 "tem objeto de conhecimento"@pt-br .


###  https://contacomigo.org/ontology#hasOfficialDescription
cc:hasOfficialDescription rdf:type owl:DatatypeProperty ;
                          rdfs:domain cc:CurriculumSkill ;
                          rdfs:range rdf:langString ;
                          rdfs:label "has official description"@en ,
                                     "tem descrição oficial"@pt-br .


###  https://contacomigo.org/ontology#languageLoad
cc:languageLoad rdf:type owl:DatatypeProperty ;
                rdfs:domain cc:DifficultyProfile ;
                rdfs:range xsd:string ;
                rdfs:label "carga de linguagem"@pt-br ,
                           "language load"@en .


###  https://contacomigo.org/ontology#legacyDifficultyLabel
cc:legacyDifficultyLabel rdf:type owl:DatatypeProperty ;
                         rdfs:domain cc:LearningActivity ;
                         rdfs:range xsd:string ;
                         rdfs:comment "Compatibility value from the current easy, medium, or hard enum; it does not determine the multidimensional profile."@en ;
                         rdfs:label "legacy difficulty label"@en ,
                                    "rótulo legado de dificuldade"@pt-br ;
                         cc:historicalMappingType "related to" ;
                         cc:historicalSourceConcept "Easy_Content" ,
                                                    "Hard_Content" ,
                                                    "Mid_Content" ;
                         cc:historicalSourceOntology <http://www.semanticweb.org/ricma/ontologies/2024/11/LASDONT.owl> .


###  https://contacomigo.org/ontology#motorDemand
cc:motorDemand rdf:type owl:DatatypeProperty ;
               rdfs:domain cc:DifficultyProfile ;
               rdfs:range xsd:string ;
               rdfs:label "demanda motora"@pt-br ,
                          "motor demand"@en .


###  https://contacomigo.org/ontology#numericalMagnitude
cc:numericalMagnitude rdf:type owl:DatatypeProperty ;
                      rdfs:domain cc:DifficultyProfile ;
                      rdfs:range xsd:nonNegativeInteger ;
                      rdfs:label "magnitude numérica"@pt-br ,
                                 "numerical magnitude"@en .


###  https://contacomigo.org/ontology#observationCount
cc:observationCount rdf:type owl:DatatypeProperty ;
                    rdfs:domain cc:EvidenceWindow ;
                    rdfs:range xsd:nonNegativeInteger ;
                    rdfs:label "observation count"@en ,
                               "quantidade de observações"@pt-br .


###  https://contacomigo.org/ontology#observedAt
cc:observedAt rdf:type owl:DatatypeProperty ;
              rdfs:domain cc:LearningAnalyticsEvidence ;
              rdfs:range xsd:dateTime ;
              rdfs:label "observado em"@pt-br ,
                         "observed at"@en .


###  https://contacomigo.org/ontology#requiresDragging
cc:requiresDragging rdf:type owl:DatatypeProperty ;
                    rdfs:domain cc:Activity ;
                    rdfs:range xsd:boolean ;
                    rdfs:label "exige arrastar"@pt-br ,
                               "requires dragging"@en .


###  https://contacomigo.org/ontology#requiresReading
cc:requiresReading rdf:type owl:DatatypeProperty ;
                   rdfs:domain cc:Activity ;
                   rdfs:range xsd:boolean ;
                   rdfs:label "exige leitura"@pt-br ,
                              "requires reading"@en .


###  https://contacomigo.org/ontology#scaffoldingLevel
cc:scaffoldingLevel rdf:type owl:DatatypeProperty ;
                    rdfs:domain cc:DifficultyProfile ;
                    rdfs:range xsd:string ;
                    rdfs:label "nível de andaimento"@pt-br ,
                               "scaffolding level"@en .


