###  https://contacomigo.org/ontology#usesAudio
cc:usesAudio rdf:type owl:DatatypeProperty ;
             rdfs:domain cc:Activity ;
             rdfs:range xsd:boolean ;
             rdfs:label "usa áudio"@pt-br ,
                        "uses audio"@en .


###  https://contacomigo.org/ontology#usesPictograms
cc:usesPictograms rdf:type owl:DatatypeProperty ;
                  rdfs:domain cc:Activity ;
                  rdfs:range xsd:boolean ;
                  rdfs:comment "For an activity-family profile, true means the inspected implementation currently supports or uses pictograms; concrete activity materialization must provide its own value."@en ;
                  rdfs:label "usa pictogramas"@pt-br ,
                             "uses pictograms"@en .


###  https://contacomigo.org/ontology#validFrom
cc:validFrom rdf:type owl:DatatypeProperty ;
             rdfs:domain cc:LearnerKnowledge ;
             rdfs:range xsd:dateTime ;
