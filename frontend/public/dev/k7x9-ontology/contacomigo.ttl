   owl:annotatedProperty cc:addressesMathematicalConcept ;
   owl:annotatedTarget cc:DataInterpretationConcept ;
   cc:mappingOrigin "ContaComigo semantic analysis"
 ] .


###  https://contacomigo.org/ontology#BNCC_EF05MA25
cc:BNCC_EF05MA25 rdf:type owl:NamedIndividual ,
                          cc:BNCCSkill ;
                 cc:addressesMathematicalConcept cc:DataInterpretationConcept ;
