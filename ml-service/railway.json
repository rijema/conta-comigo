{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "/ml-service/Dockerfile",
    "watchPatterns": ["/ml-service/**"]
  },
  "deploy": { "startCommand": "uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000}", "healthcheckPath": "/health", "healthcheckTimeout": 180, "restartPolicyType": "ON_FAILURE", "restartPolicyMaxRetries": 5 }
}
