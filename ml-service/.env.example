BACKEND_URL=http://api.railway.internal:3001
MODEL_PATH=/app/models/engagement_model.joblib
BKT_LEARNING_RATE=0.20
BKT_GUESS_RATE=0.25
BKT_SLIP_RATE=0.10
BKT_PRIOR_KNOWLEDGE=0.10
BKT_MASTERY_THRESHOLD=0.80
BKT_MEDIUM_DIFFICULTY_THRESHOLD=0.50
BKT_HARD_DIFFICULTY_THRESHOLD=0.80
BKT_USE_LEGACY_SKILL_PARAMS=false
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
VOICE_MAX_AUDIO_BYTES=2000000
# The Docker image provisions this pinned CC BY 4.0 voice and its model card.
PIPER_MODEL_PATH=/app/models/dii_pt-BR.onnx
PIPER_CONFIG_PATH=/app/models/dii_pt-BR.onnx.json
