NODE_ENV=production
DATABASE_URL=postgresql://user:password@host:5432/database
REDIS_URL=redis://default:password@host:6379
ML_SERVICE_URL=http://ml-service.railway.internal:8000
ENABLE_VOICE_COMMANDS=false
ENABLE_NEURAL_TTS=false
VOICE_PROCESSING_TIMEOUT_MS=30000
JWT_SECRET=replace-with-a-long-random-value
JWT_REFRESH_SECRET=replace-with-a-different-long-random-value
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
ALLOWED_ORIGINS=https://your-frontend-domain.example
GEMINI_API_KEY=
BKT_PRIOR_KNOWLEDGE=0.10
KNOWLEDGE_TRACING_TIMEOUT_MS=5000
ADE_MASTERY_HIGH_THRESHOLD=0.80
ADE_MASTERY_MEDIUM_THRESHOLD=0.50
ADE_MASTERY_LOW_THRESHOLD=0.30
ADE_ACCURACY_HIGH_THRESHOLD=0.75
ADE_ACCURACY_MEDIUM_THRESHOLD=0.60
ADE_ACCURACY_LOW_THRESHOLD=0.40
ADE_ENGAGEMENT_LOW_THRESHOLD=0.35
ADE_BREAK_TIME_SECONDS_THRESHOLD=120
ADE_BREAK_HINTS_THRESHOLD=3
ADE_STREAK_THRESHOLD=5
ADE_STRONG_SUPPORT_MASTERY_THRESHOLD=0.50
ADE_DIFFICULTY_HISTORY_WINDOW=5
ADE_PROMOTION_MIN_SUCCESSES=3
ADE_DIFFICULTY_MIN_STRUGGLES=2
ADE_DIFFICULTY_MIN_SKIPS=2
ADE_SLOW_RESPONSE_SECONDS=120
ADE_EXPLORE_MASTERY_THRESHOLD=0.80
ADE_STRATEGY_RECENT_WINDOW=5
ADE_REINFORCE_MIN_ERRORS=2
ADE_REINFORCE_MIN_SKIPS=2
ADE_EXPLORE_MIN_INDEPENDENT_SUCCESSES=3
ONTOLOGY_PREREQUISITE_MASTERY_THRESHOLD=0.50
CONTACOMIGO_ONTOLOGY_PATH=../ontology/contacomigo/contacomigo.owl
HYBRID_TARGET_SUCCESS_PROBABILITY=0.70
HYBRID_CHALLENGE_SIGMA=0.15
HYBRID_NOVELTY_WINDOW=5
HYBRID_REJECTION_DECAY=3
HYBRID_MAX_NUMERICAL_MAGNITUDE=20
HYBRID_MAX_STEP_COUNT=5
HYBRID_WEIGHT_LEARNING=1
HYBRID_WEIGHT_CHALLENGE=1
HYBRID_WEIGHT_INTERACTION=1
HYBRID_WEIGHT_SEMANTIC=1
HYBRID_WEIGHT_NOVELTY=0.5
HYBRID_WEIGHT_REJECTION=1
HYBRID_WEIGHT_SENSORY=0.5
HYBRID_WEIGHT_FORMAT=0.3
HYBRID_WEIGHT_REPETITION=0.7
HYBRID_WEIGHT_FRUSTRATION=0.5
HYBRID_DIFFICULTY_LEVEL_WEIGHT=0.5
HYBRID_FRUSTRATION_HISTORY_WINDOW=3
HYBRID_SAME_FORMAT_REPETITION_RISK=0.3
HYBRID_SAME_REPRESENTATION_RISK=0.4
HYBRID_CONFIGURATION_VERSION=experimental-v1
