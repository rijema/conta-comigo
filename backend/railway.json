{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "/backend/Dockerfile",
    "watchPatterns": ["/backend/**", "/ontology/contacomigo/**"]
  },
  "deploy": { "startCommand": "npm start", "healthcheckPath": "/api/health", "healthcheckTimeout": 180, "restartPolicyType": "ON_FAILURE", "restartPolicyMaxRetries": 5 }
}
